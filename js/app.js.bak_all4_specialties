// Lưu thông tin nhân viên (Thêm mới hoặc Cập nhật)
function saveEmployeeModal(event) {
  event.preventDefault();

  const id = document.getElementById('emp-id').value.trim();
  const msnv = document.getElementById('emp-msnv').value.trim();
  const fullName = document.getElementById('emp-fullname').value.trim();
  let userName = document.getElementById('emp-username').value.trim();
  let email = document.getElementById('emp-email').value.trim();
  const phone = document.getElementById('emp-phone').value.trim();
  const gender = document.getElementById('emp-gender').value;
  const dob = document.getElementById('emp-dob').value.trim();
  const department = document.getElementById('emp-department').value;
  const role = document.getElementById('emp-role').value;
  const level = parseInt(document.getElementById('emp-level').value, 10) || 1;
  const specialty = document.getElementById('emp-specialty').value || 'lamsang';
  const degree = document.getElementById('emp-degree').value.trim();
  const password = document.getElementById('emp-password').value.trim() || '123';
  const managerId = document.getElementById('emp-manager').value;

  if (!fullName) {
    showToast('Vui lòng nhập Họ và Tên nhân viên!', 'error');
    return;
  }

  // Tự sinh username nếu chưa có
  if (!userName) {
    const nameParts = fullName.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').split(' ').filter(Boolean);
    if (nameParts.length > 0) {
      const last = nameParts[nameParts.length - 1];
      const initials = nameParts.slice(0, -1).map(p => p[0]).join('');
      userName = last + (initials ? '.' + initials : '');
    } else {
      userName = 'nv.' + Date.now().toString().slice(-4);
    }
  }

  if (!email) {
    email = `${userName}@umc.edu.vn`;
  }

  // Lấy tên người duyệt
  const managerUser = (APP_STATE.users || []).find(u => u.id === managerId);
  const managerName = managerUser ? managerUser.fullName : '';

  // Lấy tên cấp bậc & vai trò
  const tierObj = (typeof COMPETENCY_TIERS_MATRIX !== 'undefined') 
    ? (COMPETENCY_TIERS_MATRIX.find(t => t.tier === level) || COMPETENCY_TIERS_MATRIX[0])
    : { code: `Bậc ${level}`, name: 'Điều dưỡng', title: '' };

  const roleNameMap = {
    nurse: 'Điều dưỡng (Nhân viên)',
    head_nurse: 'Điều dưỡng trưởng (Duyệt Cấp 1)',
    deputy_head_nurse: 'Điều dưỡng phó (Duyệt Cấp 1)',
    chief_nurse: 'Trưởng ban điều dưỡng (Duyệt Cấp 2)',
    admin: 'Quản trị viên hệ thống'
  };
  const roleName = roleNameMap[role] || 'Điều dưỡng (Nhân viên)';

  if (APP_STATE.editingUserId) {
    // Cập nhật nhân viên hiện có
    const userIndex = (APP_STATE.users || []).findIndex(u => u.id === APP_STATE.editingUserId);
    if (userIndex !== -1) {
      const u = APP_STATE.users[userIndex];
      u.msnv = msnv;
      u.fullName = fullName;
      u.userName = userName;
      u.email = email;
      u.phone = phone;
      u.gender = gender;
      u.dob = dob;
      u.department = department;
      u.role = role;
      u.roleName = roleName;
      u.level = level;
      u.levelName = `${tierObj.code} - ${tierObj.name}`;
      u.specialty = specialty;
      u.degree = degree;
      u.password = password;
      u.managerId = managerId;
      u.managerName = managerName;

      // Cập nhật thông tin trong submission nếu có
      if (APP_STATE.submissions && APP_STATE.submissions[u.id]) {
        APP_STATE.submissions[u.id].department = department;
        APP_STATE.submissions[u.id].specialty = specialty;
        APP_STATE.submissions[u.id].userName = fullName;
        APP_STATE.submissions[u.id].msnv = msnv;
      }

      saveStorage();
      showToast(`Đã cập nhật thông tin nhân viên ${fullName}`, 'success');
    }
  } else {
    // Thêm nhân viên mới (Onboarding)
    const newUserId = 'usr_' + userName.replace(/[^a-zA-Z0-9_]/g, '_') + '_' + Date.now().toString().slice(-4);
    const newUser = {
      id: newUserId,
      userName: userName,
      msnv: msnv,
      password: password,
      fullName: fullName,
      email: email,
      phone: phone,
      gender: gender,
      dob: dob,
      role: role,
      roleName: roleName,
      department: department,
      specialty: specialty,
      level: level,
      levelName: `${tierObj.code} - ${tierObj.name}`,
      degree: degree,
      academicTitle: degree.includes('Cử nhân') ? 'Cử nhân' : degree.includes('Thạc sĩ') ? 'Thạc sĩ' : 'Cao đẳng',
      graduationYear: new Date().getFullYear(),
      experienceYears: 0,
      managerId: managerId,
      managerName: managerName,
      approvalLevel: role === 'head_nurse' ? 1 : role === 'chief_nurse' ? 2 : 0,
      avatar: gender === 'Nam' 
        ? 'https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=150' 
        : 'https://images.unsplash.com/photo-1594824813627-2c13702a4bf7?w=150',
      status: 'active'
    };

    APP_STATE.users.push(newUser);

    // Tự động khởi tạo phiếu tự đánh giá ban đầu cho nhân viên mới
    if (!APP_STATE.submissions) APP_STATE.submissions = {};
    APP_STATE.submissions[newUserId] = {
      userId: newUserId,
      userName: fullName,
      msnv: msnv,
      department: department,
      specialty: specialty,
      status: 'draft',
      statusLabel: 'Bản Nháp (Chưa nộp)',
      totalScore: 0,
      evaluatedTier: level,
      targetTier: Math.min(7, level + 1),
      scores: {},
      optionKeys: {},
      domainScores: { lamsang_d1: 0, lamsang_d2: 0, lamsang_d3: 0, lamsang_d4: 0, lamsang_d5: 0 },
      history: [
        {
          step: 'Khởi tạo tài khoản nhân sự mới',
          actor: APP_STATE.currentUser ? APP_STATE.currentUser.fullName : 'Admin Quản Trị',
          date: new Date().toLocaleString('vi-VN'),
          comment: 'Nhân viên mới gia nhập khoa. Cấp phát tài khoản và khởi tạo phiếu tự đánh giá năng lực ban đầu.',
          action: 'create'
        }
      ],
      evidences: {},
      managerScores: {},
      managerComments: ''
    };

    saveStorage();
    showToast(`🎉 Đã thêm mới nhân viên ${fullName} và khởi tạo hồ sơ tự đánh giá!`, 'success');
  }

  closeAdminEmployeeModal();
  renderAdminTab();
}

