// Helper xác định thông tin giai đoạn quy trình phê duyệt (đặc biệt cho Ban Điều Dưỡng duyệt 2 cấp)
function getSubmissionStageInfo(sub) {
  const isBanDD = (sub && sub.department === 'Ban điều dưỡng');
  const baseStage = (typeof WORKFLOW_STAGES !== 'undefined' && WORKFLOW_STAGES[sub?.status]) 
    ? WORKFLOW_STAGES[sub.status] 
    : { label: sub?.status || 'N/A', color: 'slate', badgeClass: 'bg-slate-100 text-slate-700 border-slate-300', icon: '📝', step: 1 };
  if (!isBanDD) return baseStage;

  if (sub.status === 'submitted_l1') {
    return {
      ...baseStage,
      label: 'Chờ Trưởng Ban ĐD Duyệt (Cấp 1)',
      badgeClass: 'bg-amber-50 text-amber-800 border-amber-300',
      color: 'amber',
      icon: '⏳',
      desc: 'Hồ sơ đã nộp, đang chờ Trưởng Ban Điều Dưỡng thẩm định và phê duyệt Cấp 1.'
    };
  }
  if (sub.status === 'submitted_l3') {
    return {
      ...baseStage,
      label: 'Chờ Ban Lãnh Đạo Phê Duyệt (Cấp 2)',
      badgeClass: 'bg-purple-50 text-purple-800 border-purple-300',
      color: 'purple',
      icon: '🎖️',
      desc: 'Hồ sơ đã qua Trưởng Ban ĐD, đang trình Ban Lãnh Đạo / Ban Lãnh Đạo phê duyệt Cấp 2.'
    };
  }
  return baseStage;
}

