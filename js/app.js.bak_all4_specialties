// Bật / Tắt tiêu chí
function toggleCriterionStatus(critId) {
  if (typeof checkAdminPermission === 'function' && !checkAdminPermission()) return;
  const domains = DOMAINS_BY_SPECIALTY['lamsang'] || [];
  let found = null;

  for (const d of domains) {
    for (const s of (d.standards || [])) {
      const c = (s.criteria || []).find(x => x.id === critId);
      if (c) {
        found = c;
        break;
      }
    }
    if (found) break;
  }

  if (!found) return;

  const willBeActive = found.active === false;
  found.active = willBeActive;

  // Lưu vào LocalStorage
  saveCriteriaStorage();

  renderAdminCriteria();
  renderAdminKpiStrip();
  showToast(
    willBeActive 
      ? `Đã kích hoạt tiêu chí [${critId} - ${found.title}]` 
      : `Đã tạm dừng áp dụng tiêu chí [${critId} - ${found.title}] cho nhân sự mới`, 
    'info'
  );
}

// Mở modal thêm tiêu chí mới
function openAddCriterionModal() {
  if (typeof checkAdminPermission === 'function' && !checkAdminPermission()) return;
  APP_STATE.editingCriterionId = null;
  const modal = document.getElementById('modal-admin-criterion');
  if (!modal) return;

  document.getElementById('modal-criterion-title').textContent = 'Thêm Tiêu Chí Đánh Giá Mới Cho Chuyên Khoa';

  // Điền danh sách lĩnh vực và tiêu chuẩn vào dropdown
  populateDomainStandardDropdowns();

  // Gợi ý mã tiêu chí mới
  const domains = DOMAINS_BY_SPECIALTY['lamsang'] || [];
  let highestNum = 66;
  domains.forEach(d => {
    (d.standards || []).forEach(s => {
      (s.criteria || []).forEach(c => {
        if (c.num && c.num > highestNum) highestNum = c.num;
      });
    });
  });
  const nextNum = highestNum + 1;

  document.getElementById('crit-id').value = `lamsang_c${nextNum}`;
  document.getElementById('crit-num').value = nextNum;
  document.getElementById('crit-title').value = '';
  document.getElementById('crit-desc').value = 'Chọn 1 mức độ phù hợp với năng lực thực tế';
  document.getElementById('crit-max-score').value = '10';
  document.getElementById('crit-evidence-hint').value = 'Bản scan minh chứng, bảng kiểm hoặc xác nhận của ĐD Trưởng Khoa';

  // 5 Mức điểm mặc định
  document.getElementById('crit-opt-score-1').value = '2';
  document.getElementById('crit-opt-desc-1').value = 'Mức 1: Có hiểu biết cơ bản, cần hướng dẫn trực tiếp khi thực hiện';

  document.getElementById('crit-opt-score-2').value = '4';
  document.getElementById('crit-opt-desc-2').value = 'Mức 2: Thực hiện độc lập được quy trình cơ bản an toàn';

  document.getElementById('crit-opt-score-3').value = '6';
  document.getElementById('crit-opt-desc-3').value = 'Mức 3: Thành thạo, xử lý tốt các tình huống thông thường';

  document.getElementById('crit-opt-score-4').value = '8';
  document.getElementById('crit-opt-desc-4').value = 'Mức 4: Vững vàng, hỗ trợ và hướng dẫn được đồng nghiệp mới';

  document.getElementById('crit-opt-score-5').value = '10';
  document.getElementById('crit-opt-desc-5').value = 'Mức 5: Chuyên gia / Đạt chuẩn xuất sắc, tham gia cải tiến quy trình';

  modal.classList.remove('hidden');
}

// Mở modal sửa tiêu chí
function openEditCriterionModal(critId) {
  if (typeof checkAdminPermission === 'function' && !checkAdminPermission()) return;
  const domains = DOMAINS_BY_SPECIALTY['lamsang'] || [];
  let found = null;
  let parentDomainId = '';
  let parentStandardId = '';

  for (const d of domains) {
    for (const s of (d.standards || [])) {
      const c = (s.criteria || []).find(x => x.id === critId);
      if (c) {
        found = c;
        parentDomainId = d.id;
        parentStandardId = s.id;
        break;
      }
    }
    if (found) break;
  }

  if (!found) return;

  APP_STATE.editingCriterionId = critId;
  const modal = document.getElementById('modal-admin-criterion');
  if (!modal) return;

  document.getElementById('modal-criterion-title').textContent = `Chỉnh Sửa Tiêu Chí: ${found.id} - ${found.title}`;

  populateDomainStandardDropdowns(parentDomainId, parentStandardId);

  document.getElementById('crit-id').value = found.id;
  document.getElementById('crit-num').value = found.num || 0;
  document.getElementById('crit-title').value = found.title || '';
  document.getElementById('crit-desc').value = found.desc || '';
  document.getElementById('crit-max-score').value = found.maxScore || 10;
  document.getElementById('crit-evidence-hint').value = found.evidenceHint || '';

  const opts = found.options || [];
  for (let i = 1; i <= 5; i++) {
    const opt = opts[i - 1];
    const scoreEl = document.getElementById(`crit-opt-score-${i}`);
    const descEl = document.getElementById(`crit-opt-desc-${i}`);
    if (scoreEl) scoreEl.value = opt ? opt.score : (i * 2);
    if (descEl) descEl.value = opt ? opt.text : `Mức ${i}`;
  }

  modal.classList.remove('hidden');
}

function closeAdminCriterionModal() {
  const modal = document.getElementById('modal-admin-criterion');
  if (modal) modal.classList.add('hidden');
}

// Điền danh sách lĩnh vực và tiêu chuẩn vào dropdown
function populateDomainStandardDropdowns(selectedDomainId = '', selectedStandardId = '') {
  const domainSelect = document.getElementById('crit-domain-select');
  const stdSelect = document.getElementById('crit-standard-select');
  if (!domainSelect || !stdSelect) return;

  const domains = DOMAINS_BY_SPECIALTY['lamsang'] || [];

  domainSelect.innerHTML = domains.map(d => `
    <option value="${d.id}" ${d.id === selectedDomainId ? 'selected' : ''}>
      ${d.code} ${d.name} (${d.maxPoints}đ)
    </option>
  `).join('');

  const activeDomId = selectedDomainId || (domains[0] ? domains[0].id : '');
  updateStandardDropdownOptions(activeDomId, selectedStandardId);

  domainSelect.onchange = (e) => {
    updateStandardDropdownOptions(e.target.value);
  };
}

function updateStandardDropdownOptions(domainId, selectedStandardId = '') {
  const stdSelect = document.getElementById('crit-standard-select');
  if (!stdSelect) return;

  const domains = DOMAINS_BY_SPECIALTY['lamsang'] || [];
  const domain = domains.find(d => d.id === domainId) || domains[0];
  if (!domain) return;

  stdSelect.innerHTML = (domain.standards || []).map(s => `
    <option value="${s.id}" ${s.id === selectedStandardId ? 'selected' : ''}>
      ${(s.title || '').replace(/\n/g, ' - ')}
    </option>
  `).join('');
}

// Lưu tiêu chí (Thêm mới hoặc Cập nhật)
function saveCriterionModal(event) {
  event.preventDefault();

  const domainId = document.getElementById('crit-domain-select').value;
  const standardId = document.getElementById('crit-standard-select').value;
  const critId = document.getElementById('crit-id').value.trim();
  const num = parseInt(document.getElementById('crit-num').value, 10) || 0;
  const title = document.getElementById('crit-title').value.trim();
  const desc = document.getElementById('crit-desc').value.trim();
  const maxScore = parseInt(document.getElementById('crit-max-score').value, 10) || 10;
  const evidenceHint = document.getElementById('crit-evidence-hint').value.trim();

  if (!critId || !title) {
    showToast('Vui lòng nhập đầy đủ Mã tiêu chí và Tên tiêu chí!', 'error');
    return;
  }

  // Thu thập 5 options
  const options = [];
  for (let i = 1; i <= 5; i++) {
    const s = parseInt(document.getElementById(`crit-opt-score-${i}`).value, 10) || (i * 2);
    const t = document.getElementById(`crit-opt-desc-${i}`).value.trim() || `Mức ${i} (${s} điểm)`;
    options.push({
      score: s,
      level: `Mức ${i}`,
      text: t
    });
  }

  const domains = DOMAINS_BY_SPECIALTY['lamsang'] || [];

  if (APP_STATE.editingCriterionId) {
    // Sửa tiêu chí
    let updated = false;
    for (const d of domains) {
      for (const s of (d.standards || [])) {
        const c = (s.criteria || []).find(x => x.id === APP_STATE.editingCriterionId);
        if (c) {
          c.title = title;
          c.desc = desc;
          c.maxScore = maxScore;
          c.options = options;
          c.evidenceHint = evidenceHint;
          updated = true;
          break;
        }
      }
      if (updated) break;
    }
    showToast(`Đã cập nhật thành công tiêu chí [${critId}]`, 'success');
  } else {
    // Thêm mới tiêu chí
    const targetDomain = domains.find(d => d.id === domainId);
    if (!targetDomain) return;
    const targetStd = (targetDomain.standards || []).find(s => s.id === standardId);
    if (!targetStd) return;

    const newCrit = {
      id: critId,
      num: num,
      standard: targetStd.title,
      title: title,
      desc: desc,
      maxScore: maxScore,
      options: options,
      evidenceHint: evidenceHint,
      active: true,
      isCustom: true
    };

    targetStd.criteria.push(newCrit);
    showToast(`🎉 Đã thêm mới tiêu chí [${critId} - ${title}] vào Khung Năng Lực!`, 'success');
  }

  saveCriteriaStorage();
  closeAdminCriterionModal();
  renderAdminCriteria();
  renderAdminKpiStrip();
  
  // Đồng bộ lại tab Đánh giá nếu đang mở
  if (typeof renderAssessmentTab === 'function') {
    renderAssessmentTab();
  }
}

// Xóa tiêu chí tự tạo
function confirmDeleteCriterion(critId) {
  if (typeof checkAdminPermission === 'function' && !checkAdminPermission()) return;
  openConfirmModal({
    title: 'Xóa Tiêu Chí Khung Năng Lực',
    icon: '🗑️',
