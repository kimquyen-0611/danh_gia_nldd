function openReviewModal(subId) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  if (!sub) return;
  
  const nameEl = document.getElementById('review-modal-name'); if (nameEl) nameEl.textContent = sub.fullName;
  const deptEl = document.getElementById('review-modal-dept'); if (deptEl) deptEl.textContent = `${sub.msnv} • ${sub.department}`;
  
  const evContainer = document.getElementById('review-modal-evidences');
  if (evContainer) {
    let evHtml = '';
    const allEvs = sub.criterionEvidences || {};
    let totalFiles = 0;
    
    Object.keys(allEvs).forEach(critId => {
      const files = allEvs[critId] || [];
      files.forEach(f => {
        totalFiles++;
        evHtml += `
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-200 text-xs">
            <div class="flex items-center gap-2">
              <span>📄</span>
              <span class="font-bold text-slate-700">${f.name}</span>
              <span class="text-slate-400 text-[11px]">(${f.size})</span>
            </div>
            <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 text-[11px] font-semibold">${critId}</span>
          </div>
        `;
      });
    });
    
    evContainer.innerHTML = totalFiles > 0 ? evHtml : `<div class="text-xs text-slate-400 italic">Chưa có tệp minh chứng đính kèm.</div>`;
  }
  
  const histContainer = document.getElementById('review-modal-history');
  if (histContainer) {
    let histHtml = '';
    (sub.history || []).forEach(h => {
      histHtml += `
        <div class="border-l-2 border-blue-500 pl-3 py-1 text-xs">
          <div class="flex items-center gap-2 font-bold text-slate-800">
            <span>${h.step}</span>
            <span class="text-slate-400 text-[11px] font-normal">• ${h.date}</span>
          </div>
          <p class="text-slate-600 mt-0.5"><strong class="text-blue-700">${h.actor}:</strong> ${h.comment || ''}</p>
        </div>
      `;
    });
    histContainer.innerHTML = histHtml;
  }
  
  const modal = document.getElementById('modal-review-submission');
  if (modal) modal.classList.remove('hidden');
}

function closeReviewModal() {
  const modal = document.getElementById('modal-review-submission');
  if (modal) modal.classList.add('hidden');
}

