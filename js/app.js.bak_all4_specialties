// Mở modal thêm minh chứng mới
function openAddEvidenceModal() {
  const currentUser = APP_STATE.currentUser;
  if (!currentUser) return;
  
  // Reset form inputs
  const titleInp = document.getElementById('evidence-input-title');
  if (titleInp) titleInp.value = '';
  const codeInp = document.getElementById('evidence-input-code');
  if (codeInp) codeInp.value = `MC-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;
  const dateInp = document.getElementById('evidence-input-date');
  if (dateInp) dateInp.value = new Date().toISOString().split('T')[0];
  const issuerInp = document.getElementById('evidence-input-issuer');
  if (issuerInp) issuerInp.value = 'Bệnh viện Đại học Y Dược TP.HCM';
  const fileLbl = document.getElementById('evidence-file-label');
  if (fileLbl) fileLbl.textContent = 'Nhấp để chọn tệp tài liệu số từ máy tính';
  
  const modal = document.getElementById('modal-add-evidence');
  if (modal) modal.classList.remove('hidden');
}

// Đóng modal thêm minh chứng
function closeAddEvidenceModal() {
  const modal = document.getElementById('modal-add-evidence');
  if (modal) modal.classList.add('hidden');
}

// Xử lý chọn tệp đính kèm
function handleEvidenceFileSelect(input) {
  if (input && input.files && input.files[0]) {
    const file = input.files[0];
    const lbl = document.getElementById('evidence-file-label');
    if (lbl) {
      lbl.innerHTML = `📄 <strong class="text-blue-700">${file.name}</strong> (${Math.round(file.size / 1024)} KB)`;
    }
  }
}

// Lưu minh chứng mới vào hồ sơ cá nhân
function saveNewEvidence(event) {
  if (event) event.preventDefault();
  const currentUser = APP_STATE.currentUser;
  if (!currentUser) return;

  const title = (document.getElementById('evidence-input-title')?.value || '').trim();
  const type = document.getElementById('evidence-input-type')?.value || 'Chứng chỉ CME';
  const code = (document.getElementById('evidence-input-code')?.value || '').trim() || `MC-${Date.now().toString().slice(-4)}`;
  const date = document.getElementById('evidence-input-date')?.value || new Date().toISOString().split('T')[0];
  const issuer = (document.getElementById('evidence-input-issuer')?.value || '').trim() || 'BV ĐHYD TP.HCM';

  if (!title) {
    showToast('Vui lòng nhập tên tài liệu minh chứng!', 'error');
    return;
  }

  let icon = '📎';
  if (type.includes('CME')) icon = '🩺';
  else if (type.includes('Văn bằng')) icon = '🎓';
  else if (type.includes('NCKH')) icon = '📚';
  else if (type.includes('Khen thưởng')) icon = '⭐';
  else if (type.includes('Preceptor') || type.includes('năng lực')) icon = '👥';
  else if (type.includes('Bảng kiểm')) icon = '📋';

  const newItem = {
    id: 'port_item_' + Date.now(),
    title: title,
    type: type,
    code: code,
    date: date ? date.split('-').reverse().join('/') : new Date().toLocaleDateString('vi-VN'),
    issuer: issuer,
    status: 'Đã tải lên & xác thực',
    icon: icon,
    size: '1.8 MB',
    fileName: `${code.toLowerCase().replace(/[^a-z0-9]/g, '_')}_verified.pdf`,
    isCustom: true,
    uploadedAt: new Date().toLocaleString('vi-VN'),
    uploadedBy: currentUser.id
  };

  if (!APP_STATE.userPortfolios) {
    try {
      APP_STATE.userPortfolios = JSON.parse(localStorage.getItem('umc_user_portfolios') || '{}');
    } catch(e) {
      APP_STATE.userPortfolios = {};
    }
  }
  if (!APP_STATE.userPortfolios[currentUser.id]) {
    APP_STATE.userPortfolios[currentUser.id] = [];
  }

  APP_STATE.userPortfolios[currentUser.id].unshift(newItem);
  try {
    localStorage.setItem('umc_user_portfolios', JSON.stringify(APP_STATE.userPortfolios));
  } catch(e) {
    console.error('Save portfolio error:', e);
  }

  closeAddEvidenceModal();
  renderPortfolioTab(currentUser.id);
  if (typeof confetti === 'function') confetti({ particleCount: 50, spread: 50 });
  showToast(`🎉 Đã bổ sung thành công minh chứng "${title}" vào portfolio cá nhân!`, 'success');
}

// Xóa minh chứng tự tải lên khỏi portfolio
function deletePortfolioItem(itemId) {
  const currentUser = APP_STATE.currentUser;
  if (!currentUser) return;

  openConfirmModal({
    title: 'Xóa Minh Chứng Khỏi Portfolio',
    icon: '🗑️',
    message: 'Bạn có chắc chắn muốn xóa minh chứng này khỏi hồ sơ năng lực cá nhân?',
    btnText: 'Xác Nhận Xóa',
    btnClass: 'bg-rose-600 hover:bg-rose-700',
    onConfirm: () => {
      if (APP_STATE.userPortfolios && APP_STATE.userPortfolios[currentUser.id]) {
        APP_STATE.userPortfolios[currentUser.id] = APP_STATE.userPortfolios[currentUser.id].filter(it => it.id !== itemId);
        try {
          localStorage.setItem('umc_user_portfolios', JSON.stringify(APP_STATE.userPortfolios));
        } catch(e) {}
      }
      renderPortfolioTab(currentUser.id);
      showToast('Đã gỡ bỏ minh chứng khỏi hồ sơ cá nhân.', 'info');
    }
  });
}

// Xem chi tiết tài liệu trong modal preview
function viewPortfolioItemDetail(itemJsonStr) {
  let item = null;
  try {
    item = typeof itemJsonStr === 'string' ? JSON.parse(decodeURIComponent(itemJsonStr)) : itemJsonStr;
  } catch(e) {
    item = { title: 'Tài liệu minh chứng', code: 'MC-01', size: '1.2 MB' };
  }

  const modal = document.getElementById('modal-preview-evidence');
  if (modal) {
    const docName = document.getElementById('preview-modal-docname');
    if (docName) docName.textContent = item.title || 'Tài liệu minh chứng';

    const fileName = document.getElementById('preview-modal-filename');
    if (fileName) fileName.textContent = item.fileName || `${(item.code || 'evidence').toLowerCase()}.pdf`;

    const frameTitle = document.getElementById('preview-modal-frametitle');
    if (frameTitle) frameTitle.textContent = (item.title || 'HỒ SƠ MINH CHỨNG SỐ UMC').toUpperCase();

    modal.classList.remove('hidden');
  } else {
    showToast(`Đang mở xem chi tiết: ${item.title}`, 'info');
  }
}

// Render Tab Portfolio với phân quyền rõ ràng: Bản thân & Đồng nghiệp cùng khoa
function _rbacRenderPortfolioTab(targetUserId = null) {
  const currentUser = APP_STATE.currentUser;
  if (!currentUser) return;

  const canViewHospital = ['director', 'admin', 'nurse_board'].includes(currentUser.role);
  const canViewDepartment = ['nurse', 'head_nurse', 'deputy_head_nurse'].includes(currentUser.role);

  // Xác định người dùng đang xem hồ sơ
  let viewUser = currentUser;
  const requestedId = targetUserId || APP_STATE.portfolioSelectedUserId;

  if (canViewHospital) {
    if (requestedId) {
      const f = (APP_STATE.users || []).find(u => u.id === requestedId);
      if (f) viewUser = f;
    }
  } else if (canViewDepartment) {
    if (requestedId) {
      // Chỉ cho phép xem nếu là chính mình hoặc đồng nghiệp thuộc cùng khoa
      const f = (APP_STATE.users || []).find(u => u.id === requestedId && (u.department === currentUser.department || u.id === currentUser.id));
      if (f) {
        viewUser = f;
      } else {
        viewUser = currentUser;
      }
    }
  }

  APP_STATE.portfolioSelectedUserId = viewUser.id;
  const isOwner = (viewUser.id === currentUser.id);

  // 1. Cấu hình Dropdown chọn nhân sự theo phân quyền
  const selectorContainer = document.getElementById('portfolio-employee-selector-container');
  const employeeSelect = document.getElementById('portfolio-employee-select');
  const selectorLabel = document.getElementById('portfolio-selector-label');

  if (selectorContainer && employeeSelect) {
    selectorContainer.classList.remove('hidden');

    if (canViewHospital) {
      if (selectorLabel) selectorLabel.textContent = 'Xem Hồ Sơ Minh Chứng Toàn Bệnh Viện:';
      const users = APP_STATE.users || [];
      employeeSelect.innerHTML = users.map(u => `
        <option value="${u.id}" ${u.id === viewUser.id ? 'selected' : ''}>
          ${u.fullName} (${u.msnv} · ${u.department} · ${u.roleName || u.role})
        </option>
      `).join('');
    } else {
      // Điều dưỡng viên và ĐD Trưởng: Xem bản thân & nhân viên cùng khoa
      if (selectorLabel) selectorLabel.textContent = `Danh Sách Nhân Sự Khoa ${currentUser.department} (Cá nhân & Đồng nghiệp):`;
      const deptUsers = (APP_STATE.users || []).filter(u => u.department === currentUser.department);
      employeeSelect.innerHTML = deptUsers.map(u => `
        <option value="${u.id}" ${u.id === viewUser.id ? 'selected' : ''}>
          ${u.id === currentUser.id ? '⭐ ' + u.fullName + ' (Hồ sơ của tôi)' : u.fullName + ' (' + u.msnv + ' · ' + (u.roleName || u.role) + ')'}
        </option>
      `).join('');
    }
  }

  // 2. Quyền Cập Nhật Portfolio (Chỉ chủ sở hữu mới có nút Thêm / Sửa hồ sơ)
  const btnAddEvidence = document.getElementById('btn-portfolio-add-evidence');
  const btnEditProfile = document.getElementById('btn-portfolio-edit-profile');
  const ownershipBadge = document.getElementById('portfolio-ownership-badge');

  if (btnAddEvidence) {
    btnAddEvidence.style.display = isOwner ? 'inline-flex' : 'none';
  }
  if (btnEditProfile) {
    btnEditProfile.style.display = isOwner ? 'inline-flex' : 'none';
  }
  if (ownershipBadge) {
    if (isOwner) {
      ownershipBadge.className = 'px-3.5 py-2 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-bold flex items-center gap-2';
      ownershipBadge.innerHTML = '<span>👑</span> Hồ Sơ Cá Nhân (Được phép cập nhật & thêm minh chứng)';
    } else {
      ownershipBadge.className = 'px-3.5 py-2 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-400/30 text-xs font-bold flex items-center gap-2';
      ownershipBadge.innerHTML = `<span>👁️</span> Đang xem hồ sơ đồng nghiệp cùng khoa: <strong>${viewUser.fullName}</strong> (Chế độ chỉ đọc)`;
    }
  }

  // 3. Cập nhật thông tin tiêu đề thẻ hồ sơ
  const nameEl = document.getElementById('portfolio-owner-name');
  if (nameEl) nameEl.textContent = viewUser.fullName;

  const msnvEl = document.getElementById('portfolio-owner-msnv');
  if (msnvEl) msnvEl.textContent = `MSNV: ${viewUser.msnv} • Khoa: ${viewUser.department} • Cấp bậc: ${viewUser.levelName || `Bậc ${viewUser.level}`}`;

  const deptBadgeEl = document.getElementById('portfolio-owner-dept-badge');
  if (deptBadgeEl) deptBadgeEl.textContent = `Khoa: ${viewUser.department} · Chức vụ: ${viewUser.roleName || viewUser.role} · Bệnh viện Đại học Y Dược TP.HCM`;

  const listContainer = document.getElementById('portfolio-items-list');
  if (!listContainer) return;

  // 4. Lấy danh sách tài liệu minh chứng:
  // a) Minh chứng do nhân viên tự tải lên (lưu trữ trong localStorage)
  if (!APP_STATE.userPortfolios) {
    try {
      APP_STATE.userPortfolios = JSON.parse(localStorage.getItem('umc_user_portfolios') || '{}');
    } catch(e) {
      APP_STATE.userPortfolios = {};
    }
  }
  const customItems = APP_STATE.userPortfolios[viewUser.id] || [];

  // b) Minh chứng đính kèm từ phiếu tự đánh giá
  const sub = getUserSubmission(viewUser.id);
  const userEvidences = (sub && sub.criterionEvidences) ? sub.criterionEvidences : (APP_STATE.currentCriterionEvidences || {});

  let assessmentEvidenceItems = [];
  Object.keys(userEvidences).forEach(critId => {
    const files = userEvidences[critId];
    if (Array.isArray(files)) {
      files.forEach((f, fIdx) => {
        assessmentEvidenceItems.push({
          id: `crit_ev_${critId}_${fIdx}`,
          title: f.name || `Tệp minh chứng tiêu chí ${critId}`,
          type: `Minh chứng tiêu chí ${critId.toUpperCase()}`,
          code: `MC-${critId}-${fIdx + 1}`,
          date: f.uploadedAt || new Date().toLocaleDateString('vi-VN'),
          status: 'Đã đính kèm trong phiếu',
          icon: '📎',
          size: f.size ? `${Math.round(f.size / 1024)} KB` : '1.2 MB',
          fileName: f.name || `minh_chung_${critId}.pdf`
        });
      });
    }
  });

  // c) Văn bằng chứng chỉ chuẩn hóa của nhân viên
  const defaultItems = [
    { id: 'def_1', title: viewUser.degree || 'Bằng Tốt Nghiệp Cử Nhân Điều Dưỡng - ĐH Y Dược TPHCM', type: 'Văn bằng chính quy', code: 'VB-001', date: '15/06/2020', status: 'Đã xác thực', icon: '🎓', size: '2.4 MB', fileName: 'bang_tot_nghiep_cndd.pdf' },
    { id: 'def_2', title: 'Chứng Chỉ Đào Tạo Liên Tục (CME): Hồi Sức Cấp Cứu Nâng Cao', type: 'Chứng chỉ CME', code: 'CME-2025-08', date: '10/11/2025', status: 'Đã xác thực', icon: '🩺', size: '1.8 MB', fileName: 'chung_chi_cme_2025.pdf' },
    { id: 'def_3', title: 'Chứng Nhận Đào Tạo Tiền Bối (Preceptor) Hướng Dẫn Lâm Sàng', type: 'Chứng nhận năng lực', code: 'PREC-2024', date: '20/08/2024', status: 'Đã xác thực', icon: '👥', size: '1.2 MB', fileName: 'chung_nhan_preceptor.pdf' },
    { id: 'def_4', title: viewUser.nckh && viewUser.nckh !== 'Không' ? viewUser.nckh : 'Đề Tài NCKH Cấp Cơ Sở: Cải Tiến Quy Trình Chăm Sóc Người Bệnh', type: 'Đề tài NCKH', code: 'NCKH-2025-03', date: '12/12/2025', status: 'Đã nghiệm thu', icon: '📚', size: '5.6 MB', fileName: 'de_tai_nckh_co_so.pdf' },
    { id: 'def_5', title: 'Giấy Khen Điển Hình Tiên Tiến - Hoàn Thành Xuất Sắc Nhiệm Vụ', type: 'Khen thưởng', code: 'KT-2025', date: '15/01/2026', status: 'Đã công nhận', icon: '⭐', size: '0.9 MB', fileName: 'giay_khen_tien_tien.pdf' }
  ];

  const allDisplayItems = [...customItems, ...assessmentEvidenceItems, ...defaultItems];

  listContainer.innerHTML = allDisplayItems.map((item, idx) => {
    const itemEncoded = encodeURIComponent(JSON.stringify(item));
    return `
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs hover:border-blue-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-800 flex items-center justify-center text-xl font-bold border border-blue-100 shrink-0">
            ${item.icon}
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h4 class="text-xs sm:text-sm font-bold text-slate-800">${item.title}</h4>
              ${item.isCustom ? '<span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 text-[10px] font-bold border border-blue-200">Mới cập nhật</span>' : ''}
            </div>
            <p class="text-[11px] text-slate-400 mt-0.5">${item.type} • Mã: ${item.code} • Ngày: ${item.date} • Dung lượng: ${item.size}</p>
          </div>
        </div>
        <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
          <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold">
            ✓ ${item.status}
          </span>
          <button type="button" onclick="viewPortfolioItemDetail('${itemEncoded}')" class="px-3 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-800 font-bold text-xs transition-all flex items-center gap-1 border border-blue-200">
            👁️ Xem
          </button>
          ${(isOwner && item.isCustom) ? `
            <button type="button" onclick="deletePortfolioItem('${item.id}')" title="Xóa minh chứng này" class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs transition-all border border-rose-200">
              🗑️
            </button>
          ` : ''}
        </div>
      </div>
    `;
  }).join('');
}

