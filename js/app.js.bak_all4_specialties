                ` : ''}
                ${crit.note ? `
                  <div class="mt-2 p-2.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 font-medium leading-relaxed">
                    <strong>📌 Hướng dẫn đánh giá:</strong> ${crit.note}
                  </div>
                ` : ''}
              </div>

              <!-- Cụm Điểm Tự Chấm & Nút Bỏ Chọn bên phải -->
              <div class="shrink-0 flex items-center gap-2 self-start lg:self-center">
                ${isScored ? `
                  <div class="flex items-center gap-2">
                    <div class="px-3.5 py-1.5 rounded-xl bg-blue-700 text-white font-black text-sm shadow-xs flex items-center gap-1.5">
                      <span>✓</span>
                      <span>${selectedScore}đ</span>
                      <span class="text-xs font-normal opacity-90">/ ${crit.maxScore}đ</span>
                    </div>
                    ${!isLocked ? `
                      <button type="button" 
                        onclick="onDeselectCriterion('${crit.id}')" 
                        title="Bỏ chọn tiêu chí này (về 0 điểm)" 
                        class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 hover:text-rose-900 border border-rose-200 text-xs font-extrabold flex items-center gap-1 transition-all cursor-pointer shadow-2xs">
                        <span>✕</span> Bỏ chọn
                      </button>
                    ` : ''}
                  </div>
                ` : `
                  <div class="px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 font-bold text-xs">
                    Tối đa: ${crit.maxScore}đ
                  </div>
