        <span class="p-1.5 rounded-xl bg-rose-50 text-rose-700 text-sm">🎯</span>
      </div>
      <div class="my-2">
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-black text-blue-900">${avgHospitalScore}</span>
          <span class="text-xs text-slate-400 font-bold">/ 1.000đ</span>
        </div>
        <div class="text-[11px] text-slate-500 mt-0.5">
          Chuẩn tối thiểu Bậc 3: <strong>≥ 400đ</strong>
        </div>
      </div>
      <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 to-emerald-500 h-full rounded-full transition-all duration-500" style="width: ${Math.min(100, Math.round((avgHospitalScore / 1000) * 100))}%"></div>
      </div>
    </div>
  `;
}

// =========================================================================
// 2. RENDER BẢNG DASHBOARD MA TRẬN THEO DÕI TẤT CẢ TIÊU CHÍ (CRITERIA MONITORING)
// =========================================================================
function renderCriteriaDashboardTab() {
  const container = document.getElementById('criteria-dashboard-table-container');
  if (!container) return;

  const f = APP_STATE.dashboardFilters || {};
  const specialty = f.specialty === 'all' ? 'lamsang' : f.specialty;
  const domainList = DOMAINS_BY_SPECIALTY[specialty] || DOMAINS_BY_SPECIALTY['lamsang'] || [];
  const filteredUsers = getFilteredUsersForDashboard();
  const totalUsers = filteredUsers.length || 1;

  let totalCriteriaCount = 0;
  let matchingCriteriaCount = 0;

  // Thu thập danh sách tiêu chí gom theo Domain
  const rowsHtml = [];

  domainList.forEach(domain => {
    let domainCriteriaRows = [];

    (domain.standards || []).forEach(standard => {
      (standard.criteria || []).forEach(criterion => {
        totalCriteriaCount++;

        // Kiểm tra lọc từ khóa tìm kiếm
        if (f.search) {
          const match = 
            (criterion.title || '').toLowerCase().includes(f.search) ||
            (criterion.id || '').toLowerCase().includes(f.search) ||
            (standard.title || '').toLowerCase().includes(f.search) ||
            (domain.name || '').toLowerCase().includes(f.search);
          if (!match) return;
        }

        matchingCriteriaCount++;

        // Thống kê nhân sự trên tiêu chí này
        let passedCount = 0;
        let maxScoreCount = 0;
        let notPassedCount = 0;
        let totalScoreSum = 0;

        filteredUsers.forEach(u => {
          const score = getEffectiveCriterionScore(u.id, criterion);
          totalScoreSum += score;
          if (score > 0) passedCount++;
          if (score >= criterion.maxScore) maxScoreCount++;
          if (score === 0) notPassedCount++;
        });

        const passRate = Math.round((passedCount / totalUsers) * 100);
        const avgScore = (totalScoreSum / totalUsers).toFixed(1);
        const maxScoreRate = Math.round((maxScoreCount / totalUsers) * 100);

        // Đánh giá trạng thái
        let statusBadge = '';
        let progressColor = 'bg-blue-600';
        if (passRate >= 80) {
          statusBadge = '<span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-[10px]">Đạt Chuẩn Cao</span>';
          progressColor = 'bg-emerald-500';
        } else if (passRate >= 50) {
          statusBadge = '<span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-800 border border-blue-200 font-bold text-[10px]">Đạt Yêu Cầu</span>';
          progressColor = 'bg-blue-500';
        } else {
          statusBadge = '<span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 font-bold text-[10px]">Cần Bồi Dưỡng</span>';
          progressColor = 'bg-amber-500';
        }

        domainCriteriaRows.push(`
          <tr class="hover:bg-blue-50/40 transition-colors border-b border-slate-100">
            <!-- STT & Mã Tiêu Chí -->
            <td class="py-3 px-3 text-center">
              <span class="font-black text-slate-700 text-xs">${criterion.num || matchingCriteriaCount}</span>
              <div class="text-[10px] text-slate-400 font-mono mt-0.5">${criterion.id}</div>
            </td>

            <!-- Tên Tiêu Chuẩn & Tiêu Chí -->
            <td class="py-3 px-3 max-w-sm">
              <div class="text-[10px] font-bold text-blue-700 uppercase tracking-wide line-clamp-1">
                ${standard.title ? standard.title.replace('\n', ' - ') : ''}
              </div>
              <div class="font-bold text-slate-800 text-xs mt-0.5">
                ${criterion.title}
              </div>
              <div class="text-[11px] text-slate-500 mt-0.5 line-clamp-1 italic">
                ${criterion.desc || 'Đánh giá năng lực thực hành chuyên môn'}
              </div>
            </td>

            <!-- Điểm Tối Đa -->
            <td class="py-3 px-3 text-center">
              <span class="px-2 py-1 rounded-lg bg-slate-100 text-slate-800 font-black text-xs border border-slate-200">
                ${criterion.maxScore}đ
              </span>
            </td>

            <!-- Số Lượng Nhân Sự Đạt (Số người & %) -->
            <td class="py-3 px-3 text-center">
              <div class="font-black text-slate-900 text-xs">
                ${passedCount} <span class="text-slate-400 font-normal">/ ${totalUsers}</span>
              </div>
              <div class="text-[10px] font-bold text-emerald-700">
                ${passRate}% nhân sự
              </div>
            </td>

            <!-- Số Lượng Đạt Điểm Tối Đa -->
            <td class="py-3 px-3 text-center">
              <span class="font-black text-blue-700 text-xs">${maxScoreCount}</span>
              <div class="text-[10px] text-slate-400 font-medium">(${maxScoreRate}%)</div>
            </td>

            <!-- Số Lượng Chưa Đạt / Cần Bổ Sung -->
            <td class="py-3 px-3 text-center">
              <span class="font-black ${notPassedCount > 0 ? 'text-rose-600' : 'text-slate-400'} text-xs">
                ${notPassedCount}
              </span>
              <div class="text-[10px] text-slate-400 font-medium">nhân viên</div>
            </td>

            <!-- Điểm Trung Bình -->
            <td class="py-3 px-3 text-center">
              <span class="font-black text-slate-800 text-xs">${avgScore}đ</span>
              <div class="text-[10px] text-slate-400">/ ${criterion.maxScore}đ</div>
            </td>

            <!-- Thanh Đo Tiến Độ Trực Quan -->
            <td class="py-3 px-3 w-32">
              <div class="flex items-center gap-2">
                <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                  <div class="${progressColor} h-full rounded-full transition-all duration-300" style="width: ${passRate}%"></div>
                </div>
                <span class="text-[10px] font-bold text-slate-700 shrink-0 w-7 text-right">${passRate}%</span>
              </div>
            </td>

            <!-- Tình Trạng Phân Loại -->
            <td class="py-3 px-3 text-center">
              ${statusBadge}
            </td>
          </tr>
        `);
      });
    });

    if (domainCriteriaRows.length > 0) {
      rowsHtml.push(`
        <!-- Domain Section Header Row -->
        <tr class="bg-gradient-to-r from-blue-900 via-indigo-900 to-blue-950 text-white font-bold text-xs">
          <td colspan="9" class="py-2.5 px-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-blue-600/60 text-blue-100 font-black text-[11px] border border-white/20">
                  LĨNH VỰC ${domain.code || ''}
                </span>
                <span class="text-xs uppercase tracking-wide font-black">${domain.name}</span>
              </div>
              <div class="text-[11px] text-blue-200 font-normal">
                Điểm trần: <strong>${domain.maxPoints}đ</strong> · Đang theo dõi: <strong>${domainCriteriaRows.length} tiêu chí</strong>
              </div>
            </div>
          </td>
        </tr>
      `);
      rowsHtml.push(...domainCriteriaRows);
    }
  });

  // Cập nhật badge đếm
  const badgeEl = document.getElementById('criteria-counter-badge');
  if (badgeEl) badgeEl.textContent = `${matchingCriteriaCount} Tiêu Chí`;

  const subEl = document.getElementById('criteria-table-summary-subtitle');
  if (subEl) {
    const specName = specialty === 'lamsang' ? 'Điều Dưỡng Lâm Sàng (66 TC)' : specialty.toUpperCase();
    subEl.textContent = `Đang theo dõi ${matchingCriteriaCount} tiêu chí trên ${totalUsers} nhân sự thuộc chuyên khoa: ${specName}`;
  }

  if (rowsHtml.length === 0) {
    container.innerHTML = `
      <div class="p-8 text-center text-slate-400">
        <span class="text-3xl block mb-2">🔍</span>
        <p class="text-xs font-bold text-slate-600">Không tìm thấy tiêu chí nào phù hợp với bộ lọc hiện tại.</p>
        <p class="text-[11px] text-slate-400 mt-1">Vui lòng điều chỉnh lại từ khóa tìm kiếm hoặc chọn chuyên môn khác.</p>
      </div>
    `;
    return;
  }

  container.innerHTML = `
    <table class="w-full text-left border-collapse min-w-[900px]">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-black text-slate-600 uppercase tracking-wider">
          <th class="py-3 px-3 text-center w-14">STT</th>
          <th class="py-3 px-3">Tên Tiêu Chuẩn & Tiêu Chí Đánh Giá</th>
          <th class="py-3 px-3 text-center w-24">Điểm Max</th>
          <th class="py-3 px-3 text-center w-36">Số Lượng Đạt (%)</th>
          <th class="py-3 px-3 text-center w-28">Đạt Tối Đa</th>
          <th class="py-3 px-3 text-center w-28">Chưa Đạt</th>
          <th class="py-3 px-3 text-center w-24">Điểm TB</th>
          <th class="py-3 px-3 w-36">Thanh Tiến Độ</th>
          <th class="py-3 px-3 text-center w-32">Tình Trạng</th>
        </tr>
      </thead>
      <tbody>
        ${rowsHtml.join('')}
      </tbody>
    </table>
  `;
}

// =========================================================================
// 3. RENDER BẢNG DASHBOARD XẾP BẬC NHÂN SỰ TOÀN VIỆN (STAFF RANKING)
// =========================================================================
function renderStaffRankingDashboardTab() {
  const container = document.getElementById('staff-ranking-dashboard-table-container');
  if (!container) return;

  const filteredUsers = getFilteredUsersForDashboard();
  const specialty = APP_STATE.dashboardFilters.specialty === 'all' ? 'lamsang' : APP_STATE.dashboardFilters.specialty;
  const domainList = DOMAINS_BY_SPECIALTY[specialty] || DOMAINS_BY_SPECIALTY['lamsang'] || [];

  // Tổng số tiêu chí của chuyên khoa này
  let totalCriteriaCount = 0;
  domainList.forEach(d => {
    (d.standards || []).forEach(st => {
      totalCriteriaCount += (st.criteria || []).length;
    });
  });

  // Cập nhật badge
  const badgeEl = document.getElementById('staff-counter-badge');
  if (badgeEl) badgeEl.textContent = `${filteredUsers.length} Nhân Sự`;

  const subEl = document.getElementById('staff-table-summary-subtitle');
  if (subEl) {
    subEl.textContent = `Xếp bậc và theo dõi tiến độ hoàn thành ${totalCriteriaCount} tiêu chí của ${filteredUsers.length} nhân sự được lọc`;
  }

  if (filteredUsers.length === 0) {
    container.innerHTML = `
      <div class="p-8 text-center text-slate-400">
        <span class="text-3xl block mb-2">👤</span>
        <p class="text-xs font-bold text-slate-600">Không tìm thấy nhân sự nào theo tiêu chí bộ lọc.</p>
        <p class="text-[11px] text-slate-400 mt-1">Vui lòng điều chỉnh lại khoa phòng, cấp bậc hoặc từ khóa tìm kiếm.</p>
      </div>
    `;
    return;
  }

  // Chuẩn bị dữ liệu và tính toán xếp bậc từng nhân sự
  const rankedUsers = filteredUsers.map(user => {
    const sub = getUserSubmission(user.id);
    const totalScore = (sub && sub.totalScore) ? sub.totalScore : 0;
    const evaluatedTier = (sub && sub.evaluatedTier) ? sub.evaluatedTier : (user.level || 1);

    // Tính điểm theo 5 Domains
    let dScores = { d1: 0, d2: 0, d3: 0, d4: 0, d5: 0 };
    if (sub && sub.domainScores) {
      dScores.d1 = sub.domainScores.lamsang_d1 || sub.domainScores.d1 || 0;
      dScores.d2 = sub.domainScores.lamsang_d2 || sub.domainScores.d2 || 0;
      dScores.d3 = sub.domainScores.lamsang_d3 || sub.domainScores.d3 || 0;
      dScores.d4 = sub.domainScores.lamsang_d4 || sub.domainScores.d4 || 0;
      dScores.d5 = sub.domainScores.lamsang_d5 || sub.domainScores.d5 || 0;
    }

    // Đếm số lượng tiêu chí đạt
    let passedCriteriaCount = 0;
    domainList.forEach(d => {
      (d.standards || []).forEach(st => {
        (st.criteria || []).forEach(cr => {
          const sc = getEffectiveCriterionScore(user.id, cr, sub);
          if (sc > 0) passedCriteriaCount++;
        });
      });
    });

    const completionRate = totalCriteriaCount > 0 ? Math.round((passedCriteriaCount / totalCriteriaCount) * 100) : 0;
    const status = sub ? sub.status : 'draft';
    const statusLabel = sub ? sub.statusLabel : 'Bản nháp (Chưa nộp)';

    return {
      user,
      sub,
      totalScore,
      evaluatedTier,
      dScores,
      passedCriteriaCount,
      completionRate,
      status,
      statusLabel
    };
  });

  // Sắp xếp theo tổng điểm giảm dần
  rankedUsers.sort((a, b) => b.totalScore - a.totalScore);

  container.innerHTML = `
    <table class="w-full text-left border-collapse min-w-[1000px]">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-black text-slate-600 uppercase tracking-wider">
          <th class="py-3 px-3 text-center w-14">Hạng</th>
          <th class="py-3 px-3">Nhân Sự (MSNV · Họ Tên)</th>
          <th class="py-3 px-3">Khoa / Phòng</th>
          <th class="py-3 px-3 text-center" title="Điểm 5 Lĩnh vực: Bằng cấp - Chuyên môn - NCKH - Quản lý - Phát triển">
            Điểm 5 Lĩnh Vực (I → V)
          </th>
          <th class="py-3 px-3 text-center w-28">Tổng Điểm</th>
          <th class="py-3 px-3 text-center w-36">Tiêu Chí Hoàn Thành</th>
          <th class="py-3 px-3 text-center w-32">Bậc Xếp Hạng</th>
          <th class="py-3 px-3 text-center w-36">Trạng Thái Hồ Sơ</th>
          <th class="py-3 px-3 text-center w-28">Hành Động</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        ${rankedUsers.map((item, idx) => {
          const u = item.user;
          const tier = item.evaluatedTier;
          let tierBadgeColor = 'bg-slate-100 text-slate-800 border-slate-200';
          if (tier === 2) tierBadgeColor = 'bg-blue-100 text-blue-900 border-blue-200';
          else if (tier === 3) tierBadgeColor = 'bg-amber-100 text-amber-900 border-amber-300';
          else if (tier === 4) tierBadgeColor = 'bg-emerald-100 text-emerald-900 border-emerald-300';
          else if (tier >= 5) tierBadgeColor = 'bg-purple-100 text-purple-900 border-purple-300';

          // Status Badge
          let statusBadgeHtml = '<span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold border border-slate-200">Bản nháp</span>';
          if (item.status === 'approved') {
            statusBadgeHtml = '<span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold border border-emerald-200">✓ Đã duyệt chính thức</span>';
          } else if (item.status === 'submitted_l3') {
            statusBadgeHtml = '<span class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold border border-purple-200">⏳ Chờ Giám Đốc (C3)</span>';
          } else if (item.status === 'submitted_l2') {
            statusBadgeHtml = '<span class="px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-800 text-[10px] font-bold border border-indigo-200">⏳ Chờ Ban ĐD (C2)</span>';
          } else if (item.status === 'submitted_l1') {
            statusBadgeHtml = '<span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold border border-amber-200">⏳ Chờ Trưởng Khoa (C1)</span>';
          }

          // Rank icon for top 3
          let rankIcon = `<span class="font-black text-slate-600 text-xs">${idx + 1}</span>`;
          if (idx === 0) rankIcon = `<span class="text-base" title="Hạng Nhất">🥇</span>`;
          else if (idx === 1) rankIcon = `<span class="text-base" title="Hạng Nhì">🥈</span>`;
          else if (idx === 2) rankIcon = `<span class="text-base" title="Hạng Ba">🥉</span>`;

          return `
            <tr class="hover:bg-amber-50/30 transition-colors">
              <!-- Hạng -->
              <td class="py-3 px-3 text-center">
                ${rankIcon}
              </td>

              <!-- Thông tin nhân sự -->
              <td class="py-3 px-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-800 font-black text-xs flex items-center justify-center border border-blue-200 shrink-0">
                    ${(u.fullName || '').charAt(0)}
                  </div>
                  <div>
                    <div class="font-black text-slate-800 text-xs hover:text-blue-700 cursor-pointer" onclick="openStaffCriteriaDetailModal('${u.id}')">
                      ${u.fullName}
                    </div>
                    <div class="text-[10px] text-slate-400 font-mono">
                      MSNV: ${u.msnv || '--'} · ${u.roleName || ''}
                    </div>
                  </div>
                </div>
              </td>

              <!-- Khoa Phòng -->
              <td class="py-3 px-3">
                <div class="text-xs font-semibold text-slate-700">${u.department || 'Khoa Chấn thương Chỉnh hình'}</div>
                <div class="text-[10px] text-blue-600 font-medium">${u.specialty === 'lamsang' ? 'Lâm sàng' : (u.specialty || 'Lâm sàng')}</div>
              </td>

              <!-- Điểm 5 Lĩnh Vực -->
              <td class="py-3 px-3 text-center">
                <div class="inline-flex items-center gap-1 text-[10px] font-bold">
                  <span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-800 border border-blue-200" title="Lĩnh vực I: Bằng cấp">${item.dScores.d1}đ</span>
                  <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200" title="Lĩnh vực II: Chuyên môn">${item.dScores.d2}đ</span>
                  <span class="px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200" title="Lĩnh vực III: NCKH & ĐT">${item.dScores.d3}đ</span>
                  <span class="px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-800 border border-indigo-200" title="Lĩnh vực IV: Quản lý">${item.dScores.d4}đ</span>
                  <span class="px-1.5 py-0.5 rounded bg-purple-50 text-purple-800 border border-purple-200" title="Lĩnh vực V: Phát triển">${item.dScores.d5}đ</span>
                </div>
              </td>

              <!-- Tổng Điểm -->
              <td class="py-3 px-3 text-center">
                <span class="font-black text-sm ${item.totalScore >= 400 ? 'text-amber-600' : 'text-slate-800'}">
                  ${item.totalScore}đ
                </span>
                <div class="text-[10px] text-slate-400">/ 1.000đ</div>
              </td>

              <!-- Tiêu chí hoàn thành -->
              <td class="py-3 px-3 text-center">
                <div class="font-black text-xs text-slate-800">
                  ${item.passedCriteriaCount} <span class="text-slate-400 font-normal">/ ${totalCriteriaCount} TC</span>
                </div>
                <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden mt-1">
                  <div class="bg-blue-600 h-full rounded-full" style="width: ${item.completionRate}%"></div>
                </div>
                <div class="text-[10px] text-slate-400 font-bold mt-0.5">${item.completionRate}% đạt</div>
              </td>

              <!-- Bậc Năng Lực Xếp Hạng -->
              <td class="py-3 px-3 text-center">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-xs font-black border ${tierBadgeColor}">
                  <span>🎖️</span> Bậc ${tier}
                </span>
              </td>

              <!-- Trạng Thái Hồ Sơ -->
              <td class="py-3 px-3 text-center">
                ${statusBadgeHtml}
              </td>

              <!-- Nút Xem Chi Tiết -->
              <td class="py-3 px-3 text-center">
                <button type="button" onclick="openStaffCriteriaDetailModal('${u.id}')" class="px-2.5 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-800 font-bold text-xs transition-all border border-blue-200 flex items-center gap-1 mx-auto cursor-pointer" title="Xem chi tiết điểm số từng tiêu chí của nhân viên này">
                  <span>👁️</span> Xem TC
                </button>
              </td>
            </tr>
          `;
        }).join('')}
      </tbody>
    </table>
  `;
}

// =========================================================================
// 4. MODAL XEM CHI TIẾT BẢNG ĐIỂM TIÊU CHÍ CỦA NHÂN SỰ
// =========================================================================
function openStaffCriteriaDetailModal(userId) {
  const user = (APP_STATE.users || []).find(u => u.id === userId);
  if (!user) return;

  const sub = getUserSubmission(userId);
  const specialty = user.specialty || 'lamsang';
  const domainList = DOMAINS_BY_SPECIALTY[specialty] || DOMAINS_BY_SPECIALTY['lamsang'] || [];

  // Update Modal Header
  const nameEl = document.getElementById('staff-detail-modal-name');
  if (nameEl) nameEl.textContent = `Hồ Sơ Năng Lực: ${user.fullName}`;

  const subEl = document.getElementById('staff-detail-modal-sub');
  if (subEl) subEl.textContent = `MSNV: ${user.msnv} · Khoa: ${user.department || 'Chấn thương Chỉnh hình'} · Chức danh: ${user.roleName}`;

  // Mini KPI Ribbon inside modal
  const kpiEl = document.getElementById('staff-detail-modal-kpi');
  const totalScore = (sub && sub.totalScore) ? sub.totalScore : 0;
  const tier = (sub && sub.evaluatedTier) ? sub.evaluatedTier : (user.level || 1);

  // Đếm tiêu chí
  let passedCount = 0;
  let totalCrit = 0;
  domainList.forEach(d => {
    (d.standards || []).forEach(st => {
      (st.criteria || []).forEach(cr => {
        totalCrit++;
        const sc = getEffectiveCriterionScore(userId, cr, sub);
        if (sc > 0) passedCount++;
      });
    });
  });

  if (kpiEl) {
    kpiEl.innerHTML = `
      <div class="p-2 bg-white rounded-xl border border-slate-200">
        <div class="text-[10px] text-slate-400 font-bold uppercase">Tổng Điểm Năng Lực</div>
        <div class="text-lg font-black text-blue-900 mt-0.5">${totalScore} <span class="text-xs text-slate-400 font-normal">/ 1000đ</span></div>
      </div>
      <div class="p-2 bg-white rounded-xl border border-slate-200">
        <div class="text-[10px] text-slate-400 font-bold uppercase">Bậc Xếp Hạng Đạt</div>
        <div class="text-lg font-black text-amber-600 mt-0.5">🎖️ Cấp Bậc ${tier}</div>
      </div>
      <div class="p-2 bg-white rounded-xl border border-slate-200">
        <div class="text-[10px] text-slate-400 font-bold uppercase">Tiêu Chí Hoàn Thành</div>
        <div class="text-lg font-black text-emerald-700 mt-0.5">${passedCount} <span class="text-xs text-slate-400 font-normal">/ ${totalCrit} TC</span></div>
      </div>
      <div class="p-2 bg-white rounded-xl border border-slate-200">
        <div class="text-[10px] text-slate-400 font-bold uppercase">Trạng Thái Hồ Sơ</div>
        <div class="text-xs font-black text-purple-800 mt-1.5">${sub ? sub.statusLabel : 'Bản nháp'}</div>
      </div>
    `;
  }

  // Render Danh Sách Chi Tiết Từng Tiêu Chí
  const bodyEl = document.getElementById('staff-detail-modal-body');
  if (bodyEl) {
    const sections = [];
    domainList.forEach(d => {
      const critRows = [];
      (d.standards || []).forEach(st => {
        (st.criteria || []).forEach(cr => {
          const score = getEffectiveCriterionScore(userId, cr, sub);
          const max = cr.maxScore;
          const isMax = score >= max;
          const isZero = score === 0;

          // Tìm mô tả của mức điểm đã đạt
          let optText = 'Chưa chọn mức độ đánh giá';
          if (cr.options && cr.options.length > 0) {
            const opt = cr.options.find(o => o.score === score);
            if (opt) optText = opt.text || opt.level || '';
          }

          critRows.push(`
            <div class="p-3 bg-white rounded-xl border border-slate-200 hover:border-blue-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-900 font-black text-[10px]">${cr.id.toUpperCase()}</span>
                  <span class="font-bold text-slate-800 text-xs">${cr.title}</span>
                </div>
                <p class="text-[11px] text-slate-500 mt-1">
                  <strong>Mức độ đạt:</strong> <span class="text-blue-800 font-medium">${optText}</span>
                </p>
              </div>
              <div class="flex items-center gap-3 shrink-0 self-end sm:self-center">
                <div class="text-right">
                  <span class="text-base font-black ${isMax ? 'text-emerald-600' : (isZero ? 'text-slate-400' : 'text-blue-700')}">
                    ${score}
                  </span>
                  <span class="text-xs text-slate-400 font-normal">/ ${max}đ</span>
                </div>
                <span class="px-2 py-1 rounded-md text-[10px] font-bold ${isMax ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : (isZero ? 'bg-slate-100 text-slate-600' : 'bg-blue-50 text-blue-800 border border-blue-200')}">
                  ${isMax ? 'Đạt Tối Đa' : (isZero ? 'Chưa Đạt' : 'Đạt Chuẩn')}
                </span>
              </div>
            </div>
          `);
        });
      });

      sections.push(`
        <div class="space-y-2">
          <div class="flex items-center justify-between p-2.5 bg-slate-100 rounded-xl font-bold text-slate-800">
            <span>🔹 LĨNH VỰC ${d.code || ''}: ${d.name}</span>
            <span class="text-blue-800 text-xs">Trần: ${d.maxPoints}đ</span>
          </div>
          <div class="space-y-2 pl-2">
            ${critRows.join('')}
          </div>
        </div>
      `);
    });

    bodyEl.innerHTML = sections.join('');
  }

  const modal = document.getElementById('modal-staff-criteria-detail');
  if (modal) modal.classList.remove('hidden');
}

function closeStaffCriteriaDetailModal() {
  const modal = document.getElementById('modal-staff-criteria-detail');
  if (modal) modal.classList.add('hidden');
}

