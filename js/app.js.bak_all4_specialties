// PHÂN HỆ 2: QUẢN LÝ TIÊU CHÍ & KHUNG NĂNG LỰC (CRITERIA MANAGEMENT)
// =========================================================================

function renderAdminCriteria() {
  const container = document.getElementById('admin-criteria-list-container');
  if (!container) return;

  const domains = (typeof DOMAINS_BY_SPECIALTY !== 'undefined' && DOMAINS_BY_SPECIALTY['lamsang']) ? DOMAINS_BY_SPECIALTY['lamsang'] : [];
  const domainFilter = APP_STATE.adminCriteriaDomainFilter || 'all';
  const search = (APP_STATE.adminCriteriaSearchQuery || '').trim().toLowerCase();

  // Điền danh sách lĩnh vực vào dropdown bộ lọc
  const selectDomain = document.getElementById('admin-criteria-domain-select');
  if (selectDomain && selectDomain.options.length <= 1) {
    selectDomain.innerHTML = `
      <option value="all">🌟 Tất Cả 5 Lĩnh Vực</option>
      ${domains.map(d => `
        <option value="${d.id}" ${domainFilter === d.id ? 'selected' : ''}>${d.code} ${d.name} (${d.maxPoints}đ)</option>
      `).join('')}
    `;
  }

  const targetDomains = domainFilter === 'all' ? domains : domains.filter(d => d.id === domainFilter);

  // Đếm tổng tiêu chí
  let totalShown = 0;
  let totalActive = 0;

  let html = '';
  targetDomains.forEach((d, dIdx) => {
    let domainCritHtml = '';

    (d.standards || []).forEach(s => {
      let filteredCriteria = s.criteria || [];
      if (search) {
        filteredCriteria = filteredCriteria.filter(c => 
          (c.id || '').toLowerCase().includes(search) || 
          (c.title || '').toLowerCase().includes(search) ||
          (c.standard || '').toLowerCase().includes(search)
        );
      }

      if (filteredCriteria.length === 0) return;

      domainCritHtml += `
        <div class="mb-4 bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-2xs">
          <!-- Standard Header -->
          <div class="bg-slate-50 px-4 py-2.5 border-b border-slate-200/80 flex items-center justify-between gap-2">
            <div class="font-extrabold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded bg-blue-100 text-blue-800 flex items-center justify-center text-[10px] font-black">${s.number || 'TC'}</span>
              <span>${(s.title || '').replace(/\n/g, ' - ')}</span>
            </div>
            <span class="text-[11px] text-slate-500 font-bold">${filteredCriteria.length} tiêu chí</span>
          </div>

          <!-- Criteria Table -->
          <div class="divide-y divide-slate-100">
            ${filteredCriteria.map(c => {
              totalShown++;
              const isActive = c.active !== false;
              if (isActive) totalActive++;
              const optCount = (c.options || []).length;
              const maxScore = c.maxScore || (c.options && c.options.length ? Math.max(...c.options.map(o => o.score || 0)) : 0);

              return `
                <div class="p-4 hover:bg-slate-50/60 transition-all flex flex-col md:flex-row md:items-center justify-between gap-3 text-xs ${!isActive ? 'opacity-50 bg-slate-50' : ''}">
                  <!-- Info Left -->
                  <div class="space-y-1 max-w-2xl">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="font-mono font-black text-blue-800 bg-blue-50 px-2 py-0.5 rounded text-[11px] border border-blue-200">
                        ${c.id}
                      </span>
                      <span class="font-black text-slate-900">${c.title}</span>
                      ${!isActive ? '<span class="text-[10px] font-bold bg-amber-100 text-amber-800 px-2 py-0.2 rounded-full">Tạm dừng áp dụng</span>' : '<span class="text-[10px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.2 rounded-full">Đang áp dụng</span>'}
                    </div>
                    <p class="text-slate-500 text-[11px] line-clamp-2">${c.desc || ''}</p>
                    <div class="text-[10px] text-slate-400 flex items-center gap-3">
                      <span>Thang điểm: <strong class="text-blue-700 font-bold">${maxScore} điểm</strong></span>
                      <span>•</span>
                      <span>Mức độ lựa chọn: <strong>${optCount} mức</strong></span>
                      ${c.isCustom ? '<span class="text-purple-700 font-black bg-purple-50 px-1.5 py-0.2 rounded border border-purple-200">✨ Tiêu chí do Admin tạo</span>' : ''}
                    </div>
                  </div>

                  <!-- Actions Right -->
                  <div class="flex items-center gap-2 self-end md:self-center shrink-0">
                    <button type="button" onclick="toggleCriterionStatus('${c.id}')" class="px-2.5 py-1.5 rounded-xl font-bold text-[11px] border transition-all ${
                      isActive 
                        ? 'bg-amber-50 hover:bg-amber-100 text-amber-800 border-amber-200' 
                        : 'bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border-emerald-200'
                    }" title="${isActive ? 'Tạm dừng tiêu chí này đối với nhân viên mới' : 'Kích hoạt lại tiêu chí này'}">
                      ${isActive ? '⏸️ Tạm Dừng' : '▶️ Kích Hoạt'}
                    </button>

                    <button type="button" onclick="openEditCriterionModal('${c.id}')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-[11px] border border-slate-200 transition-all">
                      ✏️ Sửa
                    </button>

                    ${c.isCustom ? `
                      <button type="button" onclick="confirmDeleteCriterion('${c.id}')" class="p-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-xl text-xs transition-all" title="Xóa tiêu chí tự tạo">
                        🗑️
                      </button>
                    ` : ''}
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    });

    if (domainCritHtml) {
      html += `
        <div class="mb-6">
          <div class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white px-5 py-3 rounded-2xl mb-3 flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-lg bg-white/20 text-white flex items-center justify-center text-xs font-black">${d.code}</span>
              <h4 class="text-sm font-black uppercase tracking-wide">${d.name}</h4>
            </div>
            <span class="text-xs font-extrabold text-blue-200 bg-white/10 px-3 py-1 rounded-full border border-white/20">
              Điểm trần: ${d.maxPoints}đ
            </span>
          </div>
          ${domainCritHtml}
        </div>
      `;
    }
  });

  // Cập nhật số đếm kết quả tiêu chí
  const critCountBadge = document.getElementById('admin-criteria-filtered-count');
  if (critCountBadge) critCountBadge.textContent = `${totalShown} tiêu chí (${totalActive} đang kích hoạt)`;

  if (!html) {
    container.innerHTML = `
      <div class="p-8 text-center bg-white rounded-2xl border border-slate-200 text-slate-400 text-xs">
        Không tìm thấy tiêu chí nào phù hợp với từ khóa "${search}".
      </div>
    `;
    return;
  }

  container.innerHTML = html;
}

