let UMC_DEFAULT_DOMAINS_BACKUP = null;

function initAdminCriteriaStorage() {
  if (!UMC_DEFAULT_DOMAINS_BACKUP && typeof DOMAINS_BY_SPECIALTY !== 'undefined') {
    try {
      UMC_DEFAULT_DOMAINS_BACKUP = JSON.parse(JSON.stringify(DOMAINS_BY_SPECIALTY));
    } catch (e) {
      console.warn('Không thể sao lưu tiêu chí gốc:', e);
    }
  }

  // Tải cấu hình tiêu chí đã lưu trong LocalStorage nếu có
  try {
    const saved = localStorage.getItem('umc_domains_by_specialty');
    if (saved && typeof DOMAINS_BY_SPECIALTY !== 'undefined') {
      const parsed = JSON.parse(saved);
      if (parsed && parsed.lamsang && Array.isArray(parsed.lamsang) && parsed.lamsang.length > 0) {
        DOMAINS_BY_SPECIALTY.lamsang = parsed.lamsang;
      }
    }
  } catch (err) {
    console.warn('Lỗi đọc tiêu chí từ storage:', err);
  }
}

