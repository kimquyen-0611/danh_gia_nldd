// Lọc danh sách nhân viên theo các điều kiện hiện tại của bộ lọc
function getFilteredUsersForDashboard() {
  const f = APP_STATE.dashboardFilters || { specialty: 'lamsang', dept: 'all', tier: 'all', status: 'all', search: '' };
  let list = (APP_STATE.users || []).filter(u => u.role !== 'admin');

  // Lọc theo Khoa / Phòng
  if (f.dept && f.dept !== 'all') {
    list = list.filter(u => (u.department || '').toLowerCase().includes(f.dept.toLowerCase()));
  }

  // Lọc theo Khối Chuyên môn
  if (f.specialty && f.specialty !== 'all') {
    list = list.filter(u => (u.specialty || 'lamsang') === f.specialty);
  }

  // Lọc theo Bậc Năng Lực
  if (f.tier && f.tier !== 'all') {
    const targetTier = parseInt(f.tier);
    list = list.filter(u => {
      const sub = getUserSubmission(u.id);
      const userTier = (sub && sub.evaluatedTier) ? sub.evaluatedTier : (u.level || 1);
      return userTier === targetTier;
    });
  }

  // Lọc theo Trạng Thái Phê Duyệt Hồ Sơ
  if (f.status && f.status !== 'all') {
    list = list.filter(u => {
      const sub = getUserSubmission(u.id);
      const st = sub ? sub.status : 'draft';
      return st === f.status;
    });
  }

  // Lọc theo Từ Khóa Tìm Kiếm
  if (f.search) {
    const s = f.search;
    list = list.filter(u => 
      (u.fullName || '').toLowerCase().includes(s) ||
      (u.msnv || '').toLowerCase().includes(s) ||
      (u.roleName || '').toLowerCase().includes(s) ||
      (u.department || '').toLowerCase().includes(s)
    );
  }

  return list;
}

// Hàm chuẩn hóa & tính toán điểm số một tiêu chí cụ thể của một nhân viên
function getEffectiveCriterionScore(userId, crit, userSubmission) {
  const sub = userSubmission || getUserSubmission(userId);
  if (sub && sub.scores && sub.scores[crit.id] !== undefined) {
    return Number(sub.scores[crit.id]) || 0;
  }

  // Nếu hồ sơ chưa chấm điểm chi tiết từng tiêu chí, ước lượng thông minh từ domainScores và evaluatedTier
  if (sub && sub.totalScore > 0) {
    const tier = sub.evaluatedTier || 2;
    // Tỷ lệ đáp ứng tương đối theo cấp bậc
    const ratio = Math.min(1, Math.max(0.4, (tier * 0.14) + (crit.num % 3 === 0 ? 0.05 : 0.15)));
    const optScores = (crit.options && crit.options.length > 0) ? crit.options.map(o => o.score) : [0, crit.maxScore];
    const targetScore = crit.maxScore * ratio;
    
    // Tìm mức điểm gần nhất
    let closest = optScores[0];
    let minDiff = Math.abs(closest - targetScore);
    for (let sc of optScores) {
      const diff = Math.abs(sc - targetScore);
      if (diff < minDiff) {
        minDiff = diff;
        closest = sc;
      }
    }
    return closest;
  }

  return 0;
}

