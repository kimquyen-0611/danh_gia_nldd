// Render dải chỉ số KPI quản trị
function renderAdminKpiStrip() {
  const users = APP_STATE.users || [];
  const submissions = APP_STATE.submissions || {};
  
  // Đếm số khoa phòng
  const depts = new Set(users.map(u => u.department).filter(Boolean));
  
  // Đếm số tiêu chí đang kích hoạt
  const domains = (typeof DOMAINS_BY_SPECIALTY !== 'undefined' && DOMAINS_BY_SPECIALTY['lamsang']) ? DOMAINS_BY_SPECIALTY['lamsang'] : [];
  let totalCritCount = 0;
  domains.forEach(d => {
    (d.standards || []).forEach(s => {
      (s.criteria || []).forEach(c => {
        if (c.active !== false) totalCritCount++;
      });
    });
  });

  // Đếm số hồ sơ chờ duyệt
  let pendingCount = 0;
  Object.values(submissions).forEach(sub => {
    if (['submitted_l1', 'submitted_l2', 'submitted_l3'].includes(sub.status)) {
      pendingCount++;
    }
  });

  const elUsers = document.getElementById('admin-stat-users-count');
  if (elUsers) elUsers.textContent = users.length;

  const elDepts = document.getElementById('admin-stat-depts-count');
  if (elDepts) elDepts.textContent = depts.size;

  const elCrit = document.getElementById('admin-stat-criteria-count');
  if (elCrit) elCrit.textContent = `${totalCritCount} TC`;

  const elPending = document.getElementById('admin-stat-pending-count');
  if (elPending) elPending.textContent = pendingCount;
}

