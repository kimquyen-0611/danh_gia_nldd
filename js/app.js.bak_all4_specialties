// Phê duyệt hồ sơ theo phân quyền chặt chẽ
function renderApprovalsTab() {
  const container = document.getElementById('approval-submissions-table-body');
  if (!container) return;
  
  const user = APP_STATE.currentUser;
  const filter = APP_STATE.filterApprovalStatus || 'all';
  
  // Row-Level Security: Phân quyền theo vai trò
  let list = APP_STATE.submissions || [];
  if (user) {
    if (user.role === 'head_nurse' || user.role === 'deputy_head_nurse') {
      // Quản lý trực tiếp (ĐD Trưởng): Duyệt cho cấp dưới trong khoa (không tự duyệt chính mình)
      list = list.filter(s => s.department === user.department && s.userId !== user.id);
    } else if (user.role === 'nurse_board' || user.role === 'chief_nurse') {
      // Trưởng Ban Điều Dưỡng: Duyệt Cấp 2 cho ĐD Trưởng và nhân sự toàn viện
      list = list.filter(s => s.userId !== user.id);
    } else if (user.role === 'director') {
      // Ban Lãnh Đạo: Phê duyệt Cấp 3 cho toàn viện (bao gồm cả hồ sơ của Trưởng Ban ĐD)
      list = list;
    } else if (user.role === 'nurse') {
      // Nhân viên thông thường: Chỉ thấy hồ sơ của mình
      list = list.filter(s => s.userId === user.id);
    }
  }

  // Lọc theo trạng thái
  if (filter !== 'all') {
    list = list.filter(s => s.status === filter);
  }

  // Lọc theo từ khóa tìm kiếm (nếu có)
  if (APP_STATE.approvalSearchQuery) {
    const q = APP_STATE.approvalSearchQuery.toLowerCase().trim();
    list = list.filter(s => 
      (s.fullName && s.fullName.toLowerCase().includes(q)) ||
      (s.msnv && s.msnv.toLowerCase().includes(q)) ||
      (s.department && s.department.toLowerCase().includes(q))
    );
  }
  
  if (list.length === 0) {
    container.innerHTML = `
      <tr>
        <td colspan="7" class="py-8 text-center text-slate-400 text-xs">
          Không có hồ sơ nào trong trạng thái này thuộc phạm vi quản lý của bạn.
        </td>
      </tr>
    `;
    updateApprovalCounters();
    return;
  }
  
  let html = '';
  list.forEach(sub => {
    const stage = WORKFLOW_STAGES[sub.status] || { label: sub.status, color: 'bg-slate-100 text-slate-600', step: 0 };
    const tierObj = COMPETENCY_TIERS_MATRIX.find(t => t.tier === (sub.evaluatedTier || sub.currentTier)) || COMPETENCY_TIERS_MATRIX[0];
    const evCount = Object.keys(sub.criterionEvidences || {}).length;
    
    // Highlight hồ sơ Trưởng Ban Điều Dưỡng gửi Ban Lãnh Đạo
    const isChiefNurseSub = (sub.userId === 'usr_dan_ptt');

    html += `
      <tr class="border-b border-slate-100 hover:bg-slate-50/80 transition-all text-xs ${isChiefNurseSub ? 'bg-purple-50/40' : ''}">
        <td class="py-3 px-4 font-extrabold text-blue-900">${sub.msnv}</td>
        <td class="py-3 px-4">
          <div class="font-bold text-slate-900 flex items-center gap-1.5">
            <span>${sub.fullName}</span>
            ${isChiefNurseSub ? '<span class="text-[10px] bg-purple-100 text-purple-800 px-1.5 py-0.2 rounded font-black">Trưởng Ban ĐD</span>' : ''}
          </div>
          <div class="text-slate-400 text-[11px]">${sub.department}</div>
        </td>
        <td class="py-3 px-4 text-center">
          <span class="font-black text-blue-700 text-sm">${sub.totalScore || 0}</span>
          <span class="text-[10px] text-slate-400 block">/ 1000đ</span>
        </td>
        <td class="py-3 px-4 text-center">
          <span class="level-badge level-${sub.evaluatedTier || sub.currentTier} text-xs px-2.5 py-0.5 font-bold">
            ${tierObj.code}
          </span>
        </td>
        <td class="py-3 px-4 text-center">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold ${stage.color || 'bg-slate-100 text-slate-700'}">
            ${stage.label}
          </span>
        </td>
        <td class="py-3 px-4 text-center">
          <span class="text-xs font-bold ${evCount > 0 ? 'text-blue-700' : 'text-slate-400'}">
            📁 ${evCount} minh chứng
          </span>
        </td>
        <td class="py-3 px-4 text-right">
          <div class="flex items-center justify-end gap-1.5">
            <button onclick="openReviewModal('${sub.id}')" class="px-2 py-1 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold border border-blue-200 transition-all text-xs" title="Xem chi tiết & Thẩm định">
              👁️ Xem
            </button>
            ${renderApproverActionButtons(sub)}
          </div>
        </td>
      </tr>
    `;
  });
  
  container.innerHTML = html;
  updateApprovalCounters();
}

// Bảo vệ các chức năng Admin: Chỉ cho phép admin thực hiện
function checkAdminPermission() {
  const user = APP_STATE.currentUser;
  if (!user || user.role !== 'admin') {
    showToast('Chỉ Quản trị viên hệ thống (Admin) mới có quyền thực hiện chức năng này!', 'error');
    return false;
  }
  return true;
}

