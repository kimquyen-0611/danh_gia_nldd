// Cập nhật hiển thị giao diện theo vai trò của người dùng hiện tại
function updateRoleVisibility() {
  const user = APP_STATE.currentUser;
  if (!user) return;
  
  const role = user.role;
  const isDirector = (role === 'director');
  const isChiefNurse = (role === 'nurse_board' || role === 'chief_nurse');
  const isHeadNurse = (role === 'head_nurse' || role === 'deputy_head_nurse');
  const isNurse = (role === 'nurse');
  const isAdmin = (role === 'admin');

  // 1. Tab Phiếu Đánh Giá:
  // - Ban Lãnh Đạo (director): KHÔNG CÓ PHIẾU ĐÁNH GIÁ -> ẨN!
  // - Trưởng Ban ĐD, ĐD Trưởng, Nhân viên, Admin: CÓ PHIẾU ĐÁNH GIÁ -> HIỂN THỊ!
  const btnAssessment = document.getElementById('nav-btn-assessment');
  if (btnAssessment) {
    btnAssessment.style.display = isDirector ? 'none' : 'inline-flex';
  }

  // 2. Tab Phê Duyệt Hồ Sơ:
  // - Nhân viên (nurse): KHÔNG PHÊ DUYỆT AI -> ẨN!
  // - Quản lý (head_nurse, chief_nurse/nurse_board, director, admin): HIỂN THỊ!
  const btnApproval = document.getElementById('nav-btn-approval');
  if (btnApproval) {
    btnApproval.style.display = isNurse ? 'none' : 'inline-flex';
  }

  // 3. Tab Hồ Sơ Minh Chứng (Portfolio):
  // - Hiển thị cho tất cả
  const btnPortfolio = document.getElementById('nav-btn-portfolio');
  if (btnPortfolio) {
    btnPortfolio.style.display = 'inline-flex';
  }

  // 4. Tab Báo Cáo & Xếp Bậc:
  // - Hiển thị cho tất cả
  const btnReports = document.getElementById('nav-btn-reports');
  if (btnReports) {
    btnReports.style.display = 'inline-flex';
  }

  // 5. Tab Phân Quyền & Quản Trị:
  // - Chỉ Quản trị viên (admin), Trưởng Ban ĐD (nurse_board) và Ban Lãnh Đạo (director) mới thấy
  // - Nhân viên (nurse) và ĐD Trưởng khoa (head_nurse): ẨN!
  const btnAdmin = document.getElementById('nav-btn-admin');
  if (btnAdmin) {
    btnAdmin.style.display = (isAdmin || isChiefNurse || isDirector) ? 'inline-flex' : 'none';
  }

  // 6. Nút phê duyệt hàng loạt của Ban Lãnh Đạo
  const batchBtn = document.getElementById('btn-batch-approve-leader');
  if (batchBtn) {
    batchBtn.style.display = (isDirector || isAdmin) ? 'inline-flex' : 'none';
  }

  // 7. Nếu Ban Lãnh Đạo đang ở tab assessment (hoặc mới đăng nhập), tự động chuyển sang tab approval
  if (isDirector && (APP_STATE.activeTab === 'assessment' || !APP_STATE.activeTab)) {
    switchTab('approval');
  }
}

// Chuyển Tab có kiểm tra quyền nghiêm ngặt
function switchTab(tabId) {
  const user = APP_STATE.currentUser;
  
  if (user) {
    // Ban Lãnh Đạo không có phiếu tự đánh giá
    if (user.role === 'director' && tabId === 'assessment') {
      showToast('Ban Lãnh Đạo không có phiếu tự đánh giá cá nhân. Đã chuyển sang Trung tâm Phê Duyệt Hồ Sơ.', 'info');
      tabId = 'approval';
    }

    // Nhân viên không có quyền phê duyệt hoặc quản trị
    if (user.role === 'nurse') {
      if (tabId === 'approval') {
        showToast('Điều dưỡng viên không có quyền truy cập chức năng phê duyệt hồ sơ!', 'warning');
        tabId = 'assessment';
      } else if (tabId === 'admin') {
        showToast('Điều dưỡng viên không có quyền truy cập trang quản trị hệ thống!', 'warning');
        tabId = 'assessment';
      }
    }

    // ĐD Trưởng không vào trang cấu hình quản trị hệ thống
    if (user.role === 'head_nurse' && tabId === 'admin') {
      showToast('Điều dưỡng trưởng khoa không có quyền cấu hình quản trị hệ thống!', 'warning');
      tabId = 'approval';
    }
  }

  let mainNavId = tabId;
  if (['tiers', 'honor', 'analytics', 'idp', 'stats', 'reports'].includes(tabId)) {
    mainNavId = 'reports';
  }
  APP_STATE.activeTab = mainNavId;

  // Ẩn tất cả tab content
  document.querySelectorAll('.tab-content, .tab-pane').forEach(el => el.classList.add('hidden'));

  // Đặt lại style các nút nav
  document.querySelectorAll('.nav-tab-btn').forEach(btn => {
    btn.classList.remove('bg-white', 'text-[#004b87]', 'shadow-sm');
    btn.classList.add('text-blue-100', 'hover:bg-white/15');
  });

  const activeBtn = document.getElementById(`nav-btn-${mainNavId}`);
  if (activeBtn) {
    activeBtn.classList.add('bg-white', 'text-[#004b87]', 'shadow-sm');
    activeBtn.classList.remove('text-blue-100', 'hover:bg-white/15');
  }

  // Hiển thị view phù hợp
  if (tabId === 'assessment') {
    const pane = document.getElementById('tab-assessment');
    if (pane) pane.classList.remove('hidden');
    if (typeof renderAssessmentTab === 'function') renderAssessmentTab();
  } else if (tabId === 'portfolio') {
    const pane = document.getElementById('tab-portfolio');
    if (pane) pane.classList.remove('hidden');
    renderPortfolioTab();
  } else if (tabId === 'approval') {
    const pane = document.getElementById('tab-approval');
    if (pane) pane.classList.remove('hidden');
    if (typeof renderApprovalsTab === 'function') renderApprovalsTab();
  } else if (tabId === 'admin') {
    const pane = document.getElementById('tab-admin');
    if (pane) pane.classList.remove('hidden');
    if (typeof renderAdminTab === 'function') renderAdminTab();
  } else if (mainNavId === 'reports') {
    const activePane = document.getElementById('tab-reports');
    if (activePane) activePane.classList.remove('hidden');
    const targetSub = ['criteria', 'staff', 'tiers', 'honor', 'analytics', 'idp', 'stats'].includes(tabId) ? tabId : (APP_STATE.activeReportSubTab || 'criteria');
    switchReportSubTab(targetSub);
  }
}

// Chuyển Sub-Tab trong Trung tâm Báo Cáo & Xếp Bậc (Hỗ Trợ Toàn Diện Dashboard Mới)
function switchReportSubTab(subTabId) {
  APP_STATE.activeReportSubTab = subTabId;
  
  // Ẩn tất cả subpane
  document.querySelectorAll('.report-subpane').forEach(el => el.classList.add('hidden'));
  
  // Đặt lại style các nút pill
  document.querySelectorAll('.sub-tab-btn').forEach(btn => {
    btn.classList.remove('bg-blue-700', 'text-white', 'bg-white', 'text-blue-800', 'shadow-xs');
    btn.classList.add('text-slate-600', 'hover:text-slate-900');
  });
  
  // Kích hoạt subpane được chọn
  const activePane = document.getElementById(`subpane-${subTabId}`);
  if (activePane) activePane.classList.remove('hidden');
  
  const activeBtn = document.getElementById(`sub-nav-${subTabId}`);
  if (activeBtn) {
    activeBtn.classList.remove('text-slate-600', 'hover:text-slate-900');
    activeBtn.classList.add('bg-blue-700', 'text-white', 'shadow-xs');
  }
  
  // Luôn cập nhật dải thẻ KPI vĩ mô đầu trang Dashboard
  if (typeof renderExecutiveKPICards === 'function') {
    renderExecutiveKPICards();
  }

  // Render dữ liệu tương ứng
  if (subTabId === 'criteria') {
    if (typeof renderCriteriaDashboardTab === 'function') renderCriteriaDashboardTab();
  } else if (subTabId === 'staff') {
    if (typeof renderStaffRankingDashboardTab === 'function') renderStaffRankingDashboardTab();
  } else if (subTabId === 'tiers') {
    if (typeof renderTiersTab === 'function') renderTiersTab();
  } else if (subTabId === 'honor') {
    if (typeof renderHonorTab === 'function') renderHonorTab();
  } else if (subTabId === 'analytics') {
    if (typeof renderAnalyticsTab === 'function') renderAnalyticsTab();
  } else if (subTabId === 'stats') {
    if (typeof renderReportsTab === 'function') renderReportsTab();
  } else if (subTabId === 'idp') {
    if (typeof renderIDPTab === 'function') renderIDPTab();
  }
}

// Cập nhật hàm login để tự động định tuyến theo vai trò
const _origLogin = window.login;
function login(username, password) {
  const uClean = username.toLowerCase().trim();
  const user = (APP_STATE.users || []).find(u => 
    (u.id && u.id.toLowerCase() === uClean) ||
    (u.userName && u.userName.toLowerCase() === uClean) || 
    (u.msnv && u.msnv.toLowerCase() === uClean) ||
    (u.email && u.email.toLowerCase() === uClean) ||
    (u.fullName && u.fullName.toLowerCase() === uClean)
  );
  
  if (!user) {
    showToast(`Không tìm thấy tài khoản "${username}". Vui lòng kiểm tra lại!`, 'error');
    return false;
  }
  
  APP_STATE.currentUser = user;
  APP_STATE.isLoggedIn = true;
  APP_STATE.selectedSpecialty = user.specialty || 'lamsang';
  APP_STATE.portfolioSelectedUserId = user.id;
  
  if (typeof loadUserSubmission === 'function') loadUserSubmission(user.id);
  
  // Ẩn login screen, hiển thị main app wrapper
  const loginScreen = document.getElementById('login-screen');
  const mainWrapper = document.getElementById('main-app-wrapper');
  
  if (loginScreen) loginScreen.classList.add('hidden');
  if (mainWrapper) mainWrapper.classList.remove('hidden');
  
  if (typeof updateHeaderUserInfo === 'function') updateHeaderUserInfo();
  updateRoleVisibility();

  // Ban Lãnh Đạo không có phiếu đánh giá -> vào thẳng tab Phê Duyệt Hồ Sơ
  if (user.role === 'director') {
    switchTab('approval');
  } else {
    switchTab('assessment');
  }

  if (typeof renderAllViews === 'function') renderAllViews();
  
  showToast(`Đăng nhập thành công! Xin chào ${user.fullName} (${user.roleName})`, 'success');
  return true;
}

