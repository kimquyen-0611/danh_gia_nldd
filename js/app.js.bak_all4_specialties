function promptRollbackApproval(subId) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  const user = APP_STATE.currentUser;
  if (!sub || !user) return;
  
  const isBanDDSub = (sub.department === 'Ban điều dưỡng');
  let prevStatus = 'submitted_l1';
  let prevLabel = WORKFLOW_STAGES.submitted_l1.label;
  
  if (isBanDDSub) {
    if (sub.status === 'approved') {
      prevStatus = 'submitted_l3';
      prevLabel = 'Chờ Ban Lãnh Đạo Phê Duyệt (Cấp 2)';
    } else {
      prevStatus = 'submitted_l1';
      prevLabel = 'Chờ Trưởng Ban ĐD Duyệt (Cấp 1)';
    }
  } else {
    if (sub.status === 'submitted_l3') {
      prevStatus = 'submitted_l2';
      prevLabel = WORKFLOW_STAGES.submitted_l2.label;
    } else if (sub.status === 'submitted_l2') {
      prevStatus = 'submitted_l1';
      prevLabel = WORKFLOW_STAGES.submitted_l1.label;
    }
  }
  
  openConfirmModal({
    title: 'Hủy / Thu Hồi Phê Duyệt',
    icon: '↩️',
    message: `Bạn có chắc chắn muốn hủy kết quả phê duyệt hồ sơ của <strong>${sub.fullName}</strong> để xem xét và đánh giá lại?`,
    btnText: 'Xác Nhận Hủy Duyệt',
    btnClass: 'bg-amber-600 hover:bg-amber-700',
    onConfirm: () => {
      sub.status = prevStatus;
      sub.statusLabel = prevLabel;
      sub.history.push({
        step: 'Hủy Phê Duyệt (Rollback)',
        actor: `${user.fullName} (${user.roleName})`,
        date: new Date().toLocaleString('vi-VN'),
        comment: 'Đã thu hồi kết quả duyệt để thẩm định lại',
        action: 'rollback'
      });
      saveStorage();
      renderApprovalsTab();
      showToast(`Đã gỡ phê duyệt của hồ sơ ${sub.fullName} để đánh giá lại!`, 'warning');
    }
  });
}

