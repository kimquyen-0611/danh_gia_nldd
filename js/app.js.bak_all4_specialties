function renderAssessmentSubmissionSection(user, sub, allDomains) {
  let footerCard = document.getElementById('assessment-submission-footer-card');
  const domainsContainer = document.getElementById('assessment-domains-container');
  if (!footerCard && domainsContainer && domainsContainer.parentNode) {
    footerCard = document.createElement('div');
    footerCard.id = 'assessment-submission-footer-card';
    footerCard.className = 'mt-8 mb-12';
    domainsContainer.parentNode.appendChild(footerCard);
  }
  if (!footerCard) return;

  const isLocked = ['submitted_l1', 'submitted_l2', 'submitted_l3', 'approved'].includes(sub.status);
  const stage = (typeof WORKFLOW_STAGES !== 'undefined' && WORKFLOW_STAGES[sub.status]) ? WORKFLOW_STAGES[sub.status] : { label: 'Bản Nháp' };
  
  // 1. Thống kê số lượng tiêu chí
  let totalCritCount = 0;
  let scoredCritCount = 0;
  (allDomains || []).forEach(d => {
    (d.standards || []).forEach(s => {
      (s.criteria || []).forEach(c => {
        totalCritCount++;
        if ((APP_STATE.currentAssessmentScores && APP_STATE.currentAssessmentScores[c.id] || 0) > 0) {
          scoredCritCount++;
        }
      });
    });
  });

  const completionPct = totalCritCount > 0 ? Math.round((scoredCritCount / totalCritCount) * 100) : 0;
  const totalScore = sub.totalScore || 0;
  const scorePct = Math.min(100, Math.round((totalScore / 1000) * 100));
  const calculatedTier = sub.evaluatedTier || 1;
  const tierObj = (typeof COMPETENCY_TIERS_MATRIX !== 'undefined') 
    ? (COMPETENCY_TIERS_MATRIX.find(t => t.tier === calculatedTier) || COMPETENCY_TIERS_MATRIX[0]) 
    : { code: `Bậc ${calculatedTier}`, name: 'Điều dưỡng', title: '' };
  
  // 2. Thống kê minh chứng đính kèm
  const evidences = APP_STATE.currentCriterionEvidences || {};
  let totalEvidenceFiles = 0;
  let critWithEvidenceCount = 0;
  Object.keys(evidences).forEach(k => {
    const list = evidences[k];
    if (Array.isArray(list) && list.length > 0) {
      totalEvidenceFiles += list.length;
      critWithEvidenceCount++;
    }
  });

  // 3. Thông tin lịch sử nộp gần nhất (nếu có)
  const lastSubmitAction = (sub.history || []).slice().reverse().find(h => h && (h.action === 'submit' || (typeof h.step === 'string' && h.step.includes('Nộp'))));
