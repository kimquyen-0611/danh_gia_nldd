// Khóa / Mở khóa tài khoản nhân viên
function toggleUserStatus(userId) {
  if (typeof checkAdminPermission === 'function' && !checkAdminPermission()) return;
  const user = (APP_STATE.users || []).find(u => u.id === userId);
  if (!user) return;

  const isCurrentlyActive = user.status !== 'inactive';
  user.status = isCurrentlyActive ? 'inactive' : 'active';
  saveStorage();
  renderAdminEmployees();
  showToast(
    isCurrentlyActive 
      ? `Đã tạm khóa tài khoản của ${user.fullName}` 
      : `Đã kích hoạt lại tài khoản của ${user.fullName}`, 
    'info'
  );
}

// Xác nhận xóa nhân viên
function confirmDeleteUser(userId) {
  if (typeof checkAdminPermission === 'function' && !checkAdminPermission()) return;
  const user = (APP_STATE.users || []).find(u => u.id === userId);
  if (!user) return;

  openConfirmModal({
    title: 'Xóa Tài Khoản Nhân Sự',
    icon: '🗑️',
    message: `Bạn có chắc chắn muốn xóa nhân viên <strong>${user.fullName}</strong> (MSNV: <strong>${user.msnv}</strong>)? Toàn bộ dữ liệu tự đánh giá của nhân sự này cũng sẽ được gỡ bỏ khỏi hệ thống.`,
    btnText: 'Xác Nhận Xóa',
    btnClass: 'bg-rose-600 hover:bg-rose-700',
    onConfirm: () => {
      APP_STATE.users = (APP_STATE.users || []).filter(u => u.id !== userId);
      if (APP_STATE.submissions && APP_STATE.submissions[userId]) {
        delete APP_STATE.submissions[userId];
      }
      saveStorage();
      renderAdminTab();
      showToast(`Đã xóa nhân sự ${user.fullName} khỏi hệ thống`, 'success');
    }
  });
}

