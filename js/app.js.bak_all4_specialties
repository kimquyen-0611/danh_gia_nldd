                <!-- Mô tả & Hướng dẫn viết dài theo hàng ngang, hết hàng mới xuống hàng -->
                ${crit.desc ? `
                  <p class="text-xs text-slate-600 mt-1.5 font-medium leading-relaxed">
                    💡 ${crit.desc}
