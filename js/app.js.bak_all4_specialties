function _legacyRenderApprovalsTab() {
  const container = document.getElementById('approval-submissions-table-body');
  if (!container) return;
  
  const user = APP_STATE.currentUser;
  const filter = APP_STATE.filterApprovalStatus || 'all';
  
  // Row-Level Security: Lọc danh sách theo vai trò phân quyền
  let list = APP_STATE.submissions;
  if (user) {
    if (user.role === 'head_nurse') {
      list = list.filter(s => s.department === user.department || s.userId === user.id);
    } else if (user.role === 'nurse') {
      list = list.filter(s => s.userId === user.id);
    }
  }

  // Lọc theo trạng thái
  if (filter !== 'all') {
    list = list.filter(s => s.status === filter);
  }

  // Lọc theo từ khóa tìm kiếm (nếu có)
  if (APP_STATE.approvalSearchQuery) {
    const q = APP_STATE.approvalSearchQuery.toLowerCase().trim();
    list = list.filter(s => 
      (s.fullName && s.fullName.toLowerCase().includes(q)) ||
      (s.msnv && s.msnv.toLowerCase().includes(q)) ||
      (s.department && s.department.toLowerCase().includes(q))
    );
  }
  
  if (list.length === 0) {
    container.innerHTML = `
      <tr>
        <td colspan="7" class="py-8 text-center text-slate-400 text-xs">
          Không có hồ sơ nào trong trạng thái này thuộc phạm vi quản lý của bạn.
        </td>
      </tr>
    `;
    updateApprovalCounters();
    return;
  }
  
  let html = '';
  list.forEach((sub, idx) => {
    const stage = WORKFLOW_STAGES[sub.status] || WORKFLOW_STAGES.draft;
    const tierObj = COMPETENCY_TIERS_MATRIX.find(t => t.tier === sub.evaluatedTier) || COMPETENCY_TIERS_MATRIX[0];
    const subUser = APP_STATE.users.find(u => u.id === sub.userId);
    const avatarUrl = subUser ? subUser.avatar : 'https://images.unsplash.com/photo-1594824813627-2c13702a4bf7?w=150';
    
    html += `
      <tr class="border-b border-slate-100 hover:bg-slate-50/80 transition-all text-xs">
        <td class="py-2.5 px-3 text-center font-bold text-slate-400">${idx + 1}</td>
        
        <td class="py-2.5 px-4">
          <div class="flex items-center gap-2.5">
            <img src="${avatarUrl}" alt="Avatar" class="w-7 h-7 rounded-full object-cover border border-blue-200">
            <div>
              <span class="font-bold text-slate-800 block text-xs leading-tight">${sub.fullName}</span>
              <span class="text-slate-400 text-[10px]">MSNV: ${sub.msnv}</span>
            </div>
          </div>
        </td>
        
        <td class="py-2.5 px-3">
          <span class="text-slate-700 font-medium text-xs block">${sub.department}</span>
          <span class="text-[10px] text-slate-400">${sub.specialty === 'lamsang' ? 'Lâm sàng' : 'Điều dưỡng'}</span>
        </td>

        <td class="py-2.5 px-3">
          <span class="font-black text-blue-700 text-xs sm:text-sm">${sub.totalScore || 0}</span>
          <span class="text-slate-400 text-[10px]">/ 1000đ</span>
        </td>
        
        <td class="py-2.5 px-3">
          <span class="level-badge level-${sub.evaluatedTier || 1} text-[10px] py-0.5 px-2">${tierObj.code}</span>
        </td>
        
        <td class="py-2.5 px-3">
          <span class="px-2 py-0.5 rounded-full font-bold text-[10px] border ${stage.badgeClass}">
            ${stage.icon} ${stage.label}
          </span>
        </td>
        
        <td class="py-2.5 px-4 text-right">
          <div class="inline-flex items-center gap-1 flex-wrap justify-end">
            <button onclick="openReviewModal('${sub.id}')" class="px-2 py-1 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold border border-blue-200 transition-all text-xs" title="Xem chi tiết & Thẩm định">
              👁️ Xem
            </button>
            ${renderApproverActionButtons(sub)}
          </div>
        </td>
      </tr>
    `;
  });
  
  container.innerHTML = html;
  updateApprovalCounters();
}

function renderApproverActionButtons(sub) {
  const user = APP_STATE.currentUser;
  if (!user) return '';
  let buttons = '';
  const isBanDDSub = (sub.department === 'Ban điều dưỡng');
  
  // Duyệt Cấp 1:
  // - Nếu là Ban Điều Dưỡng: Trưởng Ban Điều Dưỡng ('nurse_board', 'chief_nurse') hoặc Quản trị hệ thống duyệt
  // - Nếu là các khoa khác: ĐD Trưởng Khoa ('head_nurse') hoặc Quản trị hệ thống duyệt
  if (sub.status === 'submitted_l1') {
    if (isBanDDSub) {
      if (['nurse_board', 'chief_nurse', 'admin'].includes(user.role)) {
        buttons += `
          <button onclick="directApproveSubmission('${sub.id}', 1)" class="px-2 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold transition-all shadow-xs text-xs" title="Ký duyệt Cấp 1 (Trưởng Ban Điều Dưỡng)">
            ✓ Duyệt Cấp 1 (Trưởng Ban ĐD)
          </button>
        `;
      }
    } else {
      if (['head_nurse', 'admin'].includes(user.role)) {
        buttons += `
          <button onclick="directApproveSubmission('${sub.id}', 1)" class="px-2 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold transition-all shadow-xs text-xs" title="Ký duyệt Cấp 1 (ĐD Trưởng Khoa)">
            ✓ Duyệt Cấp 1
          </button>
        `;
      }
    }
  }
  
  // Duyệt Cấp 2:
  // - Chỉ áp dụng cho các khoa thông thường (đã qua Cấp 1): Trưởng Ban Điều Dưỡng duyệt
  // (Nhân viên Ban Điều Dưỡng đã được Trưởng Ban ĐD duyệt Cấp 1, chuyển thẳng lên Cấp 2 là Ban Lãnh Đạo ở submitted_l3)
  if (sub.status === 'submitted_l2' && ['nurse_board', 'chief_nurse', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="directApproveSubmission('${sub.id}', 2)" class="px-2 py-1 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold transition-all shadow-xs text-xs" title="Ký duyệt Cấp 2 (Ban ĐD)">
        ✓ Duyệt Cấp 2
      </button>
    `;
  }
  
  // Phê Duyệt Cấp 3 (hoặc Cấp 2 đối với Ban Điều Dưỡng): Trưởng Cơ sở 2 / Ban Lãnh Đạo / Quản trị hệ thống
  if (sub.status === 'submitted_l3' && ['director', 'admin'].includes(user.role)) {
    if (isBanDDSub) {
      buttons += `
        <button onclick="directApproveSubmission('${sub.id}', 3)" class="px-2 py-1 rounded-lg bg-purple-600 hover:bg-purple-700 text-white font-bold transition-all shadow-xs text-xs" title="Phê duyệt Cấp 2 (Ban Lãnh Đạo / Ban Lãnh Đạo)">
          🎖️ Phê Duyệt Cấp 2 (Ban Lãnh Đạo)
        </button>
      `;
    } else {
      buttons += `
        <button onclick="directApproveSubmission('${sub.id}', 3)" class="px-2 py-1 rounded-lg bg-purple-600 hover:bg-purple-700 text-white font-bold transition-all shadow-xs text-xs" title="Phê duyệt Cấp 3 (Ban Lãnh Đạo / Ban Lãnh Đạo)">
          🎖️ Phê Duyệt Cấp 3
        </button>
      `;
    }
  }
  
  // Hủy Duyệt
  if (['submitted_l2', 'submitted_l3', 'approved'].includes(sub.status) && ['head_nurse', 'nurse_board', 'chief_nurse', 'director', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="promptRollbackApproval('${sub.id}')" class="px-2 py-1 rounded-lg bg-amber-50 text-amber-800 hover:bg-amber-100 font-bold border border-amber-200 transition-all text-xs" title="Hủy duyệt nhầm">
        ↩️ Hủy
      </button>
    `;
  }
  
  // Trả Về (Bất kỳ cấp nào có quyền duyệt đều có thể trả về kèm lý do)
  if (['submitted_l1', 'submitted_l2', 'submitted_l3'].includes(sub.status) && ['head_nurse', 'nurse_board', 'chief_nurse', 'director', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="promptReturnSubmission('${sub.id}')" class="px-2 py-1 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold border border-rose-200 transition-all text-xs" title="Trả về yêu cầu bổ sung">
        🔁 Trả Về
      </button>
    `;
  }
  
  // Xóa hồ sơ
  if (['admin'].includes(user.role)) {
    buttons += `
      <button onclick="promptDeleteSubmission('${sub.id}')" class="px-2 py-1 rounded-lg bg-slate-100 text-slate-600 hover:bg-rose-600 hover:text-white font-bold transition-all text-xs" title="Xóa hồ sơ">
        🗑️
      </button>
    `;
  }
  
  return buttons;
}

function updateApprovalCounters() {
  const user = APP_STATE.currentUser;
  let subs = APP_STATE.submissions || [];
  if (user) {
    if (user.role === 'head_nurse') {
      subs = subs.filter(s => s.department === user.department || s.userId === user.id);
    } else if (user.role === 'nurse') {
      subs = subs.filter(s => s.userId === user.id);
    }
  }
  const cAll = subs.length;
  const cL1 = subs.filter(s => s.status === 'submitted_l1').length;
  const cL2 = subs.filter(s => s.status === 'submitted_l2').length;
  const cL3 = subs.filter(s => s.status === 'submitted_l3').length;
  const cApp = subs.filter(s => s.status === 'approved').length;
  const cRet = subs.filter(s => s.status === 'returned').length;
  
  const elAll = document.getElementById('filter-count-all'); if (elAll) elAll.textContent = cAll;
  
  // Đối với Trưởng Ban Điều Dưỡng: đếm số hồ sơ Ban ĐD đang chờ Duyệt Cấp 1
  if (user && ['nurse_board', 'chief_nurse'].includes(user.role)) {
    const banddL1Count = subs.filter(s => s.department === 'Ban điều dưỡng' && s.status === 'submitted_l1').length;
    const elL1 = document.getElementById('badge-count-l1'); if (elL1) elL1.textContent = banddL1Count;
  } else {
    const elL1 = document.getElementById('badge-count-l1'); if (elL1) elL1.textContent = cL1;
  }
  
  const elL2 = document.getElementById('badge-count-l2'); if (elL2) elL2.textContent = cL2;
  const elL3 = document.getElementById('badge-count-l3'); if (elL3) elL3.textContent = cL3;
  const elApp = document.getElementById('badge-count-approved'); if (elApp) elApp.textContent = cApp;
  const elRet = document.getElementById('badge-count-returned'); if (elRet) elRet.textContent = cRet;

  // Cập nhật huy hiệu số lượng hồ sơ chờ duyệt trên thanh Menu điều hướng
  const navBadge = document.getElementById('nav-approval-badge');
  if (navBadge && user) {
    let pendingCount = 0;
    if (user.role === 'head_nurse') {
      pendingCount = cL1;
    } else if (user.role === 'nurse_board' || user.role === 'chief_nurse') {
      // Ban ĐD duyệt Cấp 2 toàn viện + Cấp 1 cho Ban Điều Dưỡng
      const banddL1 = subs.filter(s => s.department === 'Ban điều dưỡng' && s.status === 'submitted_l1').length;
      pendingCount = cL2 + banddL1;
    } else if (user.role === 'director') {
      pendingCount = cL3;
    } else if (user.role === 'admin') {
      pendingCount = cL1 + cL2 + cL3;
    } else {
      pendingCount = subs.filter(s => ['submitted_l1', 'submitted_l2', 'submitted_l3'].includes(s.status)).length;
    }
    
    if (pendingCount > 0) {
      navBadge.textContent = pendingCount;
      navBadge.classList.remove('hidden');
    } else {
      navBadge.classList.add('hidden');
    }
  }
}

