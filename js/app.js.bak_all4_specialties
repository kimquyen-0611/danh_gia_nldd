  user.lastSkillExamScore = parseInt(document.getElementById('modal-field-lastSkillExamScore').value) || 90;
  user.nckh = document.getElementById('modal-field-nckh').value.trim();
  user.evaluationYear = 2026;

  user.department = newDept;

  const found = DEPARTMENT_CONFIG.find(d => d.dept === newDept);
