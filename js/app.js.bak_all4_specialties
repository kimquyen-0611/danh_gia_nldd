// Chế Độ 2: THẺ CHI TIẾT (Cards) HOẶC THU GỌN (Compact)
function renderAssessmentCardsOrCompact(displayDomains, isLocked, viewMode, searchQuery, statusFilter, user, sub) {
  const container = document.getElementById('assessment-domains-container');
  if (!container) return;

  let html = '';
  let visibleCriteriaTotal = 0;

  displayDomains.forEach((domain, dIdx) => {
    let dScore = 0;
    let totalCritCount = 0;
    let scoredCritCount = 0;
    
    const filteredStandards = [];
    (domain.standards || []).forEach(std => {
      const filteredCriteria = (std.criteria || []).filter(crit => {
        totalCritCount++;
        const val = APP_STATE.currentAssessmentScores[crit.id] || 0;
        dScore += val;
        if (val > 0) scoredCritCount++;
        
        if (statusFilter === 'unscored' && val > 0) return false;
        if (statusFilter === 'scored' && val === 0) return false;
        
        if (searchQuery) {
          const matchTitle = (crit.title || '').toLowerCase().includes(searchQuery);
          const matchDesc = (crit.desc || '').toLowerCase().includes(searchQuery);
          const matchStd = (crit.standard || '').toLowerCase().includes(searchQuery);
          const matchOpts = (crit.options || []).some(o => (o.text || '').toLowerCase().includes(searchQuery));
          const matchNum = `tc ${crit.num}`.toLowerCase().includes(searchQuery) || `${crit.num}` === searchQuery;
          return matchTitle || matchDesc || matchStd || matchOpts || matchNum;
        }
        return true;
      });

      if (filteredCriteria.length > 0) {
        visibleCriteriaTotal += filteredCriteria.length;
        filteredStandards.push({
          ...std,
          criteria: filteredCriteria
        });
      }
    });

    if (filteredStandards.length === 0 && (searchQuery || statusFilter !== 'all')) {
      return;
