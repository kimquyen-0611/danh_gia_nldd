function directApproveSubmission(subId, level) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  const user = APP_STATE.currentUser;
  if (!sub || !user) return;
  
  const isBanDDSub = (sub.department === 'Ban điều dưỡng');
  let nextStatus = 'approved';
  let nextLabel = WORKFLOW_STAGES.approved.label;
  let actionText = isBanDDSub ? 'Phê duyệt chính thức Cấp 2 (Ban Lãnh Đạo)' : 'Phê duyệt chính thức Cấp 3 (Ban Lãnh Đạo)';
  
  if (level === 1) {
    if (isBanDDSub) {
      // Đối với Ban Điều Dưỡng: Trưởng Ban ĐD duyệt Cấp 1 -> chuyển thẳng lên Ban Lãnh Đạo (submitted_l3 - Cấp 2)
      nextStatus = 'submitted_l3';
      nextLabel = 'Chờ Ban Lãnh Đạo Phê Duyệt (Cấp 2)';
      actionText = 'Ký duyệt Cấp 1 (Trưởng Ban Điều Dưỡng)';
    } else {
      nextStatus = 'submitted_l2';
      nextLabel = WORKFLOW_STAGES.submitted_l2.label;
      actionText = 'Ký duyệt Cấp 1 (Điều Dưỡng Trưởng Khoa)';
    }
  } else if (level === 2) {
    nextStatus = 'submitted_l3';
    nextLabel = WORKFLOW_STAGES.submitted_l3.label;
    actionText = 'Ký duyệt Cấp 2 (Trưởng Ban Điều Dưỡng)';
  }
  
  const targetStepNotice = (isBanDDSub && level === 1)
    ? 'chuyển lên <strong>Ban Lãnh Đạo (Cấp 2)</strong> phê duyệt'
    : 'lên bước tiếp theo';
  
  openConfirmModal({
    title: `Xác Nhận ${actionText}`,
    icon: '✍️',
    message: `Bạn có chắc chắn muốn ký duyệt hồ sơ đánh giá năng lực của <strong>${sub.fullName}</strong> (${sub.msnv}) ${targetStepNotice}?`,
    btnText: 'Xác Nhận Ký Duyệt',
    btnClass: 'bg-emerald-600 hover:bg-emerald-700',
    onConfirm: () => {
      sub.status = nextStatus;
      sub.statusLabel = nextLabel;
      sub.history.push({
        step: actionText,
        actor: `${user.fullName} (${user.roleName})`,
