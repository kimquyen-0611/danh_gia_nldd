// Xuất Bảng Ma Trận Theo Dõi Tất Cả Tiêu Chí Ra Excel
function exportCriteriaDashboardToExcel() {
  const f = APP_STATE.dashboardFilters || {};
  const specialty = f.specialty === 'all' ? 'lamsang' : f.specialty;
  const domainList = DOMAINS_BY_SPECIALTY[specialty] || DOMAINS_BY_SPECIALTY['lamsang'] || [];
  const filteredUsers = getFilteredUsersForDashboard();
  const totalUsers = filteredUsers.length || 1;

  let csvContent = '\uFEFF'; // UTF-8 BOM để Microsoft Excel đọc chuẩn tiếng Việt
  csvContent += 'BẢNG THEO DÕI TOÀN BỘ TIÊU CHÍ ĐÁNH GIÁ NĂNG LỰC ĐIỀU DƯỠNG UMC\n';
  csvContent += `Thời điểm xuất: ${new Date().toLocaleString('vi-VN')}\n`;
  csvContent += `Khối chuyên môn: ${specialty.toUpperCase()} - Số lượng nhân sự theo dõi: ${totalUsers} người\n\n`;

  csvContent += 'STT,Mã Tiêu Chí,Lĩnh Vực,Tiêu Chuẩn,Tên Tiêu Chí,Điểm Tối Đa,Số Lượng Đạt (Người),Tỷ Lệ Đạt (%),Đạt Điểm Tối Đa (Người),Chưa Đạt (Người),Điểm Trung Bình,Đánh Giá Tuân Thủ\n';

  let count = 0;
  domainList.forEach(domain => {
    (domain.standards || []).forEach(standard => {
      (standard.criteria || []).forEach(criterion => {
        count++;
        let passedCount = 0;
        let maxScoreCount = 0;
        let notPassedCount = 0;
        let totalScoreSum = 0;

        filteredUsers.forEach(u => {
          const score = getEffectiveCriterionScore(u.id, criterion);
          totalScoreSum += score;
          if (score > 0) passedCount++;
          if (score >= criterion.maxScore) maxScoreCount++;
          if (score === 0) notPassedCount++;
        });

        const passRate = Math.round((passedCount / totalUsers) * 100);
        const avgScore = (totalScoreSum / totalUsers).toFixed(1);
        let evalText = passRate >= 80 ? 'Đạt Chuẩn Cao' : (passRate >= 50 ? 'Đạt Yêu Cầu' : 'Cần Bồi Dưỡng');

        const cleanDomain = `"${(domain.name || '').replace(/"/g, '""')}"`;
        const cleanStd = `"${(standard.title || '').replace(/"/g, '""').replace(/\n/g, ' - ')}"`;
        const cleanCrit = `"${(criterion.title || '').replace(/"/g, '""')}"`;

        csvContent += `${count},${criterion.id},${cleanDomain},${cleanStd},${cleanCrit},${criterion.maxScore},${passedCount},${passRate}%,${maxScoreCount},${notPassedCount},${avgScore},${evalText}\n`;
      });
    });
  });

  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.setAttribute('download', `Bang_Theo_Doi_Tieu_Chi_NLDD_UMC_${Date.now()}.csv`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);

  showToast('Đã xuất thành công bảng theo dõi tất cả tiêu chí ra file Excel (CSV UTF-8 chuẩn)!', 'success');
}

// Xuất Bảng Xếp Bậc & Điểm Số Nhân Sự Ra Excel
function exportStaffRankingToExcel() {
  const filteredUsers = getFilteredUsersForDashboard();
  const specialty = APP_STATE.dashboardFilters.specialty === 'all' ? 'lamsang' : APP_STATE.dashboardFilters.specialty;
  const domainList = DOMAINS_BY_SPECIALTY[specialty] || DOMAINS_BY_SPECIALTY['lamsang'] || [];

  let totalCrit = 0;
  domainList.forEach(d => {
    (d.standards || []).forEach(st => {
      totalCrit += (st.criteria || []).length;
    });
  });

  let csvContent = '\uFEFF';
  csvContent += 'BẢNG XẾP BẬC NĂNG LỰC NHÂN SỰ ĐIỀU DƯỠNG UMC\n';
  csvContent += `Thời điểm xuất: ${new Date().toLocaleString('vi-VN')}\n`;
  csvContent += `Tổng số nhân sự: ${filteredUsers.length} người\n\n`;

  csvContent += 'Hạng,MSNV,Họ Và Tên,Khoa Phòng,Chức Danh,Lĩnh Vực I (Bằng cấp),Lĩnh Vực II (Chuyên môn),Lĩnh Vực III (NCKH),Lĩnh Vực IV (Quản lý),Lĩnh Vực V (Phát triển),Tổng Điểm (/1000đ),Tiêu Chí Hoàn Thành,Tỷ Lệ Hoàn Thành (%),Bậc Năng Lực Xếp Hạng,Trạng Thái Phê Duyệt\n';

  const rankedUsers = filteredUsers.map(user => {
    const sub = getUserSubmission(user.id);
    const totalScore = (sub && sub.totalScore) ? sub.totalScore : 0;
    const evaluatedTier = (sub && sub.evaluatedTier) ? sub.evaluatedTier : (user.level || 1);

    let dScores = { d1: 0, d2: 0, d3: 0, d4: 0, d5: 0 };
    if (sub && sub.domainScores) {
      dScores.d1 = sub.domainScores.lamsang_d1 || sub.domainScores.d1 || 0;
      dScores.d2 = sub.domainScores.lamsang_d2 || sub.domainScores.d2 || 0;
      dScores.d3 = sub.domainScores.lamsang_d3 || sub.domainScores.d3 || 0;
      dScores.d4 = sub.domainScores.lamsang_d4 || sub.domainScores.d4 || 0;
      dScores.d5 = sub.domainScores.lamsang_d5 || sub.domainScores.d5 || 0;
    }

    let passedCriteriaCount = 0;
    domainList.forEach(d => {
      (d.standards || []).forEach(st => {
        (st.criteria || []).forEach(cr => {
          const sc = getEffectiveCriterionScore(user.id, cr, sub);
          if (sc > 0) passedCriteriaCount++;
        });
      });
    });

    const completionRate = totalCrit > 0 ? Math.round((passedCriteriaCount / totalCrit) * 100) : 0;
    const statusLabel = sub ? sub.statusLabel : 'Bản nháp (Chưa nộp)';

    return { user, totalScore, evaluatedTier, dScores, passedCriteriaCount, completionRate, statusLabel };
  });

  rankedUsers.sort((a, b) => b.totalScore - a.totalScore);

  rankedUsers.forEach((item, idx) => {
    const u = item.user;
    const cleanName = `"${(u.fullName || '').replace(/"/g, '""')}"`;
    const cleanDept = `"${(u.department || 'Khoa Chấn thương Chỉnh hình').replace(/"/g, '""')}"`;
    const cleanRole = `"${(u.roleName || '').replace(/"/g, '""')}"`;
    const cleanStatus = `"${(item.statusLabel || '').replace(/"/g, '""')}"`;

    csvContent += `${idx + 1},${u.msnv || ''},${cleanName},${cleanDept},${cleanRole},${item.dScores.d1},${item.dScores.d2},${item.dScores.d3},${item.dScores.d4},${item.dScores.d5},${item.totalScore},${item.passedCriteriaCount}/${totalCrit},${item.completionRate}%,Bậc ${item.evaluatedTier},${cleanStatus}\n`;
  });

  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.setAttribute('download', `Bang_Xep_Bac_Nhan_Su_NLDD_UMC_${Date.now()}.csv`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);

  showToast('Đã xuất thành công bảng xếp bậc nhân sự ra file Excel (CSV UTF-8 chuẩn)!', 'success');
}

