// Nộp hồ sơ tự đánh giá với phân luồng theo cấp bậc
function submitAssessmentForm() {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  
  const isChiefNurse = (user.role === 'nurse_board' || user.role === 'chief_nurse');
  const isHeadNurse = (user.role === 'head_nurse');
  const isBanDDStaff = (user.department === 'Ban điều dưỡng' && !isChiefNurse);

  if (isChiefNurse) {
    // 1. Trưởng Ban Điều Dưỡng: Nộp thẳng lên Ban Lãnh Đạo (Cấp 3) phê duyệt
    openConfirmModal({
      title: 'Nộp Hồ Sơ Đánh Giá Lên Ban Lãnh Đạo (Cấp 3)',
      icon: '🏛️',
      message: `Đồng chí <strong>${user.fullName}</strong> xác nhận nộp hồ sơ tự đánh giá chức danh Quản lý/Chuyên gia (Tổng điểm: <strong>${sub.totalScore}đ</strong> - Dự kiến <strong>Bậc ${sub.evaluatedTier}</strong>) trực tiếp lên <strong>Trưởng Cơ sở 2 / Ban Lãnh Đạo</strong> phê duyệt chính thức?`,
      btnText: 'Xác Nhận Nộp Lên Ban Lãnh Đạo',
      btnClass: 'bg-purple-700 hover:bg-purple-800',
      onConfirm: () => {
        sub.status = 'submitted_l3';
        sub.statusLabel = 'Chờ Ban Lãnh Đạo Phê Duyệt (Cấp 3)';
        sub.history.push({
          step: 'Nộp Duyệt Ban Lãnh Đạo (Cấp 3)',
          actor: user.fullName,
          date: new Date().toLocaleString('vi-VN'),
          comment: 'Trưởng Ban Điều Dưỡng hoàn tất tự đánh giá và nộp hồ sơ lên Ban Lãnh Đạo phê duyệt trực tiếp',
          action: 'submit'
        });
        saveStorage();
        renderAssessmentTab();
        if (typeof confetti === 'function') confetti({ particleCount: 80, spread: 60 });
        showToast('🎉 Đã nộp hồ sơ đánh giá lên Ban Lãnh Đạo (Trưởng Cơ sở 2) phê duyệt Cấp 3!', 'success');
      }
    });
  } else if (isBanDDStaff) {
    // 2. Nhân viên Ban Điều Dưỡng: Duyệt Cấp 1 là Trưởng Ban Điều Dưỡng, Cấp 2 là Ban Lãnh Đạo
    openConfirmModal({
      title: 'Nộp Hồ Sơ Đánh Giá Lên Trưởng Ban Điều Dưỡng (Cấp 1)',
      icon: '📋',
      message: `Bạn có chắc chắn muốn nộp hồ sơ tự đánh giá năm 2026 (Tổng điểm: <strong>${sub.totalScore}đ</strong> - Dự kiến <strong>Bậc ${sub.evaluatedTier}</strong>) lên <strong>Trưởng Ban Điều Dưỡng</strong> phê duyệt Cấp 1?`,
      btnText: 'Xác Nhận Nộp Trưởng Ban ĐD',
      btnClass: 'bg-indigo-700 hover:bg-indigo-800',
      onConfirm: () => {
        sub.status = 'submitted_l1';
        sub.statusLabel = 'Chờ Trưởng Ban ĐD Duyệt (Cấp 1)';
        sub.history.push({
          step: 'Nộp Duyệt Cấp 1 (Trưởng Ban ĐD)',
          actor: user.fullName,
          date: new Date().toLocaleString('vi-VN'),
          comment: 'Nhân viên Ban Điều Dưỡng hoàn tất tự đánh giá và nộp hồ sơ lên Trưởng Ban Điều Dưỡng phê duyệt Cấp 1',
          action: 'submit'
        });
        saveStorage();
        renderAssessmentTab();
        if (typeof confetti === 'function') confetti({ particleCount: 80, spread: 60 });
        showToast('🎉 Đã nộp hồ sơ đánh giá lên Trưởng Ban Điều Dưỡng phê duyệt Cấp 1!', 'success');
      }
    });
  } else if (isHeadNurse) {
    // 3. Điều Dưỡng Trưởng Khoa: Nộp lên Trưởng Ban Điều Dưỡng (Cấp 2)
    openConfirmModal({
      title: 'Nộp Hồ Sơ Lên Ban Điều Dưỡng (Cấp 2)',
      icon: '📋',
      message: `Đồng chí <strong>${user.fullName}</strong> xác nhận nộp hồ sơ tự đánh giá (Tổng điểm: <strong>${sub.totalScore}đ</strong> - Dự kiến <strong>Bậc ${sub.evaluatedTier}</strong>) lên <strong>Trưởng Ban Điều Dưỡng</strong> thẩm định Cấp 2?`,
      btnText: 'Xác Nhận Nộp Lên Ban ĐD',
      btnClass: 'bg-indigo-700 hover:bg-indigo-800',
      onConfirm: () => {
        sub.status = 'submitted_l2';
        sub.statusLabel = 'Chờ Ban Điều Dưỡng Duyệt (Cấp 2)';
        sub.history.push({
          step: 'Nộp Duyệt Ban Điều Dưỡng (Cấp 2)',
          actor: user.fullName,
          date: new Date().toLocaleString('vi-VN'),
          comment: 'Điều dưỡng Trưởng hoàn tất tự đánh giá và nộp hồ sơ lên Ban Điều Dưỡng thẩm định Cấp 2',
          action: 'submit'
        });
        saveStorage();
