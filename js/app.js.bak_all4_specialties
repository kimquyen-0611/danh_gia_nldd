// Lấy hồ sơ chi tiết của người dùng
function getUserDetailedPortfolio(userId) {
  if (!APP_STATE.userDetailedPortfolios) {
    try {
      APP_STATE.userDetailedPortfolios = JSON.parse(localStorage.getItem('umc_user_detailed_portfolios') || '{}');
    } catch(e) {
      APP_STATE.userDetailedPortfolios = {};
    }
  }

  // Dữ liệu tùy biến đã lưu
  const customData = APP_STATE.userDetailedPortfolios[userId];
  const defaultData = DEFAULT_PORTFOLIO_DATA[userId] || DEFAULT_PORTFOLIO_DATA['usr_ngan_ttm'];

  // Hợp nhất dữ liệu
  return {
    cchn: (customData && customData.cchn) || defaultData.cchn,
    cchnScope: (customData && customData.cchnScope) || defaultData.cchnScope,
    joinDate: (customData && customData.joinDate) || defaultData.joinDate,
    contractType: (customData && customData.contractType) || defaultData.contractType,
    strengths: (customData && customData.strengths) || defaultData.strengths,
    weaknesses: (customData && customData.weaknesses) || defaultData.weaknesses,
    shortTermGoals: (customData && customData.shortTermGoals) || defaultData.shortTermGoals,
    longTermGoals: (customData && customData.longTermGoals) || defaultData.longTermGoals,
    conferences: (customData && customData.conferences) || defaultData.conferences,
    socialActivities: (customData && customData.socialActivities) || defaultData.socialActivities
  };
}

// Lưu hồ sơ chi tiết vào localStorage
function saveUserDetailedPortfolio(userId, data) {
  if (!APP_STATE.userDetailedPortfolios) APP_STATE.userDetailedPortfolios = {};
  APP_STATE.userDetailedPortfolios[userId] = data;
  try {
    localStorage.setItem('umc_user_detailed_portfolios', JSON.stringify(APP_STATE.userDetailedPortfolios));
  } catch(e) {
    console.error('Lỗi khi lưu detailed portfolio:', e);
  }
}

