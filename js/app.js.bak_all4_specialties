    btnText: 'Xác Nhận Xóa',
    btnClass: 'bg-rose-600 hover:bg-rose-700',
    onConfirm: () => {
      const domains = DOMAINS_BY_SPECIALTY['lamsang'] || [];
      for (const d of domains) {
        for (const s of (d.standards || [])) {
          s.criteria = (s.criteria || []).filter(c => c.id !== critId);
        }
      }
      saveCriteriaStorage();
      renderAdminCriteria();
      renderAdminKpiStrip();
      if (typeof renderAssessmentTab === 'function') renderAssessmentTab();
      showToast(`Đã xóa tiêu chí [${critId}] khỏi khung năng lực`, 'success');
    }
  });
}

