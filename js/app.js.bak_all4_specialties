              </div>

              ${renderCriterionOptionsHtml(crit, isLocked, selectedScore, savedOptIdx)}
            </div>

            <!-- HÀNG THẨM ĐỊNH & MINH CHỨNG (Footer Bar) -->
            <div class="mt-3 pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs bg-slate-50/70 p-3 rounded-xl border border-slate-200/70">
