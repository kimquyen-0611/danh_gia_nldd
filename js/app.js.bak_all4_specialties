// Khởi tạo và Lưu trữ với cơ chế cập nhật phiên bản dữ liệu tự động
function initStorage() {
  const CURRENT_SYSTEM_VERSION = 'umc_v11_banlanhdao_notest';
  if (localStorage.getItem('umc_system_version') !== CURRENT_SYSTEM_VERSION) {
    localStorage.setItem('umc_users', JSON.stringify(INITIAL_USERS));
    localStorage.setItem('umc_submissions', JSON.stringify(INITIAL_SUBMISSIONS));
    localStorage.setItem('umc_system_version', CURRENT_SYSTEM_VERSION);
  } else {
    if (!localStorage.getItem('umc_users')) {
      localStorage.setItem('umc_users', JSON.stringify(INITIAL_USERS));
    }
    if (!localStorage.getItem('umc_submissions')) {
      localStorage.setItem('umc_submissions', JSON.stringify(INITIAL_SUBMISSIONS));
    }
  }
  APP_STATE.users = JSON.parse(localStorage.getItem('umc_users'));
  APP_STATE.submissions = JSON.parse(localStorage.getItem('umc_submissions'));

  // Kích hoạt đồng bộ Cloud ngầm
  if (typeof window !== 'undefined') {
    setTimeout(syncWithCloudOnStartup, 600);
  }
}

function saveStorage() {
  localStorage.setItem('umc_users', JSON.stringify(APP_STATE.users));
  localStorage.setItem('umc_submissions', JSON.stringify(APP_STATE.submissions));
  scheduleCloudSync();
}

