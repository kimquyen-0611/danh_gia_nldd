// Xử lý khi chọn điểm cho một tiêu chí (Hỗ trợ Click chọn & Click lại để BỎ CHỌN)
function onSelectCriterionScore(critId, score, optIdx) {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  const specialty = APP_STATE.selectedSpecialty || user.specialty || 'lamsang';
  const allDomains = DOMAINS_BY_SPECIALTY[specialty] || [];

  const currentScore = APP_STATE.currentAssessmentScores[critId];
  const currentOptIdx = APP_STATE.currentAssessmentOptionKeys ? APP_STATE.currentAssessmentOptionKeys[critId] : undefined;

  // TOGGLE BỎ CHỌN: Nếu nhấp lại chính mục đang được chọn -> Bỏ chọn (về 0đ)
  const isAlreadySelected = (currentOptIdx !== undefined && currentOptIdx === optIdx) ||
                            (currentOptIdx === undefined && currentScore === score && score > 0);

  if (isAlreadySelected) {
    onDeselectCriterion(critId);
    return;
  }

  // Tìm tiêu chuẩn chứa tiêu chí này
  let parentStandard = null;
  for (const d of allDomains) {
    for (const s of (d.standards || [])) {
      if ((s.criteria || []).some(c => c.id === critId)) {
        parentStandard = s;
        break;
      }
    }
    if (parentStandard) break;
  }

  // QUY TẮC BỆNH VIỆN: Nếu thuộc Tiêu chuẩn "Chọn 1 năng lực phù hợp nhất"
  if (parentStandard && SINGLE_CHOICE_STANDARDS.includes(parentStandard.id) && score > 0) {
    // Đặt lại điểm của các tiêu chí khác trong cùng tiêu chuẩn về 0
    (parentStandard.criteria || []).forEach(otherCrit => {
      if (otherCrit.id !== critId) {
        APP_STATE.currentAssessmentScores[otherCrit.id] = 0;
        if (APP_STATE.currentAssessmentOptionKeys) {
          delete APP_STATE.currentAssessmentOptionKeys[otherCrit.id];
        }
      }
    });
  }

  // Ghi nhận điểm cho tiêu chí được chọn
  APP_STATE.currentAssessmentScores[critId] = score;
  if (!APP_STATE.currentAssessmentOptionKeys) APP_STATE.currentAssessmentOptionKeys = {};
  if (optIdx !== undefined) {
    APP_STATE.currentAssessmentOptionKeys[critId] = optIdx;
  } else {
    delete APP_STATE.currentAssessmentOptionKeys[critId];
  }

  sub.scores = APP_STATE.currentAssessmentScores;
  sub.optionKeys = APP_STATE.currentAssessmentOptionKeys;
  calculateAndUpdateAssessmentSummary(sub);
  saveStorage();

  // Cập nhật giao diện trực tiếp
  renderAssessmentTab();
}

// Hàm Bỏ chọn tiêu chí chuyên dụng (đặt về 0 điểm)
function onDeselectCriterion(critId) {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);

  APP_STATE.currentAssessmentScores[critId] = 0;
  if (APP_STATE.currentAssessmentOptionKeys) {
    delete APP_STATE.currentAssessmentOptionKeys[critId];
  }

  sub.scores = APP_STATE.currentAssessmentScores;
  sub.optionKeys = APP_STATE.currentAssessmentOptionKeys;
  calculateAndUpdateAssessmentSummary(sub);
  saveStorage();

  renderAssessmentTab();
  showToast('Đã bỏ chọn tiêu chí (đặt về 0 điểm)', 'info');
}

// Thiết lập điểm của Quản lý trực tiếp (ĐD Trưởng)
function setAssessmentManagerScore(critId, val) {
  const score = parseInt(val, 10) || 0;
  if (!APP_STATE.managerAssessmentScores) APP_STATE.managerAssessmentScores = {};
  APP_STATE.managerAssessmentScores[critId] = score;
  
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  sub.managerScores = APP_STATE.managerAssessmentScores;
  saveStorage();
  calculateAndUpdateAssessmentSummary(sub);
  renderAssessmentSubmissionSection(user, sub, allDomains);
}


