function onAnalyticsNurseChanged() {
  const select = document.getElementById('analytics-nurse-select');
  if (!select) return;
  const uId = select.value;
  const user = APP_STATE.users.find(u => u.id === uId);
  if (!user) return;
  
  const titleEl = document.getElementById('analytics-nurse-title'); if (titleEl) titleEl.textContent = `${user.fullName} (${user.msnv})`;
  renderAnalyticsTab();
}

function renderHonorTab() {
  const container = document.getElementById('honor-cards-container');
