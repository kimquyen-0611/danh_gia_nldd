  if (e.key === 'Escape') {
    closeConfirmModal();
    closePreviewModal();
    closeReviewModal();
    closeEditProfileModal();
    closeCertificateModal();
    closeAddEvidenceModal();
    closeCreateAssessmentModal();
  }
});

