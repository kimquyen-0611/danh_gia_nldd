    'lamsang_c7': 'B?n scan Gi?y ch?ng nh?n CME t�ch luy',
    'lamsang_c8': 'B?n scan Ch?ng ch? h�nh ngh? KBCB c�n hi?u l?c',
    'lamsang_c9': 'Phi?u d�nh gi� k? thu?t chuy�n m�n di?u du?ng',
