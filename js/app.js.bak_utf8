function submitAssessmentForm() {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  
  openConfirmModal({
    title: 'G?i H? So ��nh Gi� Nang L?c L�n C?p 1',
    icon: '??',
    message: `B?n c� ch?c ch?n mu?n n?p h? so t? d�nh gi� nam 2026 (T?ng di?m: <strong>${sub.totalScore}d</strong> - D? ki?n <strong>B?c ${sub.evaluatedTier}</strong>) l�n <strong>�i?u Du?ng Tru?ng Khoa</strong> ph� duy?t?`,
    btnText: 'X�c Nh?n N?p H? So',
    btnClass: 'bg-blue-700 hover:bg-blue-800',
    onConfirm: () => {
      sub.status = 'submitted_l1';
      sub.statusLabel = WORKFLOW_STAGES.submitted_l1.label;
      sub.history.push({
        step: 'N?p Duy?t C?p 1',
        actor: user.fullName,
        date: new Date().toLocaleString('vi-VN'),
        comment: 'Ho�n t?t t? d�nh gi� v� n?p h? so l�n �i?u Du?ng Tru?ng Khoa',
        action: 'submit'
      });
      saveStorage();
      renderAssessmentTab();
      if (typeof confetti === 'function') confetti({ particleCount: 80, spread: 60 });
      showToast('?? �� n?p h? so d�nh gi� l�n �i?u du?ng Tru?ng Khoa ph� duy?t C?p 1!', 'success');
    }
  });
}

function unlockAssessmentForEditing() {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  sub.status = 'draft';
  sub.statusLabel = WORKFLOW_STAGES.draft.label;
  saveStorage();
  renderAssessmentTab();
