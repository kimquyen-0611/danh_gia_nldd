function renderAdminPermissionsMatrix() {
  const container = document.getElementById('admin-permissions-matrix-container');
  if (!container) return;
  
  const getBadge = (perm) => {
    if (!perm) return '<span class="text-slate-300">�</span>';
    if (perm.type === 'full') {
      return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-bold text-[10px]" title="${perm.text}">? ${perm.text}</span>`;
    }
    if (perm.type === 'view') {
      return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-100 text-blue-800 font-semibold text-[10px]" title="${perm.text}">??? ${perm.text}</span>`;
    }
    if (perm.type === 'partial') {
      return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-100 text-amber-800 font-semibold text-[10px]" title="${perm.text}">?? ${perm.text}</span>`;
    }
    return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 text-slate-400 text-[10px]" title="Kh�ng c� quy?n">? ${perm.text || 'Kh�ng'}</span>`;
  };

  container.innerHTML = `
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider">
          <tr>
            <th class="py-3 px-3 w-12 text-center">STT</th>
            <th class="py-3 px-4">Ch?c Nang H? Th?ng</th>
            <th class="py-3 px-3 text-center">�i?u Du?ng</th>
            <th class="py-3 px-3 text-center">QL Tr?c Ti?p (C?p 1)</th>
            <th class="py-3 px-3 text-center">QL Chung (C?p 2)</th>
            <th class="py-3 px-3 text-center">Ban L�nh �?o (C?p 3)</th>
            <th class="py-3 px-3 text-center">Qu?n Tr? HT</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-xs">
          ${SYSTEM_PERMISSIONS_MATRIX.map(row => `
            <tr class="hover:bg-blue-50/40 transition-colors">
              <td class="py-3 px-3 text-center font-bold text-slate-500">${row.id}</td>
              <td class="py-3 px-4 font-semibold text-slate-800">
                <div>${row.feature}</div>
                <span class="text-[10px] text-slate-400 font-normal uppercase">${row.category}</span>
              </td>
              <td class="py-3 px-3 text-center">${getBadge(row.nurse)}</td>
              <td class="py-3 px-3 text-center">${getBadge(row.head_nurse)}</td>
              <td class="py-3 px-3 text-center">${getBadge(row.nurse_board)}</td>
              <td class="py-3 px-3 text-center">${getBadge(row.director)}</td>
              <td class="py-3 px-3 text-center">${getBadge(row.admin)}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    </div>
  `;
}

