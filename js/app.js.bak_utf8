function renderApprovalsTab() {
  const container = document.getElementById('approval-submissions-table-body');
  if (!container) return;
  
  const user = APP_STATE.currentUser;
  const filter = APP_STATE.filterApprovalStatus || 'all';
  
  // Row-Level Security: L?c danh s�ch theo vai tr� ph�n quy?n
  let list = APP_STATE.submissions;
  if (user) {
    if (user.role === 'head_nurse') {
      list = list.filter(s => s.department === user.department || s.userId === user.id);
    } else if (user.role === 'nurse') {
      list = list.filter(s => s.userId === user.id);
    }
  }

  // L?c theo tr?ng th�i
  if (filter !== 'all') {
    list = list.filter(s => s.status === filter);
  }

  // L?c theo t? kh�a t�m ki?m (n?u c�)
  if (APP_STATE.approvalSearchQuery) {
    const q = APP_STATE.approvalSearchQuery.toLowerCase().trim();
    list = list.filter(s => 
      (s.fullName && s.fullName.toLowerCase().includes(q)) ||
      (s.msnv && s.msnv.toLowerCase().includes(q)) ||
      (s.department && s.department.toLowerCase().includes(q))
    );
  }
  
  if (list.length === 0) {
    container.innerHTML = `
      <tr>
        <td colspan="7" class="py-8 text-center text-slate-400 text-xs">
          Kh�ng c� h? so n�o trong tr?ng th�i n�y thu?c ph?m vi qu?n l� c?a b?n.
        </td>
      </tr>
    `;
    updateApprovalCounters();
    return;
  }
  
  let html = '';
  list.forEach((sub, idx) => {
    const stage = WORKFLOW_STAGES[sub.status] || WORKFLOW_STAGES.draft;
    const tierObj = COMPETENCY_TIERS_MATRIX.find(t => t.tier === sub.evaluatedTier) || COMPETENCY_TIERS_MATRIX[0];
    const subUser = APP_STATE.users.find(u => u.id === sub.userId);
    const avatarUrl = subUser ? subUser.avatar : 'https://images.unsplash.com/photo-1594824813627-2c13702a4bf7?w=150';
    
    html += `
      <tr class="border-b border-slate-100 hover:bg-slate-50/80 transition-all text-xs">
        <td class="py-2.5 px-3 text-center font-bold text-slate-400">${idx + 1}</td>
        
        <td class="py-2.5 px-4">
          <div class="flex items-center gap-2.5">
            <img src="${avatarUrl}" alt="Avatar" class="w-7 h-7 rounded-full object-cover border border-blue-200">
            <div>
              <span class="font-bold text-slate-800 block text-xs leading-tight">${sub.fullName}</span>
              <span class="text-slate-400 text-[10px]">MSNV: ${sub.msnv}</span>
            </div>
          </div>
        </td>
        
        <td class="py-2.5 px-3">
          <span class="text-slate-700 font-medium text-xs block">${sub.department}</span>
          <span class="text-[10px] text-slate-400">${sub.specialty === 'lamsang' ? 'L�m s�ng' : '�i?u du?ng'}</span>
        </td>

        <td class="py-2.5 px-3">
          <span class="font-black text-blue-700 text-xs sm:text-sm">${sub.totalScore || 0}</span>
          <span class="text-slate-400 text-[10px]">/ 1000d</span>
        </td>
        
        <td class="py-2.5 px-3">
          <span class="level-badge level-${sub.evaluatedTier || 1} text-[10px] py-0.5 px-2">${tierObj.code}</span>
        </td>
        
        <td class="py-2.5 px-3">
          <span class="px-2 py-0.5 rounded-full font-bold text-[10px] border ${stage.badgeClass}">
            ${stage.icon} ${stage.label}
          </span>
        </td>
        
        <td class="py-2.5 px-4 text-right">
          <div class="inline-flex items-center gap-1 flex-wrap justify-end">
            <button onclick="openReviewModal('${sub.id}')" class="px-2 py-1 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold border border-blue-200 transition-all text-xs" title="Xem chi ti?t & Th?m d?nh">
              ??? Xem
            </button>
            ${renderApproverActionButtons(sub)}
          </div>
        </td>
      </tr>
    `;
  });
  
  container.innerHTML = html;
  updateApprovalCounters();
}

function renderApproverActionButtons(sub) {
  const user = APP_STATE.currentUser;
  if (!user) return '';
  let buttons = '';
  
  // Duy?t C?p 1: �D Tru?ng Khoa / Qu?n tr? h? th?ng
  if (sub.status === 'submitted_l1' && ['head_nurse', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="directApproveSubmission('${sub.id}', 1)" class="px-2 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold transition-all shadow-xs text-xs" title="K� duy?t C?p 1 (�D Tru?ng)">
        ? Duy?t C?p 1
      </button>
    `;
  }
  
  // Duy?t C?p 2: Tru?ng Ban �i?u Du?ng / Qu?n tr? h? th?ng
  if (sub.status === 'submitted_l2' && ['nurse_board', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="directApproveSubmission('${sub.id}', 2)" class="px-2 py-1 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold transition-all shadow-xs text-xs" title="K� duy?t C?p 2 (Ban �D)">
        ? Duy?t C?p 2
      </button>
    `;
  }
  
  // Ph� Duy?t C?p 3: Tru?ng Co s? 2 / Ban Gi�m �?c / Qu?n tr? h? th?ng
  if (sub.status === 'submitted_l3' && ['director', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="directApproveSubmission('${sub.id}', 3)" class="px-2 py-1 rounded-lg bg-purple-600 hover:bg-purple-700 text-white font-bold transition-all shadow-xs text-xs" title="Ph� duy?t C?p 3 (L�nh �?o Co S?)">
        ??? Ph� Duy?t C?p 3
      </button>
    `;
  }
  
  // H?y Duy?t
  if (['submitted_l2', 'submitted_l3', 'approved'].includes(sub.status) && ['head_nurse', 'nurse_board', 'director', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="promptRollbackApproval('${sub.id}')" class="px-2 py-1 rounded-lg bg-amber-50 text-amber-800 hover:bg-amber-100 font-bold border border-amber-200 transition-all text-xs" title="H?y duy?t nh?m">
        ?? H?y
      </button>
    `;
  }
  
  // Tr? V? (B?t k? c?p n�o c� quy?n duy?t d?u c� th? tr? v? k�m l� do)
  if (['submitted_l1', 'submitted_l2', 'submitted_l3'].includes(sub.status) && ['head_nurse', 'nurse_board', 'director', 'admin'].includes(user.role)) {
    buttons += `
      <button onclick="promptReturnSubmission('${sub.id}')" class="px-2 py-1 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold border border-rose-200 transition-all text-xs" title="Tr? v? y�u c?u b? sung">
        ?? Tr? V?
      </button>
    `;
  }
  
  // X�a h? so
  if (['admin'].includes(user.role)) {
    buttons += `
      <button onclick="promptDeleteSubmission('${sub.id}')" class="px-2 py-1 rounded-lg bg-slate-100 text-slate-600 hover:bg-rose-600 hover:text-white font-bold transition-all text-xs" title="X�a h? so">
        ???
      </button>
    `;
  }
  
  return buttons;
}

function updateApprovalCounters() {
  const user = APP_STATE.currentUser;
  let subs = APP_STATE.submissions;
  if (user) {
    if (user.role === 'head_nurse') {
      subs = subs.filter(s => s.department === user.department || s.userId === user.id);
    } else if (user.role === 'nurse') {
      subs = subs.filter(s => s.userId === user.id);
    }
  }
  const cAll = subs.length;
  const cL1 = subs.filter(s => s.status === 'submitted_l1').length;
  const cL2 = subs.filter(s => s.status === 'submitted_l2').length;
  const cL3 = subs.filter(s => s.status === 'submitted_l3').length;
  const cApp = subs.filter(s => s.status === 'approved').length;
  const cRet = subs.filter(s => s.status === 'returned').length;
  
  const elAll = document.getElementById('filter-count-all'); if (elAll) elAll.textContent = cAll;
  const elL1 = document.getElementById('badge-count-l1'); if (elL1) elL1.textContent = cL1;
  const elL2 = document.getElementById('badge-count-l2'); if (elL2) elL2.textContent = cL2;
  const elL3 = document.getElementById('badge-count-l3'); if (elL3) elL3.textContent = cL3;
  const elApp = document.getElementById('badge-count-approved'); if (elApp) elApp.textContent = cApp;
  const elRet = document.getElementById('badge-count-returned'); if (elRet) elRet.textContent = cRet;

  // C?p nh?t huy hi?u s? lu?ng h? so ch? duy?t tr�n thanh Menu di?u hu?ng
  const navBadge = document.getElementById('nav-approval-badge');
  if (navBadge && user) {
    let pendingCount = 0;
    if (user.role === 'head_nurse') pendingCount = cL1;
    else if (user.role === 'nurse_board') pendingCount = cL2;
    else if (user.role === 'director') pendingCount = cL3;
    else if (user.role === 'admin') pendingCount = cL1 + cL2 + cL3;
    else pendingCount = subs.filter(s => ['submitted_l1', 'submitted_l2', 'submitted_l3'].includes(s.status)).length;
    
    if (pendingCount > 0) {
      navBadge.textContent = pendingCount;
      navBadge.classList.remove('hidden');
    } else {
      navBadge.classList.add('hidden');
    }
  }
}

function filterApprovalByStatus(status) {
  APP_STATE.filterApprovalStatus = status;
  
  // Highlight active filter button
  document.querySelectorAll('.approval-filter-btn').forEach(btn => {
    btn.classList.remove('bg-blue-700', 'text-white', 'shadow-xs');
    btn.classList.add('bg-white');
  });
  const activeBtn = document.getElementById(`filter-btn-${status}`);
  if (activeBtn) {
    activeBtn.classList.remove('bg-white');
    activeBtn.classList.add('bg-blue-700', 'text-white', 'shadow-xs');
  }
  
  renderApprovalsTab();
}

function onApprovalSearchChanged(val) {
  APP_STATE.approvalSearchQuery = val;
  const clearBtn = document.getElementById('approval-search-clear');
  if (clearBtn) {
    if (val && val.trim().length > 0) clearBtn.classList.remove('hidden');
    else clearBtn.classList.add('hidden');
  }
  renderApprovalsTab();
}

function clearApprovalSearch() {
  const input = document.getElementById('approval-search-input');
  if (input) input.value = '';
  APP_STATE.approvalSearchQuery = '';
  const clearBtn = document.getElementById('approval-search-clear');
  if (clearBtn) clearBtn.classList.add('hidden');
  renderApprovalsTab();
}

function directApproveSubmission(subId, level) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  const user = APP_STATE.currentUser;
  if (!sub || !user) return;
  
  let nextStatus = 'approved';
  let nextLabel = WORKFLOW_STAGES.approved.label;
  let actionText = 'Ph� duy?t ch�nh th?c C?p 3 (Ban Gi�m �?c)';
  
  if (level === 1) {
    nextStatus = 'submitted_l2';
    nextLabel = WORKFLOW_STAGES.submitted_l2.label;
    actionText = 'K� duy?t C?p 1 (�i?u Du?ng Tru?ng Khoa)';
  } else if (level === 2) {
    nextStatus = 'submitted_l3';
    nextLabel = WORKFLOW_STAGES.submitted_l3.label;
    actionText = 'K� duy?t C?p 2 (Tru?ng Ban �i?u Du?ng)';
  }
  
  openConfirmModal({
    title: `X�c Nh?n ${actionText}`,
    icon: '??',
    message: `B?n c� ch?c ch?n mu?n k� duy?t h? so d�nh gi� nang l?c c?a <strong>${sub.fullName}</strong> (${sub.msnv}) l�n bu?c ti?p theo?`,
    btnText: 'X�c Nh?n K� Duy?t',
    btnClass: 'bg-emerald-600 hover:bg-emerald-700',
    onConfirm: () => {
      sub.status = nextStatus;
      sub.statusLabel = nextLabel;
      sub.history.push({
        step: actionText,
        actor: `${user.fullName} (${user.roleName})`,
        date: new Date().toLocaleString('vi-VN'),
        comment: '�� th?m d?nh v� x�c nh?n d?t y�u c?u ti�u chu?n nang l?c',
        action: 'approve'
      });
      saveStorage();
      renderApprovalsTab();
      if (typeof confetti === 'function' && level === 3) confetti({ particleCount: 120, spread: 80 });
      showToast(`�� ${actionText} th�nh c�ng cho h? so ${sub.fullName}!`, 'success');
    }
  });
}

function promptRollbackApproval(subId) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  const user = APP_STATE.currentUser;
  if (!sub || !user) return;
  
  let prevStatus = 'submitted_l1';
  if (sub.status === 'submitted_l3') prevStatus = 'submitted_l2';
  if (sub.status === 'submitted_l2') prevStatus = 'submitted_l1';
  
  openConfirmModal({
    title: 'H?y / Thu H?i Ph� Duy?t',
    icon: '??',
    message: `B?n c� ch?c ch?n mu?n h?y k?t qu? ph� duy?t h? so c?a <strong>${sub.fullName}</strong> d? xem x�t v� d�nh gi� l?i t? d?u?`,
    btnText: 'X�c Nh?n H?y Duy?t',
    btnClass: 'bg-amber-600 hover:bg-amber-700',
    onConfirm: () => {
      sub.status = prevStatus;
      sub.statusLabel = WORKFLOW_STAGES[prevStatus].label;
      sub.history.push({
        step: 'H?y Ph� Duy?t (Rollback)',
        actor: `${user.fullName} (${user.roleName})`,
        date: new Date().toLocaleString('vi-VN'),
        comment: '�� thu h?i k?t qu? duy?t d? th?m d?nh l?i',
        action: 'rollback'
      });
      saveStorage();
      renderApprovalsTab();
      showToast(`�� g? ph� duy?t c?a h? so ${sub.fullName} d? d�nh gi� l?i!`, 'warning');
    }
  });
}

function promptReturnSubmission(subId) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  const user = APP_STATE.currentUser;
  if (!sub || !user) return;
  
  const comment = prompt('Nh?p l� do ho?c hu?ng d?n b? sung h? so g?i cho di?u du?ng:', 'C?n b? sung th�m ch?ng nh?n CME d�o t?o li�n t?c v� minh ch?ng ca l�m s�ng ph?c t?p.');
  if (comment === null) return;
  
  sub.status = 'returned';
  sub.statusLabel = WORKFLOW_STAGES.returned.label;
  sub.history.push({
    step: 'Y�u C?u B? Sung / Tr? V?',
    actor: `${user.fullName} (${user.roleName})`,
    date: new Date().toLocaleString('vi-VN'),
    comment: comment || 'H? so c?n ch?nh s?a v� b? sung th�m minh ch?ng',
    action: 'return'
  });
  saveStorage();
  renderApprovalsTab();
  showToast(`�� tr? h? so v? cho ${sub.fullName} k�m y�u c?u b? sung!`, 'info');
}

function promptDeleteSubmission(subId) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  if (!sub) return;
  
  openConfirmModal({
    title: 'X�a Ho�n To�n H? So Nh�n S?',
    icon: '???',
    message: `H�nh d?ng n�y s? <strong>x�a vinh vi?n</strong> d? li?u d?t d�nh gi� c?a <strong>${sub.fullName}</strong> (${sub.msnv}). Thao t�c kh�ng th? ho�n t�c!`,
    btnText: 'X�a Vinh Vi?n',
    btnClass: 'bg-rose-600 hover:bg-rose-700',
    onConfirm: () => {
      APP_STATE.submissions = APP_STATE.submissions.filter(s => s.id !== subId);
      saveStorage();
      renderApprovalsTab();
      showToast(`�� x�a th�nh c�ng h? so c?a ${sub.fullName}!`, 'success');
    }
  });
}

function batchApproveLevel3() {
  const user = APP_STATE.currentUser;
  if (!user || !['director', 'admin'].includes(user.role)) {
    showToast('Ch? Ban Gi�m �?c ho?c Admin m?i c� quy?n ph� duy?t d?ng lo?t C?p 3!', 'warning');
    return;
  }
  
  const pending = APP_STATE.submissions.filter(s => s.status === 'submitted_l3');
  if (pending.length === 0) {
    showToast('Kh�ng c� h? so n�o dang ch? Ban Gi�m �?c ph� duy?t!', 'info');
    return;
  }
  
  openConfirmModal({
    title: 'Ph� Duy?t �?ng Lo?t C?p 3 (Ban Gi�m �?c)',
    icon: '???',
    message: `B?n c� ch?c ch?n mu?n ph� duy?t ch�nh th?c cho to�n b? <strong>${pending.length} h? so</strong> dang ch? x�t duy?t?`,
    btnText: 'Ph� Duy?t T?t C?',
    btnClass: 'bg-purple-700 hover:bg-purple-800',
    onConfirm: () => {
      pending.forEach(s => {
        s.status = 'approved';
        s.statusLabel = WORKFLOW_STAGES.approved.label;
        s.history.push({
          step: 'Ph� Duy?t �?ng Lo?t C?p 3',
          actor: `${user.fullName} (Ban Gi�m �?c)`,
          date: new Date().toLocaleString('vi-VN'),
          comment: 'Ph� duy?t ch�nh th?c c�ng nh?n b?c nang l?c UMC',
          action: 'approve'
        });
      });
      saveStorage();
      renderApprovalsTab();
      if (typeof confetti === 'function') confetti({ particleCount: 150, spread: 100 });
      showToast(`�� ph� duy?t ch�nh th?c cho ${pending.length} h? so th�nh c�ng!`, 'success');
    }
  });
}

function openReviewModal(subId) {
  const sub = APP_STATE.submissions.find(s => s.id === subId);
  if (!sub) return;
  
  const nameEl = document.getElementById('review-modal-name'); if (nameEl) nameEl.textContent = sub.fullName;
  const deptEl = document.getElementById('review-modal-dept'); if (deptEl) deptEl.textContent = `${sub.msnv} � ${sub.department}`;
  
  const evContainer = document.getElementById('review-modal-evidences');
  if (evContainer) {
    let evHtml = '';
    const allEvs = sub.criterionEvidences || {};
    let totalFiles = 0;
    
    Object.keys(allEvs).forEach(critId => {
      const files = allEvs[critId] || [];
      files.forEach(f => {
        totalFiles++;
        evHtml += `
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-200 text-xs">
            <div class="flex items-center gap-2">
              <span>??</span>
              <span class="font-bold text-slate-700">${f.name}</span>
              <span class="text-slate-400 text-[11px]">(${f.size})</span>
            </div>
            <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 text-[11px] font-semibold">${critId}</span>
          </div>
        `;
      });
    });
    
    evContainer.innerHTML = totalFiles > 0 ? evHtml : `<div class="text-xs text-slate-400 italic">Chua c� t?p minh ch?ng d�nh k�m.</div>`;
  }
  
  const histContainer = document.getElementById('review-modal-history');
  if (histContainer) {
    let histHtml = '';
    (sub.history || []).forEach(h => {
      histHtml += `
        <div class="border-l-2 border-blue-500 pl-3 py-1 text-xs">
          <div class="flex items-center gap-2 font-bold text-slate-800">
            <span>${h.step}</span>
            <span class="text-slate-400 text-[11px] font-normal">� ${h.date}</span>
          </div>
          <p class="text-slate-600 mt-0.5"><strong class="text-blue-700">${h.actor}:</strong> ${h.comment || ''}</p>
        </div>
      `;
    });
    histContainer.innerHTML = histHtml;
  }
  
  const modal = document.getElementById('modal-review-submission');
  if (modal) modal.classList.remove('hidden');
}

function closeReviewModal() {
  const modal = document.getElementById('modal-review-submission');
  if (modal) modal.classList.add('hidden');
}

