  `;
}

// T�nh To�n T?ng �i?m & C?p Nh?t X?p B?c Theo Chu?n B?nh Vi?n
function calculateAndUpdateAssessmentSummary(sub) {
  let total = 0;
  const specialty = APP_STATE.selectedSpecialty || sub.specialty || 'lamsang';
  const domains = DOMAINS_BY_SPECIALTY[specialty] || [];
  const domainScores = {};
  
  domains.forEach(d => {
    let dScore = 0;

    (d.standards || []).forEach(s => {
      const isSingleChoice = SINGLE_CHOICE_STANDARDS.includes(s.id);
      
      if (isSingleChoice) {
        // V?i ti�u chu?n "ch?n 1 nang l?c ph� h?p nh?t": l?y di?m l?n nh?t trong c�c ti�u ch� du?c ch?n
        let stdSelectedScore = 0;
        (s.criteria || []).forEach(c => {
          const val = APP_STATE.currentAssessmentScores[c.id] || 0;
          if (val > stdSelectedScore) {
            stdSelectedScore = val;
          }
        });
        const stdMax = CLINICAL_STANDARD_MAX_SCORES[s.id] || 80;
        dScore += Math.min(stdMax, stdSelectedScore);
      } else {
        // Ti�u chu?n c?ng d?n b�nh thu?ng
        (s.criteria || []).forEach(c => {
          const val = APP_STATE.currentAssessmentScores[c.id] || 0;
          dScore += val;
        });
      }
    });

    // Gi?i h?n kh�ng vu?t qu� di?m tr?n c?a Linh v?c (I: 180, II: 450, III: 120, IV: 100, V: 150)
    dScore = Math.min(d.maxPoints || 200, dScore);
    domainScores[d.id] = dScore;
    total += dScore;
    
    // C?p nh?t c�c badge di?m s? tr�n giao di?n
    const badgeEl = document.getElementById(`domain-score-badge-${d.id}`);
    if (badgeEl) badgeEl.innerHTML = `${dScore} <span class="text-xs font-normal text-slate-400">/ ${d.maxPoints || 200}d</span>`;
    const pillEl = document.getElementById(`domain-pill-score-${d.id}`);
    if (pillEl) pillEl.textContent = dScore;
  });
  
  sub.totalScore = total;
  sub.domainScores = domainScores;
  
  // X�c d?nh c?p b?c nang l?c d?a tr�n T?ng di?m v� �i?m s�n 5 Linh v?c
  let calculatedTier = 1;
  for (let t = 7; t >= 1; t--) {
    const floor = TIER_DOMAIN_MINIMUMS[t];
    if (total >= floor.minTotal) {
      const d1Score = domainScores['lamsang_d1'] || 0;
      const d2Score = domainScores['lamsang_d2'] || 0;
      const d3Score = domainScores['lamsang_d3'] || 0;
      const d4Score = domainScores['lamsang_d4'] || 0;
      const d5Score = domainScores['lamsang_d5'] || 0;

      if (d1Score >= floor.d1 && d2Score >= floor.d2 && d3Score >= floor.d3 && d4Score >= floor.d4 && d5Score >= floor.d5) {
        calculatedTier = t;
        break;
      }
    }
  }

  sub.evaluatedTier = calculatedTier;
  
  // C?p nh?t DOM c�c ph?n t? t?ng k?t
  const totalScoreEl = document.getElementById('summary-total-score');
  if (totalScoreEl) totalScoreEl.textContent = `${total}`;
  
  const levelEl = document.getElementById('summary-competency-level');
  const levelDescEl = document.getElementById('summary-level-desc');
  const tierObj = COMPETENCY_TIERS_MATRIX.find(t => t.tier === calculatedTier) || COMPETENCY_TIERS_MATRIX[0];
  if (levelEl) {
    levelEl.className = `level-badge level-${calculatedTier} text-xs px-3 py-1 font-black`;
    levelEl.textContent = `${tierObj.code} (${tierObj.name})`;
  }
  if (levelDescEl) levelDescEl.textContent = tierObj.title;
  
  const progressBar = document.getElementById('summary-score-progress');
  if (progressBar) {
    const pct = Math.min(100, Math.round((total / 1000) * 100));
    progressBar.style.width = `${pct}%`;
  }
}

// In Phi?u ��nh Gi� Chu?n A4 B?nh Vi?n UMC
function printAssessmentForm() {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  const specialty = APP_STATE.selectedSpecialty || user.specialty || 'lamsang';
  const domains = DOMAINS_BY_SPECIALTY[specialty] || [];
  const tierObj = COMPETENCY_TIERS_MATRIX.find(t => t.tier === sub.evaluatedTier) || COMPETENCY_TIERS_MATRIX[0];
  const printContainer = document.getElementById('printable-assessment-form');
  if (!printContainer) return;

  let rowsHtml = '';
  domains.forEach(d => {
    const dScore = sub.domainScores ? (sub.domainScores[d.id] || 0) : 0;
    rowsHtml += `
      <tr style="background-color: #f1f5f9; font-weight: bold;">
        <td colspan="5" style="padding: 6px 8px; border: 1px solid #94a3b8;">
          ${d.code} ${d.name} (�i?m d?t: ${dScore} / ${d.maxPoints}d)
        </td>
      </tr>
    `;
    (d.standards || []).forEach(s => {
      rowsHtml += `
        <tr style="background-color: #f8fafc; font-weight: bold; font-size: 10pt;">
          <td colspan="5" style="padding: 4px 8px; border: 1px solid #cbd5e1; color: #004b87;">
            ${s.title.replace(/\n/g, ' ')}
          </td>
        </tr>
      `;
      (s.criteria || []).forEach(c => {
        const val = APP_STATE.currentAssessmentScores[c.id] || 0;
        const optKey = APP_STATE.currentAssessmentOptionKeys ? APP_STATE.currentAssessmentOptionKeys[c.id] : undefined;
        const opt = (c.options || []).find((o, idx) => (optKey !== undefined ? idx === optKey : o.score === val));
        const mScore = APP_STATE.managerAssessmentScores ? (APP_STATE.managerAssessmentScores[c.id] || '') : '';
        const evList = (APP_STATE.currentCriterionEvidences[c.id] || []).map(e => e.name).join(', ');

        rowsHtml += `
          <tr style="font-size: 9.5pt;">
            <td style="padding: 4px 6px; border: 1px solid #cbd5e1; vertical-align: top; width: 42%;">
              <strong>TC ${c.num}:</strong> ${c.title}
              ${opt ? `<div style="font-size: 8.5pt; color: #475569; margin-top: 2px;"><em>M?c d?t: ${opt.level} - ${opt.text}</em></div>` : ''}
            </td>
