function switchAssessmentDomain(domainId) {
  APP_STATE.activeAssessmentDomain = domainId;
  renderAssessmentTab();
}

function setAssessmentViewMode(mode) {
  APP_STATE.assessmentViewMode = mode;
  renderAssessmentTab();
}

function setAssessmentStatusFilter(status) {
  APP_STATE.assessmentStatusFilter = status;
  renderAssessmentTab();
}

function onAssessmentSearchInput(val) {
  APP_STATE.assessmentSearchQuery = val;
  renderAssessmentTab();
}

function clearAssessmentSearch() {
  APP_STATE.assessmentSearchQuery = '';
  renderAssessmentTab();
}

function toggleDomainAccordion(domainId) {
  const body = document.getElementById(`domain-body-${domainId}`);
  const icon = document.getElementById(`domain-icon-${domainId}`);
  if (!body) return;
  if (body.classList.contains('hidden')) {
    body.classList.remove('hidden');
    if (icon) icon.style.transform = 'rotate(0deg)';
  } else {
    body.classList.add('hidden');
    if (icon) icon.style.transform = 'rotate(-90deg)';
  }
}

// File Attachment Functions
function handleCriterionFileUpload(event, critId) {
  const files = event.target.files;
  if (!files || files.length === 0) return;
  
  if (!APP_STATE.currentCriterionEvidences[critId]) {
    APP_STATE.currentCriterionEvidences[critId] = [];
  }
  
  for (let i = 0; i < files.length; i++) {
    const f = files[i];
    const evObj = {
      id: `ev_${Date.now()}_${i}`,
      name: f.name,
      size: `${(f.size / (1024 * 1024)).toFixed(2)} MB`,
      uploadDate: new Date().toLocaleDateString('vi-VN'),
      type: f.name.split('.').pop().toLowerCase()
    };
    APP_STATE.currentCriterionEvidences[critId].push(evObj);
  }
  
  const user = APP_STATE.currentUser;
  if (user) {
    const sub = getUserSubmission(user.id);
    sub.criterionEvidences = APP_STATE.currentCriterionEvidences;
    saveStorage();
  }
  
  renderAssessmentTab();
  showToast(`�� d�nh k�m ${files.length} t?p minh ch?ng th�nh c�ng!`, 'success');
}

function removeCriterionEvidence(critId, fileIndex) {
  if (!APP_STATE.currentCriterionEvidences[critId]) return;
  APP_STATE.currentCriterionEvidences[critId].splice(fileIndex, 1);
  
  const user = APP_STATE.currentUser;
  if (user) {
    const sub = getUserSubmission(user.id);
    sub.criterionEvidences = APP_STATE.currentCriterionEvidences;
    saveStorage();
  }
  
  renderAssessmentTab();
  showToast('�� g? t?p minh ch?ng.', 'info');
}

function previewCriterionEvidence(critId, fileIndex) {
  const evidences = APP_STATE.currentCriterionEvidences[critId] || [];
  const ev = evidences[fileIndex];
  if (!ev) return;
  
  const titleEl = document.getElementById('preview-modal-title'); if (titleEl) titleEl.textContent = ev.name;
  const docEl = document.getElementById('preview-modal-docname'); if (docEl) docEl.textContent = ev.name;
  const fileEl = document.getElementById('preview-modal-filename'); if (fileEl) fileEl.textContent = `T?p: ${ev.name} � K�ch thu?c: ${ev.size} � Ng�y t?i: ${ev.uploadDate}`;
  
  const modal = document.getElementById('modal-preview-evidence');
  if (modal) modal.classList.remove('hidden');
}

function closePreviewModal() {
  const modal = document.getElementById('modal-preview-evidence');
  if (modal) modal.classList.add('hidden');
}

