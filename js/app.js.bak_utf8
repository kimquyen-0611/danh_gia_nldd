function promptResetScores() {
  openConfirmModal({
    title: 'Reset Phi?u ��nh Gi� (V? 0 �i?m)',
    icon: '??',
    message: 'B?n c� ch?c ch?n mu?n x�a to�n b? di?m d� ch?m v� dua phi?u t? d�nh gi� v? tr?ng th�i b?n nh�p ban d?u (0 di?m) d? th?c hi?n l?i t? d?u kh�ng?',
    btnText: 'X�c Nh?n Reset',
    btnClass: 'bg-rose-600 hover:bg-rose-700',
    onConfirm: () => {
      APP_STATE.currentAssessmentScores = {};
      APP_STATE.currentAssessmentOptionKeys = {};
      const user = APP_STATE.currentUser;
      if (user) {
        const sub = getUserSubmission(user.id);
        sub.scores = {};
        sub.optionKeys = {};
        sub.totalScore = 0;
        sub.domainScores = { lamsang_d1: 0, lamsang_d2: 0, lamsang_d3: 0, lamsang_d4: 0, lamsang_d5: 0 };
        sub.status = 'draft';
        sub.statusLabel = WORKFLOW_STAGES.draft.label;
        sub.evaluatedTier = 1;
        saveStorage();
      }
      renderAssessmentTab();
      showToast('�� reset to�n b? phi?u d�nh gi� v? 0 di?m ban d?u!', 'success');
    }
  });
}


function promptDeleteAssessment() {
  openConfirmModal({
    title: 'H?y B? �?t ��nh Gi�',
    icon: '???',
    message: 'B?n c� ch?c ch?n mu?n x�a to�n b? d?t d�nh gi� n�y kh�ng?',
    btnText: 'X�a �?t ��nh Gi�',
    btnClass: 'bg-rose-600 hover:bg-rose-700',
    onConfirm: () => {
      const user = APP_STATE.currentUser;
      if (user) {
        APP_STATE.submissions = APP_STATE.submissions.filter(s => s.userId !== user.id);
        APP_STATE.currentAssessmentScores = {};
      APP_STATE.currentAssessmentOptionKeys = {};
        APP_STATE.currentCriterionEvidences = {};
        saveStorage();
      }
      renderAssessmentTab();
      showToast('�� x�a ho�n to�n b?n d�nh gi�!', 'info');
    }
  });
}

