              <div>Y�u c?u t?i thi?u: <strong>${floorConfig.minTotal}d</strong> to�n di?n</div>
              <div class="text-[10px] text-slate-400">
                Linh v?c: I=${floorConfig.d1}d � II=${floorConfig.d2}d � III=${floorConfig.d3}d � IV=${floorConfig.d4}d � V=${floorConfig.d5}d
              </div>
            </div>
          </div>

        </div>

        <!-- B?ng Ki?m Tra �i?m S�n 5 Linh V?c (Live Floor Matrix) -->
        <div class="overflow-x-auto">
          <div class="inline-flex items-center gap-2 w-full text-xs">
            <div class="text-[11px] font-extrabold text-slate-600 whitespace-nowrap hidden sm:inline">
              ?? �i?m s�n C?p ${targetTier}:
            </div>

            <div class="flex items-center gap-1.5 flex-1 flex-wrap">
              
              <!-- LV I -->
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border text-[11px] ${
