// Ch? �? 1: PHI?U ��NH GI� H�NG NGANG CHU?N B?NH VI?N UMC
// Ti�u ch� v� c�c c�u tr? l?i du?c thi?t k? theo H�NG NGANG, vi?t tr?i r?ng h?t h�ng m?i xu?ng h�ng
function renderAssessmentClinicalTable(displayDomains, isLocked, user, sub) {
  const container = document.getElementById('assessment-domains-container');
  if (!container) return;

  const statusFilter = APP_STATE.assessmentStatusFilter || 'all';
  const searchQuery = (APP_STATE.assessmentSearchQuery || '').trim().toLowerCase();
  const canEditManager = ['head_nurse', 'nurse_board', 'director', 'admin'].includes(user.role);

  let fullHtml = '';
  let matchCount = 0;

  displayDomains.forEach((domain, dIdx) => {
    let domainHtml = '';
    let dTotalCrit = 0;
    let dScoredCrit = 0;

    (domain.standards || []).forEach(std => {
      const isSingleChoice = SINGLE_CHOICE_STANDARDS.includes(std.id);
      const stdMaxScore = CLINICAL_STANDARD_MAX_SCORES[std.id] || (std.criteria || []).reduce((sum, c) => sum + (c.maxScore || 0), 0);
      
      // L?c c�c ti�u ch� theo t�m ki?m & tr?ng th�i
      const visibleCriteria = (std.criteria || []).filter(crit => {
        dTotalCrit++;
        const val = APP_STATE.currentAssessmentScores[crit.id] || 0;
        if (val > 0) dScoredCrit++;

        if (statusFilter === 'unscored' && val > 0) return false;
        if (statusFilter === 'scored' && val === 0) return false;

        if (searchQuery) {
          const matchTitle = (crit.title || '').toLowerCase().includes(searchQuery);
          const matchDesc = (crit.desc || '').toLowerCase().includes(searchQuery);
          const matchNum = `tc ${crit.num}`.toLowerCase().includes(searchQuery) || `${crit.num}` === searchQuery;
          const matchOpts = (crit.options || []).some(o => (o.text || '').toLowerCase().includes(searchQuery));
          return matchTitle || matchDesc || matchNum || matchOpts;
        }
        return true;
      });

      if (visibleCriteria.length === 0) return;
      matchCount += visibleCriteria.length;

      // Ti�u d? Ti�u chu?n ch?y d�i h�ng ngang
      domainHtml += `
        <div class="clinical-standard-group mb-5">
          <div class="bg-blue-50/90 border-l-4 border-blue-700 px-4 py-2.5 rounded-r-xl border-y border-r border-blue-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 shadow-2xs">
            <div class="flex items-center gap-2">
              <span class="text-blue-700 text-sm">??</span>
              <span class="font-extrabold text-slate-800 text-xs sm:text-sm uppercase tracking-wide">
                ${std.title.replace(/\n/g, ' ')}
              </span>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              ${isSingleChoice ? `
                <span class="px-2.5 py-0.8 rounded-lg bg-amber-100 text-amber-900 border border-amber-300 font-bold text-[11px] flex items-center gap-1 shadow-2xs">
                  <span>??</span> Ch? ch?n 1 nang l?c ph� h?p nh?t (T?i da ${stdMaxScore}d)
                </span>
              ` : `
                <span class="px-2.5 py-0.8 rounded-lg bg-blue-100 text-blue-900 font-bold text-[11px] border border-blue-200">
                  �i?m ti�u chu?n: T?i da ${stdMaxScore}d
                </span>
              `}
            </div>
          </div>

          <div class="space-y-3.5">
      `;

      // T?ng Ti�u ch� ch?y d�i h�ng ngang (vi?t n?i dung h?t h�ng m?i xu?ng h�ng)
      visibleCriteria.forEach(crit => {
        const selectedScore = APP_STATE.currentAssessmentScores[crit.id];
        const isScored = selectedScore !== undefined && selectedScore !== null && selectedScore > 0;
        const savedOptIdx = (APP_STATE.currentAssessmentOptionKeys && APP_STATE.currentAssessmentOptionKeys[crit.id] !== undefined)
          ? APP_STATE.currentAssessmentOptionKeys[crit.id]
          : undefined;
        const selectedOpt = (crit.options || []).find((o, idx) => (savedOptIdx !== undefined ? idx === savedOptIdx : o.score === selectedScore));
        const managerScore = APP_STATE.managerAssessmentScores ? (APP_STATE.managerAssessmentScores[crit.id] || 0) : 0;
        const evidences = APP_STATE.currentCriterionEvidences[crit.id] || [];
        const evidenceHint = getEvidenceHint(crit.id);

        domainHtml += `
          <div id="table-row-${crit.id}" class="bg-white rounded-2xl border transition-all duration-200 p-4 sm:p-5 shadow-2xs hover:shadow-xs ${isScored ? 'border-blue-300 ring-1 ring-blue-500/15 bg-blue-50/20' : 'border-slate-200'}">
            
            <!-- H�NG TI�U CH� (Ch?y d�i h�ng ngang, vi?t h?t h�ng m?i xu?ng h�ng) -->
            <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-3 pb-3 border-b border-slate-100">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                  <span class="px-2.5 py-0.8 rounded-md bg-blue-700 text-white font-black text-xs shadow-2xs">
                    TC ${crit.num || crit.id.replace('lamsang_c', '')}
                  </span>
                  ${isSingleChoice ? `
                    <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 text-[11px] font-bold">
                      Nh�m ch?n 1
                    </span>
                  ` : ''}
                  ${isScored ? `
                    <span class="px-2.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-300 text-[11px] font-extrabold flex items-center gap-1">
                      <span>?</span> �� ch?n ${selectedScore}d
                    </span>
                  ` : `
                    <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-500 text-[11px] font-medium">
                      ? Chua d�nh gi�
                    </span>
                  `}
                </div>

                <!-- T�n Ti�u Ch� vi?t d�i theo h�ng ngang, h?t h�ng m?i xu?ng h�ng -->
                <h4 class="text-sm sm:text-base font-bold text-slate-900 leading-snug">
                  ${crit.title}
                </h4>

                <!-- M� t? & Hu?ng d?n vi?t d�i theo h�ng ngang, h?t h�ng m?i xu?ng h�ng -->
                ${crit.desc ? `
                  <p class="text-xs text-slate-600 mt-1.5 font-medium leading-relaxed">
                    ?? ${crit.desc}
                  </p>
                ` : ''}
                ${crit.note ? `
                  <div class="mt-2 p-2.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 font-medium leading-relaxed">
                    <strong>?? Hu?ng d?n d�nh gi�:</strong> ${crit.note}
                  </div>
                ` : ''}
              </div>

              <!-- C?m �i?m T? Ch?m & N�t B? Ch?n b�n ph?i -->
              <div class="shrink-0 flex items-center gap-2 self-start lg:self-center">
                ${isScored ? `
                  <div class="flex items-center gap-2">
                    <div class="px-3.5 py-1.5 rounded-xl bg-blue-700 text-white font-black text-sm shadow-xs flex items-center gap-1.5">
                      <span>?</span>
                      <span>${selectedScore}d</span>
                      <span class="text-xs font-normal opacity-90">/ ${crit.maxScore}d</span>
                    </div>
                    ${!isLocked ? `
                      <button type="button" 
                        onclick="onDeselectCriterion('${crit.id}')" 
                        title="B? ch?n ti�u ch� n�y (v? 0 di?m)" 
                        class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 hover:text-rose-900 border border-rose-200 text-xs font-extrabold flex items-center gap-1 transition-all cursor-pointer shadow-2xs">
                        <span>?</span> B? ch?n
                      </button>
                    ` : ''}
                  </div>
                ` : `
                  <div class="px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 font-bold text-xs">
                    T?i da: ${crit.maxScore}d
                  </div>
                `}
              </div>
            </div>

            <!-- H�NG C�C C�U TR? L?I / M?C �? NANG L?C (M?i c�u tr? l?i ch?y d�i h�ng ngang 100% width, vi?t h?t h�ng m?i xu?ng h�ng!) -->
            <div class="mt-3 space-y-2">
              <div class="text-[11px] font-black text-slate-500 uppercase tracking-wider mb-1 flex items-center justify-between">
                <span>C�c c�u tr? l?i / M?c d? nang l?c (Nh?p ch?n 1 m?c ph� h?p):</span>
                <span class="text-[10px] text-slate-400 font-normal lowercase italic">N?i dung c�u tr? l?i tr?i d�i h�ng ngang � Nh?p ch?n / B? ch?n</span>
              </div>

              ${(crit.options || []).map((opt, optIdx) => {
                const isOptSelected = (savedOptIdx !== undefined)
                  ? (savedOptIdx === optIdx)
                  : (selectedScore === opt.score);

                return `
                  <button type="button" 
                    onclick="onSelectCriterionScore('${crit.id}', ${opt.score}, ${optIdx})"
                    title="${isOptSelected ? 'Nh?p d? B? CH?N m?c n�y (v? 0d)' : 'Nh?p d? CH?N ' + opt.level + ' (' + opt.score + ' di?m)'}"
                    class="clinical-level-btn clinical-horizontal-option ${isOptSelected ? 'is-selected' : ''} ${isLocked ? 'pointer-events-none opacity-80' : ''}">
                    
                    <!-- B�n tr�i: � ch?n tr�n + M?c d? + �i?m + N?i dung c�u tr? l?i vi?t tr?i d�i h?t h�ng m?i xu?ng h�ng -->
                    <div class="flex items-start gap-3 flex-1 min-w-0">
                      <!-- � tr�n click ch?n tr?c quan -->
                      <div class="level-check-circle shrink-0 mt-0.5 ${isOptSelected ? 'is-checked' : ''}">
                        ${isOptSelected ? `
                          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                          </svg>
                        ` : `
                          <div class="w-2 h-2 rounded-full bg-slate-300 group-hover:bg-blue-400 transition-colors"></div>
                        `}
                      </div>

                      <!-- Huy hi?u M?c d? & �i?m s? -->
                      <div class="flex items-center gap-1.5 shrink-0 pt-0.5">
                        <span class="px-2.5 py-0.8 rounded-lg font-black text-xs ${
                          isOptSelected ? 'bg-blue-700 text-white shadow-2xs' : 'bg-slate-100 text-slate-800 border border-slate-200'
                        }">
                          ${opt.level}
                        </span>
                        <span class="px-2 py-0.8 rounded-lg font-black text-xs ${
                          isOptSelected ? 'bg-blue-100 text-blue-900 border border-blue-300' : 'bg-blue-50 text-blue-800 border border-blue-200'
                        }">
                          +${opt.score}d
                        </span>
                      </div>

                      <!-- N?I DUNG C�U TR? L?I: Vi?t tr?i d�i h?t h�ng m?i xu?ng h�ng -->
                      <div class="flex-1 text-xs leading-relaxed ${isOptSelected ? 'text-blue-950 font-bold' : 'text-slate-700 font-normal'}">
                        ${opt.text}
                      </div>
                    </div>

                    <!-- B�n ph?i: Tr?ng th�i ch?n & N�t b? ch?n -->
                    <div class="shrink-0 flex items-center gap-2 sm:self-center pl-7 sm:pl-0">
                      ${isOptSelected ? `
                        <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 border border-emerald-300 font-extrabold text-xs flex items-center gap-1 shadow-2xs">
                          <span>?</span> �ang ch?n
                        </span>
                        ${!isLocked ? `
                          <span onclick="event.stopPropagation(); onDeselectCriterion('${crit.id}')" 
                            title="Nh?p d? b? ch?n m?c n�y (v? 0d)" 
                            class="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-extrabold text-xs flex items-center gap-1 cursor-pointer transition-colors shadow-2xs">
                            <span>?</span> B? ch?n
                          </span>
                        ` : ''}
                      ` : `
                        <span class="text-xs text-slate-400 group-hover:text-blue-600 font-semibold transition-colors flex items-center gap-1">
                          <span>?</span> Ch?n
                        </span>
                      `}
                    </div>

                  </button>
                `;
              }).join('')}
            </div>

            <!-- H�NG TH?M �?NH & MINH CH?NG (Footer Bar) -->
            <div class="mt-3 pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs bg-slate-50/70 p-3 rounded-xl border border-slate-200/70">
              <!-- Qu?n l� tr?c ti?p (�D Tru?ng Khoa) -->
              <div class="flex items-center gap-2">
                <span class="text-slate-600 font-bold flex items-center gap-1">
                  <span>?????</span> Qu?n l� tr?c ti?p (�D Tru?ng):
                </span>
                ${canEditManager && !isLocked ? `
                  <input type="number" 
                    min="0" 
                    max="${crit.maxScore}" 
                    value="${managerScore || ''}"
                    onchange="setAssessmentManagerScore('${crit.id}', this.value)"
                    placeholder="${selectedScore || 0}"
                    class="w-16 text-center py-1 bg-white border border-amber-300 rounded-lg text-xs font-black text-amber-900 focus:outline-none focus:border-amber-500 shadow-2xs">
                  <span class="text-[10px] text-amber-700 font-bold">di?m th?m d?nh</span>
                ` : `
                  <span class="px-2.5 py-1 rounded-lg ${managerScore > 0 ? 'bg-amber-100 text-amber-900 font-black' : 'bg-white text-slate-400'} border border-slate-200 text-xs">
                    ${managerScore > 0 ? `${managerScore}d` : 'Chua th?m d?nh'}
                  </span>
                `}
              </div>

              <!-- Minh ch?ng d�nh k�m -->
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-slate-600 font-bold flex items-center gap-1">
                  <span>??</span> Minh ch?ng:
                </span>
                ${evidences.length > 0 ? `
                  <div class="flex items-center gap-1.5 flex-wrap">
                    ${evidences.map((ev, eIdx) => `
                      <span class="inline-flex items-center gap-1 px-2 py-1 bg-emerald-50 border border-emerald-200 rounded-lg text-[11px] text-emerald-900 font-semibold" title="${ev.name}">
                        <span class="truncate max-w-[130px]">?? ${ev.name}</span>
                        <button type="button" onclick="previewCriterionEvidence('${crit.id}', ${eIdx})" class="text-blue-600 hover:text-blue-800" title="Xem">???</button>
                        ${!isLocked ? `
                          <button type="button" onclick="removeCriterionEvidence('${crit.id}', ${eIdx})" class="text-rose-500 hover:text-rose-700" title="G?">?</button>
                        ` : ''}
                      </span>
                    `).join('')}
                  </div>
                ` : `
                  <span class="text-slate-400 italic text-[11px]">${evidenceHint ? evidenceHint : 'Chua c� t?p d�nh k�m'}</span>
                `}

                ${!isLocked ? `
                  <label class="inline-flex items-center gap-1 px-2.5 py-1 bg-white hover:bg-blue-50 hover:text-blue-700 text-slate-700 rounded-lg cursor-pointer text-[11px] font-bold border border-slate-200 shadow-2xs transition-colors">
                    <span>+ T?i t?p</span>
                    <input type="file" class="hidden" onchange="handleCriterionFileUpload(event, '${crit.id}')" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" multiple>
                  </label>
                ` : ''}
              </div>
            </div>

          </div>
        `;
      });

      domainHtml += `
          </div>
        </div>
      `;
    });

    if (domainHtml) {
      const dScore = sub.domainScores ? (sub.domainScores[domain.id] || 0) : 0;
      fullHtml += `
        <div class="clinical-domain-block mb-6 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
          <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white px-5 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-white/20 text-white font-black text-xs flex items-center justify-center border border-white/25 shadow-2xs">
                ${domain.code}
              </span>
              <div>
                <h3 class="text-sm sm:text-base font-black tracking-wide">${domain.name}</h3>
                <p class="text-[11px] text-blue-200">�� t? d�nh gi�: <strong>${dScoredCrit}/${dTotalCrit}</strong> ti�u ch�</p>
              </div>
            </div>
            <div class="text-right">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white text-blue-950 font-black text-xs sm:text-sm shadow-xs">
                <span>�i?m d?t:</span>
                <strong class="text-blue-700 text-sm sm:text-base">${dScore}</strong> / ${domain.maxPoints}d
              </span>
            </div>
          </div>

          <div class="p-4 sm:p-5 bg-slate-50/40">
            ${domainHtml}
          </div>
        </div>
      `;
    }
  });

  if (matchCount === 0) {
    fullHtml = `
      <div class="bg-white rounded-2xl p-10 text-center border border-slate-200 shadow-xs max-w-lg mx-auto my-6">
        <div class="w-16 h-16 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-2xl mx-auto mb-3">??</div>
        <h4 class="text-base font-bold text-slate-800 mb-1">Kh�ng t�m th?y ti�u ch� ph� h?p</h4>
        <p class="text-xs text-slate-500 mb-4">Kh�ng c� ti�u ch� n�o kh?p v?i t? kh�a "${searchQuery}" ho?c b? l?c hi?n t?i.</p>
        <button type="button" onclick="clearAssessmentSearch(); setAssessmentStatusFilter('all');" class="px-4 py-2 bg-blue-700 text-white font-bold rounded-xl text-xs shadow-xs hover:bg-blue-800 transition-all">
          ?? X�a b? l?c v� xem t?t c?
        </button>
      </div>
    `;
  }

  container.innerHTML = fullHtml;
}

// Ch? �? 2: TH? CHI TI?T (Cards) HO?C THU G?N (Compact)
function renderAssessmentCardsOrCompact(displayDomains, isLocked, viewMode, searchQuery, statusFilter, user, sub) {
  const container = document.getElementById('assessment-domains-container');
  if (!container) return;

  let html = '';
  let visibleCriteriaTotal = 0;

  displayDomains.forEach((domain, dIdx) => {
    let dScore = 0;
    let totalCritCount = 0;
    let scoredCritCount = 0;
    
    const filteredStandards = [];
    (domain.standards || []).forEach(std => {
      const filteredCriteria = (std.criteria || []).filter(crit => {
        totalCritCount++;
        const val = APP_STATE.currentAssessmentScores[crit.id] || 0;
        dScore += val;
        if (val > 0) scoredCritCount++;
        
        if (statusFilter === 'unscored' && val > 0) return false;
        if (statusFilter === 'scored' && val === 0) return false;
        
        if (searchQuery) {
          const matchTitle = (crit.title || '').toLowerCase().includes(searchQuery);
          const matchDesc = (crit.desc || '').toLowerCase().includes(searchQuery);
          const matchStd = (crit.standard || '').toLowerCase().includes(searchQuery);
          const matchOpts = (crit.options || []).some(o => (o.text || '').toLowerCase().includes(searchQuery));
          const matchNum = `tc ${crit.num}`.toLowerCase().includes(searchQuery) || `${crit.num}` === searchQuery;
          return matchTitle || matchDesc || matchStd || matchOpts || matchNum;
        }
        return true;
      });

      if (filteredCriteria.length > 0) {
        visibleCriteriaTotal += filteredCriteria.length;
        filteredStandards.push({
          ...std,
          criteria: filteredCriteria
        });
      }
    });

    if (filteredStandards.length === 0 && (searchQuery || statusFilter !== 'all')) {
      return;
    }

    const isSingleChoiceStd = (domain.standards || []).some(s => SINGLE_CHOICE_STANDARDS.includes(s.id));
    const dRecordedScore = sub.domainScores ? (sub.domainScores[domain.id] || 0) : dScore;
    
    html += `
      <div class="bg-white rounded-2xl shadow-xs border border-slate-200 overflow-hidden mb-4 transition-all">
        <div class="bg-gradient-to-r from-slate-50 to-blue-50/50 px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-3 cursor-pointer hover:bg-blue-50/80 transition-all" onclick="toggleDomainAccordion('${domain.id}')">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-xl bg-blue-700 text-white font-black text-xs flex items-center justify-center shadow-xs">
              ${domain.code || (dIdx + 1)}
            </span>
            <div>
              <h4 class="text-xs sm:text-sm font-black text-slate-800">${domain.name}</h4>
              <p class="text-[11px] text-slate-500">
                �� ho�n th�nh: <strong class="text-blue-700 font-bold">${scoredCritCount}/${totalCritCount}</strong> ti�u ch�
                ${scoredCritCount === totalCritCount && totalCritCount > 0 ? ' <span class="text-emerald-600 font-bold">? �? 100%</span>' : ''}
              </p>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="text-right">
              <span id="domain-score-badge-${domain.id}" class="text-xs sm:text-sm font-black text-blue-700 bg-white px-2.5 py-1 rounded-lg border border-blue-200 shadow-2xs">
                ${dRecordedScore} <span class="text-[10px] font-bold text-slate-400">/ ${domain.maxPoints || 200}d</span>
              </span>
            </div>
            <span id="domain-icon-${domain.id}" class="text-slate-400 text-xs transition-transform transform">?</span>
          </div>
        </div>
        
        <div id="domain-body-${domain.id}" class="p-3 sm:p-5 space-y-4">
          ${filteredStandards.map(std => renderStandardBlock(std, isLocked, viewMode)).join('')}
        </div>
      </div>
    `;
  });

  if (visibleCriteriaTotal === 0 && (searchQuery || statusFilter !== 'all')) {
    html = `
      <div class="bg-white rounded-2xl p-10 text-center border border-slate-200 shadow-xs max-w-lg mx-auto my-6">
        <div class="w-16 h-16 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-2xl mx-auto mb-3">??</div>
        <h4 class="text-base font-bold text-slate-800 mb-1">Kh�ng t�m th?y ti�u ch� ph� h?p</h4>
        <p class="text-xs text-slate-500 mb-4">Kh�ng c� ti�u ch� n�o kh?p v?i t? kh�a "<strong>${searchQuery}</strong>" ho?c b? l?c hi?n t?i.</p>
        <button type="button" onclick="clearAssessmentSearch(); setAssessmentStatusFilter('all');" class="px-4 py-2 bg-blue-700 text-white font-bold rounded-xl text-xs shadow-xs hover:bg-blue-800 transition-all">
          ?? X�a b? l?c v� xem t?t c?
        </button>
      </div>
    `;
  }

  container.innerHTML = html;
}

function renderStandardBlock(std, isLocked, viewMode) {
  const isSingle = SINGLE_CHOICE_STANDARDS.includes(std.id);
  const stdMax = CLINICAL_STANDARD_MAX_SCORES[std.id] || (std.criteria || []).reduce((sum, c) => sum + (c.maxScore || 0), 0);

  return `
    <div class="space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 border-b-2 border-blue-600/30 pb-1.5 mt-2">
        <div class="flex items-center gap-2 text-xs font-black text-slate-800 uppercase tracking-wide">
          <span class="text-blue-700 text-sm">??</span>
          <span>${std.title.replace(/\n/g, ' ')}</span>
        </div>
        ${isSingle ? `
          <span class="px-2 py-0.5 rounded-md bg-amber-100 text-amber-900 border border-amber-300 font-bold text-[10px]">
            ?? Ch? ch?n 1 nang l?c ph� h?p nh?t (T?i da ${stdMax}d)
          </span>
        ` : `
          <span class="text-[11px] font-bold text-slate-400">
            T?i da: ${stdMax}d
          </span>
        `}
      </div>
      <div class="space-y-3">
        ${(std.criteria || []).map(crit => renderCriterionCard(crit, isLocked, viewMode)).join('')}
      </div>
    </div>
  `;
}

// Render Th? Ti�u Ch� Chi Ti?t
function renderCriterionCard(crit, isLocked, viewMode = (APP_STATE.assessmentViewMode || 'cards')) {
  const selectedScore = APP_STATE.currentAssessmentScores[crit.id];
  const isScored = selectedScore !== undefined && selectedScore !== null && selectedScore > 0;
  const savedOptIdx = (APP_STATE.currentAssessmentOptionKeys && APP_STATE.currentAssessmentOptionKeys[crit.id] !== undefined)
    ? APP_STATE.currentAssessmentOptionKeys[crit.id]
    : undefined;
  const selectedOpt = (crit.options || []).find((o, idx) => (savedOptIdx !== undefined ? idx === savedOptIdx : o.score === selectedScore));
  const evidences = APP_STATE.currentCriterionEvidences[crit.id] || [];
  const evidenceHint = getEvidenceHint(crit.id);
  const stdText = crit.standard || '';

  return `
    <div id="criterion-card-${crit.id}" class="bg-white rounded-2xl border transition-all duration-200 p-3.5 sm:p-4 mb-3 ${
      isScored ? 'border-blue-300/80 shadow-xs ring-1 ring-blue-500/10' : 'border-slate-200 shadow-2xs'
    }">
      
      <!-- Top header bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2.5 mb-2.5 border-b border-slate-100">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-2.5 py-1 rounded-xl bg-blue-700 text-white font-black text-xs shadow-2xs tracking-wide">
            TC ${crit.num || crit.id.replace('lamsang_c', '')}
          </span>
          <span class="text-[11px] font-bold text-blue-700/80 uppercase tracking-wide">
            ${stdText.replace(/\n/g, ' ')}
          </span>
        </div>
        
        <div class="flex items-center gap-2 self-start sm:self-center">
          ${isScored ? `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-blue-700 text-white font-black text-xs shadow-2xs">
              <span>?</span> �?t: <strong>${selectedScore}</strong> / ${crit.maxScore}d
              <span class="text-[10px] font-bold text-blue-100">(${selectedOpt ? selectedOpt.level : ''})</span>
            </span>
            ${!isLocked ? `
              <button type="button" 
                onclick="onDeselectCriterion('${crit.id}')" 
                title="B? ch?n ti�u ch� n�y (v? 0 di?m)" 
                class="px-2.5 py-1 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 hover:text-rose-900 border border-rose-200 text-xs font-bold flex items-center gap-1 transition-all cursor-pointer shadow-2xs">
                <span>?</span> B? ch?n
              </button>
            ` : ''}
          ` : `
            <span class="px-2.5 py-1 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 font-bold text-xs">
              Chua ch?m � T?i da ${crit.maxScore}d
            </span>
          `}
        </div>
      </div>

      <!-- T�n Ti�u Ch� & Hu?ng D?n -->
      <div class="mb-3">
        <h5 class="text-xs sm:text-sm font-bold text-slate-900 leading-snug">
          ${crit.title}
        </h5>
        ${crit.desc ? `
          <p class="text-[11px] text-slate-500 mt-1 flex items-center gap-1 font-medium italic">
            ?? ${crit.desc}
          </p>
        ` : ''}
        ${crit.note ? `
          <div class="mt-2 p-2.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 leading-relaxed font-medium">
            <span class="font-bold flex items-center gap-1 text-amber-800 mb-0.5">
              ?? Hu?ng d?n:
            </span>
            <span>${crit.note}</span>
          </div>
        ` : ''}
      </div>

      <!-- C�c M?c �? / C�u tr? l?i (H�ng ngang, vi?t h?t h�ng m?i xu?ng h�ng) -->
      ${viewMode === 'cards' ? `
        <div class="space-y-2 my-2.5">
          ${(crit.options || []).map((opt, optIdx) => {
            const isOptSelected = (savedOptIdx !== undefined) 
              ? (savedOptIdx === optIdx) 
              : (selectedScore === opt.score);
            return `
              <button type="button" 
                onclick="onSelectCriterionScore('${crit.id}', ${opt.score}, ${optIdx})" 
                title="${isOptSelected ? 'Nh?p d? B? CH?N m?c n�y (v? 0d)' : 'Nh?p d? CH?N ' + opt.level + ' (' + opt.score + ' di?m)'}"
                class="clinical-level-btn clinical-horizontal-option ${isOptSelected ? 'is-selected' : ''} ${isLocked ? 'pointer-events-none opacity-80' : ''}">
                
                <div class="flex items-start gap-3 flex-1 min-w-0">
                  <div class="level-check-circle shrink-0 mt-0.5 ${isOptSelected ? 'is-checked' : ''}">
                    ${isOptSelected ? `
                      <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                      </svg>
                    ` : `
                      <div class="w-2 h-2 rounded-full bg-slate-300 group-hover:bg-blue-400 transition-colors"></div>
                    `}
                  </div>

                  <div class="flex items-center gap-1.5 shrink-0 pt-0.5">
                    <span class="px-2.5 py-0.8 rounded-lg font-black text-xs ${
                      isOptSelected ? 'bg-blue-700 text-white shadow-2xs' : 'bg-slate-100 text-slate-800 border border-slate-200'
                    }">
                      ${opt.level}
                    </span>
                    <span class="px-2 py-0.8 rounded-lg font-black text-xs ${
                      isOptSelected ? 'bg-blue-100 text-blue-900 border border-blue-300' : 'bg-blue-50 text-blue-800 border border-blue-200'
                    }">
                      +${opt.score}d
                    </span>
                  </div>

                  <div class="flex-1 text-xs leading-relaxed ${isOptSelected ? 'text-blue-950 font-bold' : 'text-slate-700 font-normal'}">
                    ${opt.text}
                  </div>
                </div>

                <div class="shrink-0 flex items-center gap-2 sm:self-center pl-7 sm:pl-0">
                  ${isOptSelected ? `
                    <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 border border-emerald-300 font-extrabold text-xs flex items-center gap-1 shadow-2xs">
                      <span>?</span> �ang ch?n
                    </span>
                    ${!isLocked ? `
                      <span onclick="event.stopPropagation(); onDeselectCriterion('${crit.id}')" 
                        title="Nh?p d? b? ch?n m?c n�y (v? 0d)" 
                        class="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-extrabold text-xs flex items-center gap-1 cursor-pointer transition-colors shadow-2xs">
                        <span>?</span> B? ch?n
                      </span>
                    ` : ''}
                  ` : `
                    <span class="text-xs text-slate-400 group-hover:text-blue-600 font-semibold transition-colors flex items-center gap-1">
                      <span>?</span> Ch?n
                    </span>
                  `}
                </div>

              </button>
            `;
          }).join('')}
        </div>
      ` : `
        <div class="flex items-center gap-2 flex-wrap my-2">
          ${!isLocked ? `
            <button type="button" 
              onclick="onDeselectCriterion('${crit.id}')" 
              title="B? ch?n ti�u ch� n�y (d?t v? 0 di?m)"
              class="px-3 py-1.5 rounded-xl border text-xs font-bold transition-all flex items-center gap-1 ${
                selectedScore === 0 
                  ? 'bg-slate-700 text-white border-slate-700 shadow-2xs' 
                  : 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100'
              }">
              <span>?</span> B? ch?n (0d)
            </button>
          ` : ''}
          ${(crit.options || []).map((opt, optIdx) => {
            const isOptSelected = (savedOptIdx !== undefined) 
              ? (savedOptIdx === optIdx) 
              : (selectedScore === opt.score);
            return `
            <button type="button" 
              onclick="onSelectCriterionScore('${crit.id}', ${opt.score}, ${optIdx})" 
              title="${isOptSelected ? 'Nh?p d? b? ch?n m?c n�y' : opt.text}"
              class="px-3.5 py-1.5 rounded-xl border text-xs font-bold transition-all flex items-center gap-1.5 ${
                isOptSelected 
                  ? 'bg-blue-700 text-white border-blue-700 shadow-xs ring-2 ring-blue-300' 
                  : 'bg-white text-slate-700 border-slate-200 hover:bg-blue-50 hover:border-blue-300'
              }">
              <span class="level-check-circle ${isOptSelected ? 'is-checked' : ''}" style="width: 1rem; height: 1rem; margin-top: 0;">
                ${isOptSelected ? `?` : ``}
              </span>
              <span>${opt.level}: <strong>${opt.score}d</strong></span>
            </button>
            `;
          }).join('')}
        </div>
      `}

      <!-- Footer: G?i � v� Minh ch?ng -->
      <div class="mt-3 pt-2.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <div class="flex items-center gap-3">
          ${!isLocked ? `
            <button type="button" 
              onclick="onDeselectCriterion('${crit.id}')" 
              class="text-[11px] font-semibold text-slate-400 hover:text-rose-600 flex items-center gap-1 transition-colors">
              <span>?</span> B? ch?n / Chua d?t (0d)
            </button>
          ` : ''}
          ${evidenceHint ? `
            <span class="hidden md:inline-flex items-center gap-1 text-[11px] text-slate-400">
              <span>??</span> <em>G?i �: ${evidenceHint}</em>
            </span>
          ` : ''}
        </div>

        <div class="flex items-center gap-2 flex-wrap self-end sm:self-center">
          ${evidences.length > 0 ? `
            <div class="flex items-center gap-1.5 flex-wrap">
              ${evidences.map((ev, eIdx) => `
                <span class="inline-flex items-center gap-1 px-2 py-0.8 rounded-lg bg-emerald-50 text-emerald-900 border border-emerald-200 text-[11px] font-semibold shadow-2xs">
                  <span>??</span>
                  <span class="max-w-[120px] truncate" title="${ev.name}">${ev.name}</span>
                  <button type="button" onclick="previewCriterionEvidence('${crit.id}', ${eIdx})" class="text-blue-600 hover:text-blue-800 font-bold ml-0.5" title="Xem">???</button>
                  ${!isLocked ? `
                    <button type="button" onclick="removeCriterionEvidence('${crit.id}', ${eIdx})" class="text-rose-500 hover:text-rose-700 font-bold ml-0.5" title="G?">?</button>
                  ` : ''}
                </span>
              `).join('')}
            </div>
          ` : ''}

          ${!isLocked ? `
            <label class="inline-flex items-center gap-1.5 px-3 py-1.2 rounded-xl bg-slate-100 hover:bg-blue-50 hover:text-blue-700 text-slate-700 cursor-pointer font-bold text-xs transition-all border border-slate-200/80 shadow-2xs">
              <span>??</span>
              <span>��nh k�m minh ch?ng</span>
              <input type="file" class="hidden" onchange="handleCriterionFileUpload(event, '${crit.id}')" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" multiple>
            </label>
          ` : ''}
        </div>
      </div>

    </div>
  `;
}

// X? l� khi ch?n di?m cho m?t ti�u ch� (H? tr? Click ch?n & Click l?i d? B? CH?N)
function onSelectCriterionScore(critId, score, optIdx) {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  const specialty = APP_STATE.selectedSpecialty || user.specialty || 'lamsang';
  const allDomains = DOMAINS_BY_SPECIALTY[specialty] || [];

  const currentScore = APP_STATE.currentAssessmentScores[critId];
  const currentOptIdx = APP_STATE.currentAssessmentOptionKeys ? APP_STATE.currentAssessmentOptionKeys[critId] : undefined;

  // TOGGLE B? CH?N: N?u nh?p l?i ch�nh m?c dang du?c ch?n -> B? ch?n (v? 0d)
  const isAlreadySelected = (currentOptIdx !== undefined && currentOptIdx === optIdx) ||
                            (currentOptIdx === undefined && currentScore === score && score > 0);

  if (isAlreadySelected) {
    onDeselectCriterion(critId);
    return;
  }

  // T�m ti�u chu?n ch?a ti�u ch� n�y
  let parentStandard = null;
  for (const d of allDomains) {
    for (const s of (d.standards || [])) {
      if ((s.criteria || []).some(c => c.id === critId)) {
        parentStandard = s;
        break;
      }
    }
    if (parentStandard) break;
  }

  // QUY T?C B?NH VI?N: N?u thu?c Ti�u chu?n "Ch?n 1 nang l?c ph� h?p nh?t"
  if (parentStandard && SINGLE_CHOICE_STANDARDS.includes(parentStandard.id) && score > 0) {
    // �?t l?i di?m c?a c�c ti�u ch� kh�c trong c�ng ti�u chu?n v? 0
    (parentStandard.criteria || []).forEach(otherCrit => {
      if (otherCrit.id !== critId) {
        APP_STATE.currentAssessmentScores[otherCrit.id] = 0;
        if (APP_STATE.currentAssessmentOptionKeys) {
          delete APP_STATE.currentAssessmentOptionKeys[otherCrit.id];
        }
      }
    });
  }

  // Ghi nh?n di?m cho ti�u ch� du?c ch?n
  APP_STATE.currentAssessmentScores[critId] = score;
  if (!APP_STATE.currentAssessmentOptionKeys) APP_STATE.currentAssessmentOptionKeys = {};
  if (optIdx !== undefined) {
    APP_STATE.currentAssessmentOptionKeys[critId] = optIdx;
  } else {
    delete APP_STATE.currentAssessmentOptionKeys[critId];
  }

  sub.scores = APP_STATE.currentAssessmentScores;
  sub.optionKeys = APP_STATE.currentAssessmentOptionKeys;
  calculateAndUpdateAssessmentSummary(sub);
  saveStorage();

  // C?p nh?t giao di?n tr?c ti?p
  renderAssessmentTab();
}

// H�m B? ch?n ti�u ch� chuy�n d?ng (d?t v? 0 di?m)
function onDeselectCriterion(critId) {
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);

  APP_STATE.currentAssessmentScores[critId] = 0;
  if (APP_STATE.currentAssessmentOptionKeys) {
    delete APP_STATE.currentAssessmentOptionKeys[critId];
  }

  sub.scores = APP_STATE.currentAssessmentScores;
  sub.optionKeys = APP_STATE.currentAssessmentOptionKeys;
  calculateAndUpdateAssessmentSummary(sub);
  saveStorage();

  renderAssessmentTab();
  showToast('�� b? ch?n ti�u ch� (d?t v? 0 di?m)', 'info');
}

// Thi?t l?p di?m c?a Qu?n l� tr?c ti?p (�D Tru?ng)
function setAssessmentManagerScore(critId, val) {
  const score = parseInt(val, 10) || 0;
  if (!APP_STATE.managerAssessmentScores) APP_STATE.managerAssessmentScores = {};
  APP_STATE.managerAssessmentScores[critId] = score;
  
  const user = APP_STATE.currentUser;
  if (!user) return;
  const sub = getUserSubmission(user.id);
  sub.managerScores = APP_STATE.managerAssessmentScores;
  saveStorage();
  calculateAndUpdateAssessmentSummary(sub);
}

